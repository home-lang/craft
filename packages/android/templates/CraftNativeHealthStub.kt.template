package {{PACKAGE_NAME}}

import android.app.Activity
import android.content.Context
import android.content.Intent
import org.json.JSONArray

/**
 * Health Connect left out of this app (`enableHealthConnect` is off), so
 * the native renderer compiles without its library. Every call answers
 * `CAPABILITY_DISABLED`; the `health` capability is not advertised either.
 */
internal class CraftNativeHealth(
    @Suppress("UNUSED_PARAMETER") context: Context,
    @Suppress("UNUSED_PARAMETER") activityProvider: () -> Activity?,
    @Suppress("UNUSED_PARAMETER") backgroundReads: Boolean,
    @Suppress("UNUSED_PARAMETER") historyReads: Boolean,
    @Suppress("UNUSED_PARAMETER") workoutSink: ((org.json.JSONObject) -> Unit)? = null,
) {
    fun perform(method: String, args: JSONArray, completion: (CraftNativeCapabilityResult) -> Unit) {
        completion(CraftNativeCapabilityResult(code = "CAPABILITY_DISABLED", message = "Health Connect is not enabled for this app ($method, ${args.length()} arguments)"))
    }

    fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?): Boolean = false

    fun close() {}

    companion object {
        const val PERMISSION_REQUEST_CODE = 8411
        fun readPermissions(type: String): Set<String> = emptySet()
        fun writePermissions(type: String): Set<String> = emptySet()
    }
}
