private const val CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS = 30_000L

private fun craftNativeOptionalString(value: Any?): String? = value
    ?.takeUnless { it == JSONObject.NULL }
    ?.toString()
    ?.takeUnless { it == "null" || it == "undefined" }
    ?.takeIf { it.isNotBlank() }

private fun craftNativeEventName(events: JSONObject, vararg names: String): String =
    names.firstNotNullOfOrNull { name -> craftNativeOptionalString(events.opt(name)) }.orEmpty()

internal fun craftNativePadding(style: JSONObject?, name: String, fallback: Int, density: Float): Int {
    val value = style?.optDouble(name, Double.NaN) ?: Double.NaN
    val pixels = value * density
    return if (value.isFinite() && value >= 0 && pixels.isFinite()) pixels.toInt() else fallback
}

internal fun craftNativeFiniteFloat(style: JSONObject?, name: String, fallback: Float): Float {
    val value = style?.optDouble(name, Double.NaN) ?: Double.NaN
    val narrowed = value.toFloat()
    return if (value.isFinite() && narrowed.isFinite()) narrowed else fallback
}

internal fun craftNativeFiniteDouble(style: JSONObject?, name: String, fallback: Double): Double {
    val value = style?.optDouble(name, Double.NaN) ?: Double.NaN
    return value.takeIf { it.isFinite() } ?: fallback
}

internal fun craftNativeNonNegativeDouble(style: JSONObject?, name: String, fallback: Double): Double {
    val value = craftNativeFiniteDouble(style, name, Double.NaN)
    return if (value.isFinite() && value >= 0) value else fallback
}

private data class CraftNativeLength(
    val points: Int? = null,
    val fraction: Double? = null,
) {
    fun resolve(base: Int?): Int? = points?.coerceAtLeast(0) ?: fraction?.let { value -> base?.let { max(0, (it * value).roundToInt()) } }

    companion object {
        fun from(value: Any?, density: Float): CraftNativeLength? {
            if (value == null || value == JSONObject.NULL) return null
            if (value is Number) {
                val points = value.toDouble() * density
                return points.takeIf { it.isFinite() }?.let { CraftNativeLength(points = it.roundToInt()) }
            }
            val text = value.toString().trim()
            if (text.endsWith('%')) return text.dropLast(1).toDoubleOrNull()?.takeIf { it.isFinite() }?.let { CraftNativeLength(fraction = it / 100) }
            if (text.endsWith("px")) return text.dropLast(2).toDoubleOrNull()?.takeIf { it.isFinite() }?.let { CraftNativeLength(points = (it * density).roundToInt()) }
            return text.toDoubleOrNull()?.takeIf { it.isFinite() }?.let { CraftNativeLength(points = (it * density).roundToInt()) }
        }
    }
}

private data class CraftNativeLayoutStyle(
    val width: CraftNativeLength? = null,
    val height: CraftNativeLength? = null,
    val aspectRatio: Double? = null,
    val minWidth: CraftNativeLength? = null,
    val maxWidth: CraftNativeLength? = null,
    val minHeight: CraftNativeLength? = null,
    val maxHeight: CraftNativeLength? = null,
    val position: String = "relative",
    val top: Int? = null,
    val right: Int? = null,
    val bottom: Int? = null,
    val left: Int? = null,
    val alignSelf: String? = null,
    val flexGrow: Double = 0.0,
    val flexShrink: Double? = null,
    val flexBasis: CraftNativeLength? = null,
) {
    companion object {
        fun from(raw: JSONObject, density: Float): CraftNativeLayoutStyle {
            fun length(name: String): CraftNativeLength? = CraftNativeLength.from(raw.opt(name), density)
            fun number(name: String): Int? {
                if (!raw.has(name) || raw.isNull(name)) return null
                return raw.optDouble(name, Double.NaN).takeIf { it.isFinite() }?.let { points ->
                    (points * density).takeIf { it.isFinite() }?.roundToInt()
                }
            }
            fun decimal(name: String): Double? {
                if (!raw.has(name) || raw.isNull(name)) return null
                return raw.optDouble(name, Double.NaN).takeIf { it.isFinite() }
            }
            val flex = decimal("flex")
            return CraftNativeLayoutStyle(
                width = length("width"), height = length("height"),
                aspectRatio = decimal("aspectRatio")?.takeIf { it.isFinite() && it > 0.0 },
                minWidth = length("minWidth"), maxWidth = length("maxWidth"),
                minHeight = length("minHeight"), maxHeight = length("maxHeight"),
                position = raw.opt("position")
                    ?.takeUnless { it == JSONObject.NULL }
                    ?.toString()
                    ?.takeIf { it.isNotBlank() }
                    ?: "relative",
                top = number("top"), right = number("right"), bottom = number("bottom"), left = number("left"),
                alignSelf = raw.opt("alignSelf")
                    ?.takeUnless { it == JSONObject.NULL }
                    ?.toString()
                    ?.takeIf { it.isNotBlank() && it != "auto" },
                flexGrow = decimal("flexGrow") ?: flex?.coerceAtLeast(0.0) ?: 0.0,
                flexShrink = decimal("flexShrink") ?: flex?.let { if (it != 0.0) 1.0 else 0.0 },
                flexBasis = length("flexBasis")
                    ?: flex?.takeIf { it > 0.0 }?.let { CraftNativeLength(points = 0) },
            )
        }
    }
}

private fun craftNativeGridColumnCount(value: Any?): Int {
    if (value is Number) return max(1, value.toInt())
    val text = value as? String ?: return 1
    val trimmed = text.trim()
    if (trimmed.startsWith("repeat(")) {
        val count = trimmed.removePrefix("repeat(").takeWhile { it.isDigit() }.toIntOrNull()
        if (count != null) return max(1, count)
    }
    return max(1, trimmed.split(Regex("\\s+")).count { it.isNotBlank() })
}

/**
 * A CSS colour as Android's ARGB. STX writes `#RRGGBBAA` (and `#RGBA`) for a
 * colour with alpha, where Android's parser reads `#AARRGGBB`: a translucent
 * grey fill (`#7676801f`) came out olive. Also `rgb()`/`rgba()` and
 * `transparent`; anything else goes to Android's parser (named colours).
 */
internal fun craftNativeColor(raw: String): Int {
    val value = raw.trim()
    if (value.equals("transparent", ignoreCase = true)) return Color.TRANSPARENT
    if (value.startsWith("#")) {
        val hex = value.substring(1)
        fun channel(text: String) = text.toInt(16)
        return when (hex.length) {
            3 -> Color.rgb(channel("${hex[0]}${hex[0]}"), channel("${hex[1]}${hex[1]}"), channel("${hex[2]}${hex[2]}"))
            4 -> Color.argb(channel("${hex[3]}${hex[3]}"), channel("${hex[0]}${hex[0]}"), channel("${hex[1]}${hex[1]}"), channel("${hex[2]}${hex[2]}"))
            6 -> Color.rgb(channel(hex.substring(0, 2)), channel(hex.substring(2, 4)), channel(hex.substring(4, 6)))
            8 -> Color.argb(channel(hex.substring(6, 8)), channel(hex.substring(0, 2)), channel(hex.substring(2, 4)), channel(hex.substring(4, 6)))
            else -> throw IllegalArgumentException("Unknown color $raw")
        }
    }
    val functional = Regex("""^rgba?\(\s*([\d.]+)[\s,]+([\d.]+)[\s,]+([\d.]+)(?:[\s,/]+([\d.]+%?))?\s*\)$""", RegexOption.IGNORE_CASE).find(value)
    if (functional != null) {
        val (r, g, b, a) = functional.destructured
        val alpha = when {
            a.isBlank() -> 1.0
            a.endsWith("%") -> a.dropLast(1).toDouble() / 100.0
            else -> a.toDouble()
        }
        return Color.argb((alpha.coerceIn(0.0, 1.0) * 255).roundToInt(), r.toDouble().roundToInt(), g.toDouble().roundToInt(), b.toDouble().roundToInt())
    }
    return Color.parseColor(value)
}

/** Android View has no skew setters before API 29; draw the shared skew around the view's center. */
private object CraftNativeSkewTransforms {
    private val values = WeakHashMap<View, Pair<Float, Float>>()

    fun set(view: View, x: Float, y: Float) {
        if (x == 0f && y == 0f) values.remove(view) else values[view] = x to y
        view.invalidate()
    }

    fun clear(view: View) {
        values.remove(view)
        view.invalidate()
    }

    fun matrix(view: View): Matrix? {
        val (x, y) = values[view] ?: return null
        val pivotX = view.width / 2f
        val pivotY = view.height / 2f
        return Matrix().apply {
            setTranslate(-pivotX, -pivotY)
            postSkew(x, y)
            postTranslate(pivotX, pivotY)
        }
    }
}

/** A DOM-free SVG surface for the geometry emitted by the shared STX native protocol. */
private class CraftNativeSvgView(context: Context) : View(context) {
    var drawing: JSONObject = JSONObject()
        set(value) {
            field = value
            invalidate()
            requestLayout()
        }

    private data class SvgPaint(
        val fill: String? = "#000000",
        val stroke: String? = null,
        val strokeWidth: Float = 1f,
        val color: String = "#000000",
        val opacity: Float = 1f,
        val typeface: Typeface = Typeface.DEFAULT,
    ) {
        fun merge(node: JSONObject): SvgPaint {
            val props = node.optJSONObject("props") ?: JSONObject()
            val style = node.optJSONObject("style") ?: JSONObject()
            fun value(name: String): String? = when {
                style.has(name) && !style.isNull(name) -> style.optString(name)
                props.has(name) && !props.isNull(name) -> props.optString(name)
                else -> null
            }
            // Keep the cascade explicit: computed style wins over a raw prop
            // when both provide the same SVG paint value.
            val weight = value("fontWeight")
            val ownOpacity = value("opacity")?.toFloatOrNull()?.takeIf { it.isFinite() } ?: 1f
            return copy(
                fill = value("fill") ?: fill,
                stroke = value("stroke") ?: stroke,
                strokeWidth = value("strokeWidth")?.toFloatOrNull()?.takeIf { it.isFinite() } ?: strokeWidth,
                color = value("color") ?: color,
                opacity = ownOpacity * opacity,
                typeface = if (weight in setOf("bold", "700")) Typeface.DEFAULT_BOLD else typeface,
            )
        }
    }

    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val width = MeasureSpec.getSize(widthMeasureSpec)
        val box = viewBox()
        val naturalHeight = if (box != null && box.second > 0) (width * box.second / box.first).roundToInt() else 0
        val height = when (MeasureSpec.getMode(heightMeasureSpec)) {
            MeasureSpec.EXACTLY -> MeasureSpec.getSize(heightMeasureSpec)
            MeasureSpec.AT_MOST -> min(naturalHeight, MeasureSpec.getSize(heightMeasureSpec))
            else -> naturalHeight
        }
        setMeasuredDimension(resolveSize(width, widthMeasureSpec), resolveSize(height, heightMeasureSpec))
    }

    /** viewBox units to the view's pixels, set by each draw. */
    private val viewTransform = Matrix()
    private val inverseTransform = Matrix()

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        val box = viewBox() ?: return
        if (box.first <= 0 || box.second <= 0) return
        // Centred at one scale (SVG's default, `xMidYMid meet`), or each axis
        // stretched to fill (`preserveAspectRatio="none"`).
        val stretch = drawing.optJSONObject("props")?.optString("preserveAspectRatio")?.trim() == "none"
        var sx = width.toFloat() / box.first
        var sy = height.toFloat() / box.second
        var dx = 0f
        var dy = 0f
        if (!stretch) {
            val scale = min(sx, sy)
            sx = scale
            sy = scale
            dx = (width - box.first * scale) / 2f
            dy = (height - box.second * scale) / 2f
        }
        if (!sx.isFinite() || !sy.isFinite() || sx <= 0f || sy <= 0f) return
        viewTransform.reset()
        viewTransform.postTranslate(-box.third, -box.fourth)
        viewTransform.postScale(sx, sy)
        viewTransform.postTranslate(dx, dy)
        viewTransform.invert(inverseTransform)
        canvas.save()
        canvas.concat(viewTransform)
        drawNodes(canvas, drawing.optJSONArray("children") ?: JSONArray(), SvgPaint().merge(drawing))
        canvas.restore()
    }

    private fun viewBox(): Quadruple<Float, Float, Float, Float>? {
        val values = drawing.optJSONObject("props")?.optJSONArray("viewBox") ?: return null
        if (values.length() != 4) return null
        val x = values.optDouble(0, Double.NaN).toFloat()
        val y = values.optDouble(1, Double.NaN).toFloat()
        val width = values.optDouble(2, Double.NaN).toFloat()
        val height = values.optDouble(3, Double.NaN).toFloat()
        if (!x.isFinite() || !y.isFinite() || !width.isFinite() || !height.isFinite() || width <= 0f || height <= 0f) return null
        return Quadruple(width, height, x, y)
    }

    private fun drawNodes(canvas: Canvas, children: JSONArray, inherited: SvgPaint) {
        for (index in 0 until children.length()) {
            val node = children.optJSONObject(index) ?: continue
            val style = node.optJSONObject("style") ?: JSONObject()
            if (style.optString("display") == "none") continue
            val paint = inherited.merge(node)
            when (node.optString("type")) {
                "G" -> drawNodes(canvas, node.optJSONArray("children") ?: JSONArray(), paint)
                "SvgText" -> drawText(canvas, node, paint)
                else -> drawPath(canvas, node, paint)
            }
        }
    }

    private fun drawPath(canvas: Canvas, node: JSONObject, style: SvgPaint) {
        val props = node.optJSONObject("props") ?: JSONObject()
        val geometry = props.optJSONArray("geometry") ?: return
        if ((0 until geometry.length()).any { !geometry.optDouble(it, Double.NaN).toFloat().isFinite() }) return
        val path = Path()
        var index = 0
        while (index < geometry.length()) {
            val command = geometry.optDouble(index, Double.NaN).toInt()
            fun number(offset: Int): Float = geometry.optDouble(index + offset, Double.NaN).toFloat()
            when (command) {
                0 -> if (index + 2 < geometry.length()) { path.moveTo(number(1), number(2)); index += 3 } else break
                1 -> if (index + 2 < geometry.length()) { path.lineTo(number(1), number(2)); index += 3 } else break
                2 -> if (index + 6 < geometry.length()) { path.cubicTo(number(1), number(2), number(3), number(4), number(5), number(6)); index += 7 } else break
                3 -> if (index + 4 < geometry.length()) { path.quadTo(number(1), number(2), number(3), number(4)); index += 5 } else break
                4 -> { path.close(); index += 1 }
                else -> break
            }
        }
        val fill = android.graphics.Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = resolveColor(style.fill, style.color, Color.TRANSPARENT)
            alpha = (style.opacity * 255f).roundToInt().coerceIn(0, 255)
            this.style = Paint.Style.FILL
        }
        if (style.fill != "none" && style.fill != "transparent") canvas.drawPath(path, fill)
        if (!style.stroke.isNullOrBlank() && style.stroke != "none" && style.stroke != "transparent" && style.strokeWidth > 0) {
            val stroke = android.graphics.Paint(Paint.ANTI_ALIAS_FLAG).apply {
                color = resolveColor(style.stroke, style.color, Color.TRANSPARENT)
                alpha = (style.opacity * 255f).roundToInt().coerceIn(0, 255)
                this.style = Paint.Style.STROKE
                strokeWidth = style.strokeWidth
                strokeCap = when (props.optString("strokeLinecap")) {
                    "round" -> Paint.Cap.ROUND
                    "square" -> Paint.Cap.SQUARE
                    else -> Paint.Cap.BUTT
                }
                strokeJoin = when (props.optString("strokeLinejoin")) {
                    "round" -> Paint.Join.ROUND
                    "bevel" -> Paint.Join.BEVEL
                    else -> Paint.Join.MITER
                }
                props.optJSONArray("strokeDasharray")?.let { values ->
                    val dashes: List<Float> = (0 until values.length()).mapNotNull {
                        values.optDouble(it, Double.NaN).toFloat().takeIf { value -> value.isFinite() && value >= 0 }
                    }
                    if (dashes.isNotEmpty()) {
                        val dashPattern = dashes.toFloatArray()
                        val pattern: FloatArray = if (dashPattern.size % 2 == 1) {
                            FloatArray(dashPattern.size * 2) { index -> dashPattern[index % dashPattern.size] }
                        } else {
                            dashPattern
                        }
                        pathEffect = DashPathEffect(pattern, 0f)
                    }
                }
            }
            // `vector-effect="non-scaling-stroke"`: the stroke is in the view's
            // pixels, so a stretched chart's line keeps its width.
            if (props.optString("vectorEffect") == "non-scaling-stroke") {
                val line = Path(path).apply { transform(viewTransform) }
                canvas.save()
                canvas.concat(inverseTransform)
                canvas.drawPath(line, stroke)
                canvas.restore()
            } else {
                canvas.drawPath(path, stroke)
            }
        }
    }

    private fun drawText(canvas: Canvas, node: JSONObject, style: SvgPaint) {
        val props = node.optJSONObject("props") ?: JSONObject()
        val nodeStyle = node.optJSONObject("style") ?: JSONObject()
        val text = buildString {
            val children = node.optJSONArray("children") ?: JSONArray()
            for (index in 0 until children.length()) if (children.opt(index) is String) append(children.optString(index))
        }
        if (text.isEmpty()) return
        val size = (if (props.has("fontSize")) props.optDouble("fontSize", 12.0) else nodeStyle.optDouble("fontSize", 12.0))
            .takeIf { it.isFinite() }
            ?.toFloat()
            ?: 12f
        val paint = android.graphics.Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = resolveColor(style.fill, style.color, Color.BLACK)
            alpha = (style.opacity * 255f).roundToInt().coerceIn(0, 255)
            textSize = size
            typeface = style.typeface
        }
        var x = props.optDouble("x", 0.0).takeIf { it.isFinite() }?.toFloat() ?: 0f
        val y = props.optDouble("y", 0.0).takeIf { it.isFinite() }?.toFloat() ?: 0f
        when (props.optString("textAnchor")) {
            "middle" -> x -= paint.measureText(text) / 2f
            "end" -> x -= paint.measureText(text)
        }
        canvas.drawText(text, x, y, paint)
    }

    private fun resolveColor(value: String?, current: String, fallback: Int): Int = runCatching {
        craftNativeColor(if (value == "currentColor") current else value ?: current)
    }.getOrDefault(fallback)

    private data class Quadruple<T1, T2, T3, T4>(val first: T1, val second: T2, val third: T3, val fourth: T4)
}

/** The Android host for the small, host-neutral native trail map contract. */
private class CraftNativeMapView(context: Context) : FrameLayout(context), OnMapReadyCallback {
    private val mapView = MapView(context)
    private var googleMap: GoogleMap? = null
    private var pendingProps = JSONObject()
    private var pendingChildren = JSONArray()
    private val markers = mutableMapOf<String, Marker>()
    private val polylines = mutableMapOf<String, Polyline>()
    private val markerHandlers = mutableMapOf<String, String>()
    private var onMarkerTap: ((String) -> Unit)? = null
    private var lifecycleStarted = false
    private var destroyed = false

    init {
        addView(mapView, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
        mapView.onCreate(null)
        mapView.getMapAsync(this)
    }

    override fun onMapReady(map: GoogleMap) {
        if (destroyed) return
        googleMap = map
        map.setOnMarkerClickListener { marker ->
            val id = markers.entries.firstOrNull { it.value == marker }?.key ?: return@setOnMarkerClickListener false
            onMarkerTap?.invoke(id)
            // The native contract dispatches the marker event itself. Consume
            // the click so Google Maps does not also show an unsolicited info
            // window for the marker title.
            true
        }
        applyPending()
    }

    fun configure(props: JSONObject, children: JSONArray, markerHandler: (String) -> Unit) {
        pendingProps = props
        pendingChildren = children
        onMarkerTap = markerHandler
        applyPending()
    }

    fun markerHandler(id: String): String? = markerHandlers[id]

    private fun applyPending() {
        val map = googleMap ?: return
        map.uiSettings.isScrollGesturesEnabled = pendingProps.optBoolean("scrollEnabled", true)
        map.uiSettings.isZoomGesturesEnabled = pendingProps.optBoolean("zoomEnabled", true)
        map.uiSettings.isRotateGesturesEnabled = pendingProps.optBoolean("rotateEnabled", false)
        map.mapType = when (craftNativeOptionalString(pendingProps.opt("mapType")).orEmpty().lowercase()) {
            "satellite" -> GoogleMap.MAP_TYPE_SATELLITE
            "hybrid" -> GoogleMap.MAP_TYPE_HYBRID
            "terrain" -> GoogleMap.MAP_TYPE_TERRAIN
            else -> GoogleMap.MAP_TYPE_NORMAL
        }
        val showUserLocation = pendingProps.optBoolean("showsUserLocation", false) && hasLocationPermission()
        runCatching { map.isMyLocationEnabled = showUserLocation }
        val nextMarkers = mutableMapOf<String, Pair<LatLng, String?>>()
        val nextHandlers = mutableMapOf<String, String>()
        val nextPolylines = mutableMapOf<String, Triple<List<LatLng>, Int, Float>>()
        for (index in 0 until pendingChildren.length()) {
            val child = pendingChildren.optJSONObject(index) ?: continue
            val type = child.optString("type").lowercase()
            val props = child.optJSONObject("props") ?: JSONObject()
            val events = child.optJSONObject("events") ?: JSONObject()
            val id = craftNativeOptionalString(props.opt("id"))
                ?: craftNativeOptionalString(child.opt("id"))
                ?: "overlay-$index"
            val points = coordinates(props.optJSONArray("geometry"))
            if (type == "mapmarker" || type == "marker") {
                points.firstOrNull()?.let { point ->
                    nextMarkers[id] = point to craftNativeOptionalString(props.opt("title"))
                    listOf(events.opt("onPress"), events.opt("onMarkerPress"))
                        .firstNotNullOfOrNull(::craftNativeOptionalString)
                        ?.let { nextHandlers[id] = it }
                }
            } else if (type == "mappolyline" || type == "polyline") {
                if (points.size > 1) {
                    // Keep malformed authored widths inert, matching the iOS
                    // host. An omitted or null width still gets the shared
                    // default; an attacker-controlled NaN, infinity, zero,
                    // or negative value must not become a valid overlay.
                    val rawWidth = props.opt("strokeWidth")
                    val authoredWidth = when (rawWidth) {
                        null, JSONObject.NULL -> 3.0
                        is Number -> rawWidth.toDouble()
                        else -> 3.0
                    }
                    val width = authoredWidth.toFloat()
                    if (!authoredWidth.isFinite() || !width.isFinite() || width <= 0f) continue
                    nextPolylines[id] = Triple(points, color(craftNativeOptionalString(props.opt("strokeColor")).orEmpty()), width)
                }
            }
        }
        markers.keys.filter { nextMarkers[it] == null }.forEach { markers.remove(it)?.remove() }
        for ((id, value) in nextMarkers) {
            val marker = markers[id]
            if (marker != null) {
                marker.position = value.first
                marker.title = value.second
            } else {
                map.addMarker(MarkerOptions().position(value.first).title(value.second).icon(BitmapDescriptorFactory.defaultMarker()))?.let { markers[id] = it }
            }
        }
        markerHandlers.clear()
        markerHandlers.putAll(nextHandlers)
        polylines.keys.filter { nextPolylines[it] == null }.forEach { id ->
            polylines.remove(id)?.remove()
        }
        for ((id, value) in nextPolylines) {
            val polyline = polylines[id]
            if (polyline != null) {
                polyline.points = value.first
                polyline.color = value.second
                polyline.width = value.third
            } else {
                map.addPolyline(PolylineOptions().addAll(value.first).color(value.second).width(value.third))?.let { polylines[id] = it }
            }
        }
        if (pendingProps.optBoolean("fitToBounds", false)) fitToBounds()
        region(pendingProps.optJSONObject("region") ?: pendingProps.optJSONObject("initialRegion"))?.let { bounds ->
            post {
                if (width > 0 && height > 0) map.moveCamera(CameraUpdateFactory.newLatLngBounds(bounds, 24))
            }
        }
    }

    private fun fitToBounds() {
        val map = googleMap ?: return
        val builder = LatLngBounds.Builder()
        var count = 0
        markers.values.forEach { builder.include(it.position); count++ }
        polylines.values.flatMap { it.points }.forEach { builder.include(it); count++ }
        if (count == 0) return
        post {
            if (width > 0 && height > 0) map.moveCamera(CameraUpdateFactory.newLatLngBounds(builder.build(), 24))
        }
    }

    override fun onAttachedToWindow() {
        super.onAttachedToWindow()
        if (destroyed) return
        mapView.onStart()
        mapView.onResume()
        lifecycleStarted = true
    }

    override fun onDetachedFromWindow() {
        if (lifecycleStarted) {
            mapView.onPause()
            mapView.onStop()
            lifecycleStarted = false
        }
        super.onDetachedFromWindow()
    }

    fun destroy() {
        if (destroyed) return
        destroyed = true
        if (lifecycleStarted) {
            mapView.onPause()
            mapView.onStop()
            lifecycleStarted = false
        }
        onMarkerTap = null
        markerHandlers.clear()
        markers.values.forEach { it.remove() }
        markers.clear()
        polylines.values.forEach { it.remove() }
        polylines.clear()
        mapView.onDestroy()
        googleMap = null
    }

    fun lowMemory() {
        if (!destroyed) mapView.onLowMemory()
    }

    private fun hasLocationPermission(): Boolean =
        ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED ||
            ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED

    private fun coordinates(geometry: JSONArray?): List<LatLng> {
        if (geometry == null) return emptyList()
        return (0 until geometry.length() - 1 step 2).mapNotNull { index ->
            val latitude = geometry.optDouble(index, Double.NaN)
            val longitude = geometry.optDouble(index + 1, Double.NaN)
            if (latitude.isFinite() && longitude.isFinite() &&
                latitude >= -90.0 && latitude <= 90.0 &&
                longitude >= -180.0 && longitude <= 180.0
            ) LatLng(latitude, longitude) else null
        }
    }

    private fun region(value: JSONObject?): LatLngBounds? {
        val center = value?.optJSONObject("center") ?: return null
        val span = value.optJSONObject("span") ?: return null
        val latitude = center.optDouble("latitude", Double.NaN)
        val longitude = center.optDouble("longitude", Double.NaN)
        val latitudeDelta = span.optDouble("latitudeDelta", span.optDouble("latitude_delta", Double.NaN))
        val longitudeDelta = span.optDouble("longitudeDelta", span.optDouble("longitude_delta", Double.NaN))
        if (!latitude.isFinite() || !longitude.isFinite() || !latitudeDelta.isFinite() || !longitudeDelta.isFinite() ||
            latitude < -90.0 || latitude > 90.0 || longitude < -180.0 || longitude > 180.0 ||
            latitudeDelta <= 0.0 || latitudeDelta > 180.0 ||
            longitudeDelta <= 0.0 || longitudeDelta > 360.0 ||
            latitude - latitudeDelta / 2.0 < -90.0 || latitude + latitudeDelta / 2.0 > 90.0
        ) return null
        return LatLngBounds(LatLng(latitude - latitudeDelta / 2, longitude - longitudeDelta / 2), LatLng(latitude + latitudeDelta / 2, longitude + longitudeDelta / 2))
    }

    private fun color(value: String): Int = runCatching { Color.parseColor(value) }.getOrDefault(Color.BLUE)
}

/** A deterministic flex-shaped container shared by normal views and scroll content. */
private class CraftNativeFlexLayout(context: Context) : LinearLayout(context) {
    var onLayoutChanged: (() -> Unit)? = null
    private val styles = mutableMapOf<View, CraftNativeLayoutStyle>()
    private var wrap = false
    private var alignItems = "stretch"
    private var alignContent = "flex-start"
    private var justifyContent = "flex-start"
    private var rowGap = 0f
    private var columnGap = 0f
    private var grid = false
    private var gridColumns = 1
    private var gridAutoRows: CraftNativeLength? = null
    private var reverse = false
    private var wrapReverse = false
    private var authoredPadding = intArrayOf(0, 0, 0, 0)
    private var safeAreaPadding = intArrayOf(0, 0, 0, 0)
    private var applyingPadding = false
    private var safeAreaEdges = setOf("top", "right", "bottom", "left")

    override fun setPadding(left: Int, top: Int, right: Int, bottom: Int) {
        if (!applyingPadding) authoredPadding = intArrayOf(left, top, right, bottom)
        applyingPadding = true
        super.setPadding(
            left + safeAreaPadding[0],
            top + safeAreaPadding[1],
            right + safeAreaPadding[2],
            bottom + safeAreaPadding[3],
        )
        applyingPadding = false
    }

    fun setSafeAreaEdges(raw: JSONArray?) {
        safeAreaEdges = if (raw == null) {
            setOf("top", "right", "bottom", "left")
        } else {
            (0 until raw.length()).mapNotNull { raw.optString(it).takeIf { edge -> edge in setOf("top", "right", "bottom", "left") } }.toSet()
        }
        applySafeAreaPadding()
        invalidateMeasurements()
    }

    fun setWindowSafeInsets(left: Int, top: Int, right: Int, bottom: Int) {
        val insets = intArrayOf(left, top, right, bottom)
        safeAreaPadding = intArrayOf(
            if ("left" in safeAreaEdges) insets[0] else 0,
            if ("top" in safeAreaEdges) insets[1] else 0,
            if ("right" in safeAreaEdges) insets[2] else 0,
            if ("bottom" in safeAreaEdges) insets[3] else 0,
        )
        applySafeAreaPadding()
        invalidateMeasurements()
    }

    private fun applySafeAreaPadding() {
        setPadding(authoredPadding[0], authoredPadding[1], authoredPadding[2], authoredPadding[3])
    }

    /**
     * What a child measures at a pair of specs, remembered for the frame.
     * `entries` asks each child up to three times (max-content, its target
     * width, its height) and again when laying out; every child doing the
     * same to its own made a deep screen (the Calendar) exponential, and the
     * app stopped responding. Views only change between frames, so within
     * one (the animation clock is locked for a frame's traversal) the same
     * question has the same answer.
     */
    /**
     * Whether this container's width is fixed while it measures (an EXACTLY
     * spec, or a laid-out frame): only then does a column stretch its
     * children to it. Measured for its content width (AT_MOST, a chip in a
     * row), it is as wide as its widest child.
     */
    private var widthDefinite = false

    private class MeasureMemo(var clock: Long = Long.MIN_VALUE, val results: HashMap<Long, Long> = HashMap())
    private val memos = WeakHashMap<View, MeasureMemo>()

    private fun probe(child: View, widthSpec: Int, heightSpec: Int): Long {
        val clock = android.view.animation.AnimationUtils.currentAnimationTimeMillis()
        val memo = memos.getOrPut(child) { MeasureMemo() }
        if (memo.clock != clock) {
            memo.clock = clock
            memo.results.clear()
        }
        val key = (widthSpec.toLong() shl 32) or (heightSpec.toLong() and 0xffffffffL)
        memo.results[key]?.let {
            lastProbe[child] = it
            return it
        }
        child.measure(widthSpec, heightSpec)
        val size = (child.measuredWidth.toLong() shl 32) or (child.measuredHeight.toLong() and 0xffffffffL)
        memo.results[key] = size
        lastProbe[child] = size
        return size
    }
    private val lastProbe = WeakHashMap<View, Long>()
    private fun probedWidth(size: Long): Int = (size shr 32).toInt()
    private fun probedHeight(size: Long): Int = size.toInt()

    /**
     * Reactive style and inset mutations can arrive during one frame. The
     * memo is intentionally frame-scoped for performance, but a mutation
     * must invalidate it immediately or the next layout can reuse a child's
     * old intrinsic width/height.
     */
    private fun invalidateMeasurements() {
        memos.clear()
        lastProbe.clear()
        forceLayout()
        requestLayout()
    }

    private fun invalidateMeasurementAncestors(start: ViewParent?) {
        var ancestor = start
        while (ancestor != null) {
            when (ancestor) {
                is CraftNativeFlexLayout -> ancestor.invalidateMeasurements()
                is CraftNativeKeyboardAvoidingView -> ancestor.content.invalidateMeasurements()
                is CraftNativeScrollView -> ancestor.invalidateContentLayout()
            }
            ancestor = (ancestor as? View)?.parent
        }
    }

    /**
     * Lays a child out at its final frame, measuring it again at exactly
     * that size first when the measure pass left it another size (a
     * stretched or flex-grown child). A container such as the scroll view's
     * SwipeRefreshLayout lays its own children out from its measured size,
     * so a frame it was never measured at left its content 0 tall.
     */
    private fun place(child: View, left: Int, top: Int, right: Int, bottom: Int) {
        val width = max(0, right - left)
        val height = max(0, bottom - top)
        if (child.measuredWidth != width || child.measuredHeight != height) {
            child.measure(
                View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
                View.MeasureSpec.makeMeasureSpec(height, View.MeasureSpec.EXACTLY),
            )
        }
        child.layout(left, top, right, bottom)
    }

    override fun drawChild(canvas: Canvas, child: View, drawingTime: Long): Boolean {
        val skew = CraftNativeSkewTransforms.matrix(child) ?: return super.drawChild(canvas, child, drawingTime)
        val save = canvas.save()
        canvas.concat(skew)
        val drawn = super.drawChild(canvas, child, drawingTime)
        canvas.restoreToCount(save)
        return drawn
    }

    fun configure(style: JSONObject, density: Float) {
        orientation = if (style.optString("flexDirection") in setOf("row", "row-reverse")) HORIZONTAL else VERTICAL
        reverse = style.optString("flexDirection").endsWith("-reverse")
        val flexWrap = style.optString("flexWrap")
        wrap = flexWrap == "wrap" || flexWrap == "wrap-reverse" || style.optBoolean("flexWrap", false)
        wrapReverse = flexWrap == "wrap-reverse"
        alignItems = style.optString("alignItems", "stretch")
        alignContent = style.optString("alignContent", "flex-start")
        justifyContent = style.optString("justifyContent", "flex-start")
        fun spacing(name: String, fallback: Float): Float {
            val value = style.optDouble(name, Double.NaN)
            val pixels = value * density
            val narrowed = pixels.toFloat()
            return if (value.isFinite() && value >= 0 && pixels.isFinite() && narrowed.isFinite()) narrowed else fallback
        }
        val gap = spacing("gap", 0f)
        rowGap = spacing("rowGap", gap)
        columnGap = spacing("columnGap", gap)
        grid = style.optString("display") == "grid"
        gridColumns = craftNativeGridColumnCount(
            if (style.has("gridTemplateColumns")) style.opt("gridTemplateColumns") else style.opt("gridColumns")
        )
        gridAutoRows = CraftNativeLength.from(style.opt("gridAutoRows"), density)
        val all = craftNativePadding(style, "padding", 0, density)
        val horizontal = craftNativePadding(style, "paddingHorizontal", all, density)
        val vertical = craftNativePadding(style, "paddingVertical", all, density)
        setPadding(
            craftNativePadding(style, "paddingLeft", horizontal, density),
            craftNativePadding(style, "paddingTop", vertical, density),
            craftNativePadding(style, "paddingRight", horizontal, density),
            craftNativePadding(style, "paddingBottom", vertical, density),
        )
        invalidateMeasurements()
    }

    fun setChildStyle(view: View, style: JSONObject, density: Float) {
        styles[view] = CraftNativeLayoutStyle.from(style, density)
        invalidateMeasurements()
        invalidateMeasurementAncestors(parent)
    }

    override fun onViewRemoved(child: View) {
        val parentBeforeRemoval = parent
        styles.remove(child)
        super.onViewRemoved(child)
        invalidateMeasurements()
        invalidateMeasurementAncestors(parentBeforeRemoval)
    }

    override fun onViewAdded(child: View) {
        super.onViewAdded(child)
        invalidateMeasurements()
        invalidateMeasurementAncestors(parent)
    }

    private data class Entry(val view: View, val style: CraftNativeLayoutStyle, val width: Int, val height: Int)
    private data class Line(val entries: MutableList<Entry> = mutableListOf(), var main: Float = 0f, var cross: Float = 0f)
    private data class GridLayout(val rows: List<List<Entry>>, val absolute: List<Entry>, val cellWidth: Float, val rowHeights: List<Float>)

    private fun entries(width: Int, height: Int): Pair<List<Line>, List<Entry>> {
        val availableMain = if (orientation == HORIZONTAL) max(0, width - paddingLeft - paddingRight)
        else max(0, height - paddingTop - paddingBottom)
        val gap = if (orientation == HORIZONTAL) columnGap else rowGap
        val lines = mutableListOf<Line>()
        val absolute = mutableListOf<Entry>()
        val pending = mutableListOf<Entry>()
        for (index in 0 until childCount) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            if (child is CraftNativeModalView) {
                val modalWidth = max(0, width - paddingLeft - paddingRight)
                val modalHeight = max(0, height - paddingTop - paddingBottom)
                child.measure(
                    View.MeasureSpec.makeMeasureSpec(modalWidth, View.MeasureSpec.EXACTLY),
                    View.MeasureSpec.makeMeasureSpec(modalHeight, View.MeasureSpec.EXACTLY),
                )
                absolute += Entry(child, style, modalWidth, modalHeight)
                continue
            }
            val childWidth = measureChildWidth(child, style, width - paddingLeft - paddingRight, horizontalMargins)
            val childHeight = measureChildHeight(child, style, height - paddingTop - paddingBottom, verticalMargins)
            val entry = Entry(child, style, childWidth, childHeight)
            if (style.position == "absolute") { absolute += entry; continue }
            pending += entry
        }
        if (pending.isNotEmpty()) {
            val basis = pending.map { entry ->
                if (orientation == HORIZONTAL) entry.width.toFloat() else entry.height.toFloat()
            }.toFloatArray()
            val margins = pending.flatMap { entry ->
                val lp = entry.view.layoutParams as? MarginLayoutParams
                if (orientation == HORIZONTAL) listOf((lp?.leftMargin ?: 0).toFloat(), (lp?.rightMargin ?: 0).toFloat())
                else listOf((lp?.topMargin ?: 0).toFloat(), (lp?.bottomMargin ?: 0).toFloat())
            }.toFloatArray()
            val sharedLineIds = CraftNative.flexLines(availableMain.toFloat(), gap.toFloat(), wrap, basis, margins)
            val lineIds = sharedLineIds?.takeIf { ids ->
                ids.size >= pending.size && ids.firstOrNull() == 0 &&
                    ids.indices.drop(1).all { index -> ids[index] >= ids[index - 1] }
            }
            var line = Line()
            pending.forEachIndexed { index, entry ->
                val childMain = if (orientation == HORIZONTAL) entry.width.toFloat() + margins[index * 2] + margins[index * 2 + 1]
                else entry.height.toFloat() + margins[index * 2] + margins[index * 2 + 1]
                val lp = entry.view.layoutParams as? MarginLayoutParams
                val crossMargins = if (orientation == HORIZONTAL) (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                else (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                val childCross = if (orientation == HORIZONTAL) entry.height + crossMargins else entry.width + crossMargins
                if (index > 0 && lineIds != null && lineIds[index] != lineIds[index - 1]) {
                    lines += line
                    line = Line()
                } else if (index > 0 && lineIds == null && wrap && line.entries.isNotEmpty() && line.main + gap + childMain > availableMain + 0.5f * (line.entries.size + 1)) {
                    // Each size is rounded to whole pixels, up to half a pixel
                    // over: two 60-point items fill a 120-point row exactly
                    // in points, and at 2.625 pixels per point (157.5 + 157.5
                    // in 315) rounding alone must not wrap the second.
                    lines += line
                    line = Line()
                }
                line.entries += entry
                line.main = if (line.entries.size == 1) childMain else line.main + gap + childMain
                line.cross = max(line.cross, childCross.toFloat())
            }
            if (line.entries.isNotEmpty()) lines += line
        }
        // A row's items take their widths from the line (`flex-1` starts
        // from a zero basis), and text wraps to the width it gets: measured
        // at its basis, a `flex-1` column of text was a word per line and
        // thousands of pixels tall. Heights are measured again at the width
        // each item will have.
        if (orientation == HORIZONTAL && width < 500_000) {
            for (line in lines) {
                val widths = fallbackFlexWidths(line, availableMain, gap)
                for (index in line.entries.indices) {
                    val entry = line.entries[index]
                    val given = widths.getOrNull(index) ?: continue
                    if (given == entry.width || entry.style.height != null) continue
                    val lp = entry.view.layoutParams as? MarginLayoutParams
                    val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                    val remeasured = measureChildHeight(entry.view, entry.style, height - paddingTop - paddingBottom, verticalMargins, max(0, given))
                    line.entries[index] = entry.copy(height = remeasured)
                }
                line.cross = line.entries.maxOfOrNull { entry ->
                    val lp = entry.view.layoutParams as? MarginLayoutParams
                    (entry.height + (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)).toFloat()
                } ?: 0f
            }
        }
        // Reconciliation reverses the child order so the main axis runs in
        // the requested direction. With wrapping, that also reverses the
        // line order; flexbox keeps wrap lines in cross-axis order, so restore
        // the groups while retaining the reversed entries inside each line.
        if (reverse && wrap && lines.size > 1) lines.reverse()
        return lines to absolute
    }

    private fun gridLayout(width: Int, height: Int): GridLayout {
        val availableWidth = max(0, width - paddingLeft - paddingRight)
        val gap = columnGap
        val cellWidth = max(0f, (availableWidth.toFloat() - max(0, gridColumns - 1) * gap) / max(1, gridColumns).toFloat())
        val rows = mutableListOf<MutableList<Entry>>()
        val absolute = mutableListOf<Entry>()
        for (index in 0 until childCount) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            if (child is CraftNativeModalView) {
                val modalWidth = max(0, width - paddingLeft - paddingRight)
                val modalHeight = max(0, height - paddingTop - paddingBottom)
                child.measure(
                    View.MeasureSpec.makeMeasureSpec(modalWidth, View.MeasureSpec.EXACTLY),
                    View.MeasureSpec.makeMeasureSpec(modalHeight, View.MeasureSpec.EXACTLY),
                )
                absolute += Entry(child, style, modalWidth, modalHeight)
                continue
            }
            val childWidth = measureChildWidth(child, style, cellWidth.roundToInt(), horizontalMargins)
            val childHeight = measureChildHeight(child, style, height - paddingTop - paddingBottom, verticalMargins)
            val entry = Entry(child, style, childWidth, childHeight)
            if (style.position == "absolute") absolute += entry
            else {
                if (rows.isEmpty() || rows.last().size == gridColumns) rows.add(mutableListOf())
                rows.last() += entry
            }
        }
        val rowHeights = rows.map { row ->
            max((gridAutoRows?.resolve(height - paddingTop - paddingBottom) ?: 0).toFloat(), row.maxOfOrNull { entry ->
                val lp = entry.view.layoutParams as? MarginLayoutParams
                (entry.height + (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)).toFloat()
            } ?: 0f)
        }
        return GridLayout(rows, absolute, cellWidth, rowHeights)
    }

    private fun gridIntrinsicSize(height: Int): Pair<Int, Int> {
        val columns = max(1, gridColumns)
        val columnWidths = IntArray(columns)
        val rowHeights = mutableListOf<Int>()
        var flowIndex = 0
        for (index in 0 until childCount) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            if (style.position == "absolute" || child is CraftNativeModalView) continue
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            val childWidth = measureChildWidth(child, style, 1_000_000, horizontalMargins)
            val childHeight = measureChildHeight(child, style, height, verticalMargins)
            val column = flowIndex % columns
            val row = flowIndex / columns
            while (rowHeights.size <= row) rowHeights += gridAutoRows?.resolve(null) ?: 0
            columnWidths[column] = max(columnWidths[column], childWidth + horizontalMargins)
            rowHeights[row] = max(rowHeights[row], childHeight + verticalMargins)
            flowIndex += 1
        }
        val cellWidth = columnWidths.maxOrNull() ?: 0
        val width = paddingLeft + paddingRight + cellWidth * columns + (max(0, columns - 1) * columnGap).roundToInt()
        val rowGapTotal = max(0, rowHeights.size - 1) * rowGap
        val measuredHeight = paddingTop + paddingBottom + rowHeights.sum() + rowGapTotal.roundToInt()
        return width to measuredHeight
    }

    private fun measureChildWidth(child: View, style: CraftNativeLayoutStyle, available: Int, margins: Int): Int {
        val base = max(0, available - margins)
        val flexBasis = if (orientation == HORIZONTAL) style.flexBasis?.resolve(base) else null
        // The STX style is authoritative. A reused View may still carry a
        // previous fixed LayoutParams width after a reactive width is removed;
        // using that value here prevents intrinsic sizing from being restored.
        val authored = style.width?.resolve(base)
        val explicit = authored ?: style.aspectRatio?.let { ratio -> style.height?.resolve(base)?.times(ratio)?.roundToInt() } ?: flexBasis
        if (explicit != null) {
            probe(
                child,
                View.MeasureSpec.makeMeasureSpec(explicit, View.MeasureSpec.EXACTLY),
                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
            )
            return clamp(explicit, style.minWidth?.resolve(base), style.maxWidth?.resolve(base))
        }
        // A column of a definite width stretches its children across
        // (`align-items: stretch`, the default): they are as wide as the
        // column, not as wide as their content, and what they hold wraps to that width. Measured at their
        // content width, a row with a `flex-1` text column measured as a word
        // per line and stayed that tall once stretched.
        if (orientation == VERTICAL && widthDefinite && style.position != "absolute" && (style.alignSelf ?: alignItems) == "stretch" && base < 500_000 && child !is CraftNativeModalView) {
            val stretched = clamp(base, style.minWidth?.resolve(base), style.maxWidth?.resolve(base))
            probe(
                child,
                View.MeasureSpec.makeMeasureSpec(stretched, View.MeasureSpec.EXACTLY),
                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
            )
            return stretched
        }
        // Measure text and nested flex containers at max-content first. An
        // AT_MOST spec equal to the available room can make Android report the
        // longest-word (min-content) width for a wrapping TextView, collapsing
        // shrink-to-fit bubbles and pills before the parent can clamp them.
        val intrinsicSpec = if (child is TextView && child !is EditText) 1_000_000 else base
        val intrinsic = probe(
            child,
            View.MeasureSpec.makeMeasureSpec(intrinsicSpec, View.MeasureSpec.AT_MOST),
            View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
        )
        val target = clamp(min(base, probedWidth(intrinsic)), style.minWidth?.resolve(base), style.maxWidth?.resolve(base))
        probe(
            child,
            View.MeasureSpec.makeMeasureSpec(target, View.MeasureSpec.AT_MOST),
            View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
        )
        return target
    }

    private fun measureChildHeight(child: View, style: CraftNativeLayoutStyle, available: Int, margins: Int, widthOverride: Int? = null): Int {
        val base = max(0, available - margins)
        val flexBasis = if (orientation == VERTICAL) style.flexBasis?.resolve(base) else null
        // Match width measurement: do not let stale native LayoutParams keep
        // a removed reactive height fixed.
        val authored = style.height?.resolve(base)
        val explicit = authored ?: style.aspectRatio?.let { ratio -> style.width?.resolve(base)?.div(ratio)?.roundToInt() } ?: flexBasis
        val target = explicit ?: base
        val spec = if (explicit != null) View.MeasureSpec.makeMeasureSpec(target, View.MeasureSpec.EXACTLY)
        else View.MeasureSpec.makeMeasureSpec(base, View.MeasureSpec.AT_MOST)
        val width = widthOverride ?: lastProbe[child]?.let(::probedWidth) ?: child.measuredWidth
        val size = probe(child, View.MeasureSpec.makeMeasureSpec(max(0, width), View.MeasureSpec.EXACTLY), spec)
        return clamp(if (explicit != null) target else probedHeight(size), style.minHeight?.resolve(base), style.maxHeight?.resolve(base))
    }

    private fun clamp(value: Int, lower: Int?, upper: Int?): Int {
        var result = value
        if (lower != null) result = max(result, lower)
        if (upper != null) result = min(result, upper)
        return result
    }

    private fun defaultFlexShrink(view: View): Double = when {
        view is ScrollView || view is HorizontalScrollView -> 1.0
        view is TextView && view !is Button && view !is EditText && orientation == HORIZONTAL -> 1.0
        else -> 0.0
    }

    private fun sharedAlignItemsCode(value: String): Int = when (value) {
        "center" -> 1
        "flex-end" -> 2
        "stretch" -> 3
        "baseline" -> 4
        else -> 0
    }

    private fun sharedAlignSelfCode(value: String?): Int = when (value) {
        "flex-start" -> 1
        "center" -> 2
        "flex-end" -> 3
        "stretch" -> 4
        "baseline" -> 5
        else -> 0
    }

    private fun sharedLength(value: CraftNativeLength?): Float = value?.points?.toFloat() ?: Float.NaN

    /**
     * Use the host-neutral tree ABI for the narrow case whose platform
     * measurements are already complete: a definite, non-grid, non-wrapped
     * direct-child container. Percentages, reverse flows, absolute children,
     * missing runtimes, and malformed results deliberately fall through to
     * the established Kotlin layout below.
     */
    private fun sharedDirectFrames(entries: List<Entry>, width: Int, height: Int): FloatArray? {
        if (entries.isEmpty() || width < 0 || height < 0 || grid || wrap || reverse || wrapReverse) return null
        fun pointLength(value: CraftNativeLength?): Boolean = value == null || value.fraction == null
        if (entries.any { entry ->
                val style = entry.style
                !pointLength(style.width) || !pointLength(style.height) ||
                    !pointLength(style.minWidth) || !pointLength(style.maxWidth) ||
                    !pointLength(style.minHeight) || !pointLength(style.maxHeight) ||
                    !pointLength(style.flexBasis)
            }) return null

        val count = entries.size + 1
        val fields = 32
        val nodeData = FloatArray(count * fields) { Float.NaN }
        val treeMeta = FloatArray(count * 2)
        fun enumBits(value: Int): Float = Float.fromBits(value)
        fun put(base: Int, index: Int, value: Float) { nodeData[base + index] = value }
        fun putEnum(base: Int, index: Int, value: Int) { put(base, index, enumBits(value)) }
        fun writeStyle(
            base: Int,
            style: CraftNativeLayoutStyle,
            intrinsicWidth: Float,
            intrinsicHeight: Float,
            baseline: Float,
            margins: IntArray,
            direction: Int,
            padding: IntArray,
            gap: Float,
            rowGapValue: Float,
            columnGapValue: Float,
            root: Boolean,
            view: View?,
        ) {
            putEnum(base, 0, direction)
            put(base, 1, if (root) width.toFloat() else sharedLength(style.width))
            put(base, 2, if (root) height.toFloat() else sharedLength(style.height))
            put(base, 3, if (root) Float.NaN else intrinsicWidth)
            put(base, 4, if (root) Float.NaN else intrinsicHeight)
            put(base, 5, if (root) Float.NaN else baseline)
            put(base, 6, style.aspectRatio?.toFloat() ?: Float.NaN)
            put(base, 7, sharedLength(style.flexBasis))
            put(base, 8, if (root) 0f else style.flexGrow.toFloat().coerceAtLeast(0f))
            put(base, 9, if (root) 0f else (style.flexShrink ?: view?.let { defaultFlexShrink(it) } ?: 0.0).toFloat().coerceAtLeast(0f))
            put(base, 10, sharedLength(style.minWidth))
            put(base, 11, sharedLength(style.maxWidth))
            put(base, 12, sharedLength(style.minHeight))
            put(base, 13, sharedLength(style.maxHeight))
            put(base, 14, if (root) gap else 0f)
            putEnum(base, 15, if (root) justifyCode() else 0)
            putEnum(base, 16, if (root) sharedAlignItemsCode(alignItems) else 3)
            putEnum(base, 17, if (root) 0 else sharedAlignSelfCode(style.alignSelf))
            putEnum(base, 18, 0)
            putEnum(base, 19, if (root) alignContentCode() else 6)
            put(base, 20, margins[2].toFloat())
            put(base, 21, margins[1].toFloat())
            put(base, 22, margins[3].toFloat())
            put(base, 23, margins[0].toFloat())
            put(base, 24, padding[2].toFloat())
            put(base, 25, padding[1].toFloat())
            put(base, 26, padding[3].toFloat())
            put(base, 27, padding[0].toFloat())
            putEnum(base, 28, 0)
            putEnum(base, 29, 1)
            put(base, 30, if (root) rowGapValue else 0f)
            put(base, 31, if (root) columnGapValue else 0f)
        }

        treeMeta[0] = 1f
        treeMeta[1] = entries.size.toFloat()
        val rootMargins = intArrayOf(0, 0, 0, 0)
        val rootPadding = intArrayOf(paddingLeft, paddingRight, paddingTop, paddingBottom)
        val mainGap = if (orientation == HORIZONTAL) columnGap else rowGap
        writeStyle(
            0, CraftNativeLayoutStyle(), 0f, 0f, 0f, rootMargins,
            if (orientation == HORIZONTAL) 0 else 1, rootPadding, mainGap, rowGap, columnGap, true, null,
        )
        entries.forEachIndexed { index, entry ->
            val base = (index + 1) * fields
            val lp = entry.view.layoutParams as? MarginLayoutParams
            val margins = intArrayOf(lp?.leftMargin ?: 0, lp?.rightMargin ?: 0, lp?.topMargin ?: 0, lp?.bottomMargin ?: 0)
            treeMeta[(index + 1) * 2] = 0f
            treeMeta[(index + 1) * 2 + 1] = 0f
            writeStyle(
                base, entry.style, entry.width.toFloat(), entry.height.toFloat(), baselineOffset(entry.view, entry.height).toFloat(),
                margins, 0, intArrayOf(0, 0, 0, 0), 0f, 0f, 0f, false, entry.view,
            )
        }
        return CraftNative.layoutTree(width.toFloat(), height.toFloat(), nodeData, treeMeta)
    }

    private fun justifyCode(): Int = when (justifyContent) {
        "center" -> 1
        "flex-end" -> 2
        "space-between" -> 3
        "space-around" -> 4
        "space-evenly" -> 5
        else -> 0
    }

    private fun alignContentCode(): Int = when (alignContent) {
        "center" -> 1
        "flex-end" -> 2
        "space-between" -> 3
        "space-around" -> 4
        "stretch" -> 5
        "space-evenly" -> 6
        else -> 0
    }

    /** Keep the old-runtime shim on the same bounded-flex water-fill rule as the Zig bridge. */
    private fun fallbackFlexWidths(line: Line, available: Int, gap: Float): IntArray {
        val horizontal = orientation == HORIZONTAL
        val hypothetical = line.entries.sumOf { entry ->
            val lp = entry.view.layoutParams as? MarginLayoutParams
            val margins = if (horizontal) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            ((if (horizontal) entry.width else entry.height) + margins).toDouble()
        } + max(0, line.entries.size - 1) * gap.toDouble()
        val free = available.toDouble() - hypothetical
        val growTotal = line.entries.sumOf { it.style.flexGrow }
        val shrinkTotal = line.entries.sumOf {
            (it.style.flexShrink ?: defaultFlexShrink(it.view)) * (if (horizontal) it.width else it.height)
        }
        val growing = free > 0 && growTotal > 0
        val shrinking = free < 0 && shrinkTotal > 0
        val widths = IntArray(line.entries.size) { index -> if (horizontal) line.entries[index].width else line.entries[index].height }
        if (!growing && !shrinking) return widths

        val frozen = BooleanArray(widths.size)
        repeat(widths.size + 1) {
            var fixed = max(0, widths.size - 1) * gap.toDouble()
            var activeBasis = 0.0
            var factor = 0.0
            for ((index, entry) in line.entries.withIndex()) {
                val lp = entry.view.layoutParams as? MarginLayoutParams
                val margins = if (horizontal) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                fixed += margins
                if (frozen[index]) fixed += widths[index]
                else {
                    val basis = if (horizontal) entry.width else entry.height
                    activeBasis += basis
                    factor += if (growing) entry.style.flexGrow
                    else (entry.style.flexShrink ?: defaultFlexShrink(entry.view)) * basis
                }
            }
            if (factor <= 0) return@repeat
            val remaining = available.toDouble() - fixed - activeBasis
            var froze = false
            for ((index, entry) in line.entries.withIndex()) {
                if (frozen[index]) continue
                val basis = (if (horizontal) entry.width else entry.height).toDouble()
                val share = if (growing) remaining * entry.style.flexGrow / factor
                else -remaining * (entry.style.flexShrink ?: defaultFlexShrink(entry.view)) * basis / factor
                val raw = if (growing) basis + share else basis - share
                val lower = (if (horizontal) entry.style.minWidth else entry.style.minHeight)?.resolve(if (horizontal) width - paddingLeft - paddingRight else height - paddingTop - paddingBottom)
                val upper = (if (horizontal) entry.style.maxWidth else entry.style.maxHeight)?.resolve(if (horizontal) width - paddingLeft - paddingRight else height - paddingTop - paddingBottom)
                var bounded = raw
                if (lower != null) bounded = max(bounded, lower.toDouble())
                if (upper != null) bounded = min(bounded, upper.toDouble())
                widths[index] = bounded.roundToInt().coerceAtLeast(0)
                if (bounded != raw) {
                    frozen[index] = true
                    froze = true
                }
            }
            if (!froze) return@repeat
        }
        return widths
    }

    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val widthMode = View.MeasureSpec.getMode(widthMeasureSpec)
        widthDefinite = widthMode == View.MeasureSpec.EXACTLY
        val width = View.MeasureSpec.getSize(widthMeasureSpec).takeUnless { widthMode == View.MeasureSpec.UNSPECIFIED } ?: 1_000_000
        val height = View.MeasureSpec.getSize(heightMeasureSpec).takeUnless { View.MeasureSpec.getMode(heightMeasureSpec) == View.MeasureSpec.UNSPECIFIED } ?: 1_000_000
        if (grid) {
            if (widthMode == View.MeasureSpec.UNSPECIFIED) {
                val (intrinsicWidth, intrinsicHeight) = gridIntrinsicSize(height)
                setMeasuredDimension(
                    resolveSize(intrinsicWidth, widthMeasureSpec),
                    resolveSize(intrinsicHeight, heightMeasureSpec),
                )
                return
            }
            val layout = gridLayout(width, height)
            val desiredWidth = paddingLeft + paddingRight + (layout.cellWidth * gridColumns + max(0, gridColumns - 1) * columnGap).roundToInt()
            val desiredHeight = paddingTop + paddingBottom + layout.rowHeights.sum().roundToInt() + (max(0, layout.rowHeights.size - 1) * rowGap).roundToInt()
            setMeasuredDimension(resolveSize(desiredWidth, widthMeasureSpec), resolveSize(desiredHeight, heightMeasureSpec))
            return
        }
        val (lines, absolute) = entries(width, height)
        val main = lines.maxOfOrNull { it.main } ?: 0f
        val cross = lines.sumOf { it.cross.toDouble() } + max(0, lines.size - 1) * (if (orientation == HORIZONTAL) rowGap else columnGap).toDouble()
        val desiredWidth = if (orientation == HORIZONTAL) main.roundToInt() else cross.roundToInt()
        val desiredHeight = if (orientation == HORIZONTAL) cross.roundToInt() else main.roundToInt()
        val absWidth = absolute.maxOfOrNull { it.width } ?: 0
        val absHeight = absolute.maxOfOrNull { it.height } ?: 0
        setMeasuredDimension(
            resolveSize(max(desiredWidth + paddingLeft + paddingRight, absWidth + paddingLeft + paddingRight), widthMeasureSpec),
            resolveSize(max(desiredHeight + paddingTop + paddingBottom, absHeight + paddingTop + paddingBottom), heightMeasureSpec),
        )
    }

    override fun onLayout(changed: Boolean, left: Int, top: Int, right: Int, bottom: Int) {
        widthDefinite = true
        if (grid) {
            val layout = gridLayout(width, height)
            val contentWidth = width - paddingLeft - paddingRight
            val contentHeight = height - paddingTop - paddingBottom
            val flow = layout.rows.flatten()
            // Older runtimes return null for the optional symbol; the local
            // layout below remains the compatibility path in that case.
            val sharedFrames = CraftNative.grid(
                contentWidth.toFloat(), contentHeight.toFloat(), gridColumns, columnGap, rowGap,
                flow.map { it.width.toFloat() }.toFloatArray(), flow.map { it.height.toFloat() }.toFloatArray(),
                flow.map { it.style.width?.resolve(layout.cellWidth.roundToInt())?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.height?.resolve(null)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.minWidth?.resolve(layout.cellWidth.roundToInt())?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.maxWidth?.resolve(layout.cellWidth.roundToInt())?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.minHeight?.resolve(null)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.maxHeight?.resolve(null)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.flatMap {
                    val lp = it.view.layoutParams as? MarginLayoutParams
                    listOf((lp?.leftMargin ?: 0).toFloat(), (lp?.rightMargin ?: 0).toFloat(), (lp?.topMargin ?: 0).toFloat(), (lp?.bottomMargin ?: 0).toFloat())
                }.toFloatArray(),
                flow.flatMap {
                    val align = it.style.alignSelf ?: alignItems
                    listOf(if (align == "stretch") 1f else 0f, if (align == "center") 1f else if (align == "flex-end") 2f else 0f)
                }.toFloatArray(),
                gridAutoRows?.resolve(contentHeight)?.toFloat(),
                alignContentCode(),
            )
            if (sharedFrames != null) {
                for ((index, entry) in flow.withIndex()) {
                    val offset = index * 4
                    val x = paddingLeft + sharedFrames[offset].roundToInt()
                    val y = paddingTop + sharedFrames[offset + 1].roundToInt()
                    val childWidth = sharedFrames[offset + 2].roundToInt()
                    val childHeight = sharedFrames[offset + 3].roundToInt()
                    place(entry.view, x, y, x + childWidth, y + childHeight)
                }
            } else {
                val totalRows = layout.rowHeights.sum()
                val rowGaps = max(0, layout.rowHeights.size - 1) * rowGap.toFloat()
                val freeRows = max(0f, contentHeight.toFloat() - totalRows - rowGaps)
                val rowCount = max(1, layout.rowHeights.size)
                var rowLeading = 0f
                var rowBetween = rowGap.toFloat()
                var rowExtra = 0f
                when (alignContentCode()) {
                    1 -> rowLeading = freeRows / 2f
                    2 -> rowLeading = freeRows
                    3 -> if (rowCount > 1) rowBetween += freeRows / (rowCount - 1).toFloat()
                    4 -> {
                        rowLeading = freeRows / (rowCount * 2).toFloat()
                        rowBetween += freeRows / rowCount.toFloat()
                    }
                    6 -> {
                        rowLeading = freeRows / (rowCount + 1).toFloat()
                        rowBetween += freeRows / (rowCount + 1).toFloat()
                    }
                    5 -> rowExtra = freeRows / rowCount.toFloat()
                }
                var rowTop = paddingTop.toFloat() + rowLeading
                for ((rowIndex, row) in layout.rows.withIndex()) {
                    val rowHeight = layout.rowHeights[rowIndex].toFloat() + rowExtra
                    for ((column, entry) in row.withIndex()) {
                        val align = entry.style.alignSelf ?: alignItems
                        val lp = entry.view.layoutParams as? MarginLayoutParams
                        val marginLeft = lp?.leftMargin ?: 0
                        val marginRight = lp?.rightMargin ?: 0
                        val marginTop = lp?.topMargin ?: 0
                        val marginBottom = lp?.bottomMargin ?: 0
                        val availableWidth = max(0f, layout.cellWidth - marginLeft - marginRight)
                        val availableHeight = max(0, (rowHeight - marginTop - marginBottom).roundToInt())
                        val childWidth = if (align == "stretch" && entry.style.width == null) availableWidth.roundToInt() else min(availableWidth.roundToInt(), entry.width)
                        val childHeight = if (align == "stretch" && entry.style.height == null) availableHeight else min(availableHeight, entry.height)
                        val x = (paddingLeft + column * (layout.cellWidth + columnGap) + marginLeft + when (align) {
                            "center" -> (availableWidth - childWidth) / 2f
                            "flex-end" -> availableWidth - childWidth
                            else -> 0f
                        }).roundToInt()
                        val y = (rowTop + marginTop + when (align) {
                            "center" -> (availableHeight - childHeight) / 2
                            "flex-end" -> availableHeight - childHeight
                            else -> 0
                        }).roundToInt()
                        place(entry.view, x, y, x + childWidth, y + childHeight)
                    }
                    rowTop += rowHeight + rowBetween
                }
            }
            for (entry in layout.absolute) {
                if (entry.view is CraftNativeModalView && entry.view.visibility == View.VISIBLE) entry.view.bringToFront()
                val childWidth = if (entry.style.left != null && entry.style.right != null) contentWidth - entry.style.left!! - entry.style.right!! else entry.width
                val childHeight = if (entry.style.top != null && entry.style.bottom != null) contentHeight - entry.style.top!! - entry.style.bottom!! else entry.height
                val x = paddingLeft + (entry.style.left ?: (entry.style.right?.let { contentWidth - it - childWidth } ?: 0))
                val y = paddingTop + (entry.style.top ?: (entry.style.bottom?.let { contentHeight - it - childHeight } ?: 0))
                place(entry.view, x, y, x + max(0, childWidth), y + max(0, childHeight))
            }
            onLayoutChanged?.invoke()
            return
        }
        val contentWidth = width - paddingLeft - paddingRight
        val contentHeight = height - paddingTop - paddingBottom
        val (lines, absolute) = entries(width, height)
        if (absolute.isEmpty() && lines.size == 1) {
            val sharedFrames = sharedDirectFrames(lines[0].entries, width, height)
            if (sharedFrames != null) {
                for ((index, entry) in lines[0].entries.withIndex()) {
                    val offset = (index + 1) * 4
                    val x = sharedFrames[offset].roundToInt()
                    val y = sharedFrames[offset + 1].roundToInt()
                    val childWidth = sharedFrames[offset + 2].roundToInt()
                    val childHeight = sharedFrames[offset + 3].roundToInt()
                    place(entry.view, x, y, x + childWidth, y + childHeight)
                }
                onLayoutChanged?.invoke()
                return
            }
        }
        val gap = if (orientation == HORIZONTAL) columnGap else rowGap
        val crossGap = if (orientation == HORIZONTAL) rowGap else columnGap
        val availableMain = if (orientation == HORIZONTAL) contentWidth else contentHeight
        val availableCross = if (orientation == HORIZONTAL) contentHeight else contentWidth
        val totalCross = lines.sumOf { it.cross.toDouble() }.toFloat() + max(0, lines.size - 1) * crossGap
        val crossFree = max(0f, availableCross.toFloat() - totalCross)
        var crossLeading = 0f
        var crossBetween = crossGap
        val sharedCross = if (wrap && lines.size > 1) {
            CraftNative.flexLineDistribution(
                availableCross.toFloat(), crossGap, alignContentCode(), lines.map { it.cross }.toFloatArray()
            )
        } else null
        sharedCross?.second?.forEachIndexed { index, size -> lines[index].cross = size }
        if (wrap && lines.size > 1) {
            if (sharedCross == null) when (alignContent) {
                "center" -> crossLeading = crossFree / 2f
                "flex-end" -> crossLeading = crossFree
                "space-between" -> crossBetween = crossFree / (lines.size - 1).toFloat() + crossGap
                "space-around" -> {
                    crossBetween = crossFree / lines.size.toFloat() + crossGap
                    crossLeading = crossFree / (lines.size * 2).toFloat()
                }
                "space-evenly" -> {
                    crossBetween = crossFree / (lines.size + 1).toFloat() + crossGap
                    crossLeading = crossFree / (lines.size + 1).toFloat()
                }
            }
        }
        val stretchExtra = if (sharedCross == null && wrap && lines.size > 1 && alignContent == "stretch")
            crossFree / lines.size.toFloat()
        else 0f
        var crossOffset = (if (orientation == HORIZONTAL) paddingTop else paddingLeft).toFloat() + crossLeading
            val crossOrigin = (if (orientation == HORIZONTAL) paddingTop else paddingLeft).toFloat()
            val crossExtent = availableCross.toFloat()
        for ((lineIndex, line) in lines.withIndex()) {
            // A single-line container's one line is as tall (or wide) as the
            // container itself, as in CSS: `h-12 items-center` centres its
            // children in the 48 points, not in the tallest child.
            val lineCross = if (!wrap) max(line.cross.toFloat(), availableCross.toFloat())
            else line.cross.toFloat() + stretchExtra
                val lineOffset = sharedCross?.first?.get(lineIndex)?.let { crossOrigin + it } ?: crossOffset
                val physicalLineOffset = if (wrapReverse && wrap) crossOrigin + crossExtent - (lineOffset - crossOrigin) - lineCross else lineOffset
            val fallbackWidths = fallbackFlexWidths(line, availableMain, gap)
            val sharedPrimary = CraftNative.flexRow(
                availableMain.toFloat(),
                gap,
                justifyCode(),
                line.entries.map { entry -> if (orientation == HORIZONTAL) entry.width.toFloat() else entry.height.toFloat() }.toFloatArray(),
                line.entries.map { it.style.flexGrow.toFloat() }.toFloatArray(),
                line.entries.map { (it.style.flexShrink ?: defaultFlexShrink(it.view)).toFloat() }.toFloatArray(),
                line.entries.map {
                    (if (orientation == HORIZONTAL) it.style.minWidth?.resolve(contentWidth) else it.style.minHeight?.resolve(contentHeight))?.toFloat()
                        ?: Float.NaN
                }.toFloatArray(),
                line.entries.map {
                    (if (orientation == HORIZONTAL) it.style.maxWidth?.resolve(contentWidth) else it.style.maxHeight?.resolve(contentHeight))?.toFloat()
                        ?: Float.NaN
                }.toFloatArray(),
                line.entries.flatMap { entry ->
                    val lp = entry.view.layoutParams as? MarginLayoutParams
                    if (orientation == HORIZONTAL) listOf((lp?.leftMargin ?: 0).toFloat(), (lp?.rightMargin ?: 0).toFloat())
                    else listOf((lp?.topMargin ?: 0).toFloat(), (lp?.bottomMargin ?: 0).toFloat())
                }.toFloatArray(),
            )
            val sharedPositions = sharedPrimary?.takeIf { it.size == line.entries.size * 2 }
            val distributedMain = if (sharedPrimary != null) {
                line.entries.indices.sumOf { index ->
                    val lp = line.entries[index].view.layoutParams as? MarginLayoutParams
                    val margins = if (orientation == HORIZONTAL) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                    else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                    sharedPrimary[index].toDouble() + margins
                } + max(0, line.entries.size - 1) * gap.toDouble()
            } else {
                line.entries.indices.sumOf { index ->
                    val constrained = fallbackWidths[index]
                    val lp = line.entries[index].view.layoutParams as? MarginLayoutParams
                    val margins = if (orientation == HORIZONTAL) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                        else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                    constrained + margins
                }.toDouble() + max(0, line.entries.size - 1) * gap.toDouble()
            }
            val free = max(0f, availableMain.toFloat() - distributedMain.toFloat())
            val (leading, between) = distribution(free, line.entries.size)
            var mainOffset = (if (orientation == HORIZONTAL) paddingLeft else paddingTop).toFloat() + leading
            val baseline = if (orientation == HORIZONTAL) {
                line.entries.filter { (it.style.alignSelf ?: alignItems) == "baseline" }.maxOfOrNull { entry ->
                    val lp = entry.view.layoutParams as? MarginLayoutParams
                    (lp?.topMargin ?: 0) + baselineOffset(entry.view, entry.height)
                }
            } else null
            for ((index, entry) in line.entries.withIndex()) {
                val lp = entry.view.layoutParams as? MarginLayoutParams
                val marginStart = if (orientation == HORIZONTAL) lp?.leftMargin ?: 0 else lp?.topMargin ?: 0
                val marginEnd = if (orientation == HORIZONTAL) lp?.rightMargin ?: 0 else lp?.bottomMargin ?: 0
                val crossSize = if ((entry.style.alignSelf ?: alignItems) == "stretch" && (if (orientation == HORIZONTAL) entry.style.height else entry.style.width) == null)
                    max(0, (lineCross - (if (orientation == HORIZONTAL) (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0) else (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0))).roundToInt())
                else if (orientation == HORIZONTAL) entry.height else entry.width
                val align = entry.style.alignSelf ?: alignItems
                val crossLeading = (if (orientation == HORIZONTAL) lp?.topMargin ?: 0 else lp?.leftMargin ?: 0).toFloat()
                val crossTrailing = (if (orientation == HORIZONTAL) lp?.bottomMargin ?: 0 else lp?.rightMargin ?: 0).toFloat()
                val crossPosition = if (align == "baseline" && baseline != null) {
                    val childBaseline = baselineOffset(entry.view, crossSize).toFloat()
                    CraftNative.crossAxisPosition(
                        baseline.toFloat(), childBaseline, crossLeading, crossTrailing, 3
                    ) ?: max(crossLeading, baseline.toFloat() - childBaseline)
                } else {
                    val alignment = when (align) {
                        "center" -> 1
                        "flex-end" -> 2
                        else -> 0
                    }
                    CraftNative.crossAxisPosition(
                        lineCross, crossSize.toFloat(), crossLeading, crossTrailing, alignment
                    ) ?: when (alignment) {
                        1 -> crossLeading + (lineCross - crossLeading - crossTrailing - crossSize) / 2f
                        2 -> lineCross - crossTrailing - crossSize
                        else -> crossLeading
                    }
                }
                val physicalCrossPosition = if (wrapReverse && wrap) lineCross - crossPosition - crossSize else crossPosition
                // Shared positions cover every non-reverse justification; the
                // local main-axis rule remains the fallback for old runtimes
                // that return widths only.
                // The shared result stores widths in the first half and
                // main-axis positions in the second half.
                val sharedPosition = if (!reverse) sharedPositions?.get(line.entries.size + index) else null
                val positionedMain = sharedPosition?.let { (if (orientation == HORIZONTAL) paddingLeft else paddingTop).toFloat() + it }
                    ?: mainOffset + marginStart
                val x = if (orientation == HORIZONTAL) positionedMain.roundToInt() else (physicalLineOffset + physicalCrossPosition).roundToInt()
                val y = if (orientation == HORIZONTAL) (physicalLineOffset + physicalCrossPosition).roundToInt() else positionedMain.roundToInt()
                val distributedPrimary = sharedPrimary?.get(index)?.roundToInt() ?: fallbackWidths[index]
                val w = if (orientation == HORIZONTAL) distributedPrimary else crossSize
                val h = if (orientation == HORIZONTAL) crossSize else distributedPrimary
                place(entry.view, x, y, x + w, y + h)
                if (sharedPosition == null) mainOffset += distributedPrimary + marginStart + marginEnd + gap + between
            }
            if (sharedCross == null) crossOffset += lineCross + crossBetween
        }
        for (entry in absolute) {
            if (entry.view is CraftNativeModalView && entry.view.visibility == View.VISIBLE) entry.view.bringToFront()
            val widthValue = if (entry.style.left != null && entry.style.right != null) contentWidth - entry.style.left!! - entry.style.right!! else entry.width
            val heightValue = if (entry.style.top != null && entry.style.bottom != null) contentHeight - entry.style.top!! - entry.style.bottom!! else entry.height
            val x = paddingLeft + (entry.style.left ?: (entry.style.right?.let { contentWidth - it - widthValue } ?: 0))
            val y = paddingTop + (entry.style.top ?: (entry.style.bottom?.let { contentHeight - it - heightValue } ?: 0))
            place(entry.view, x, y, x + max(0, widthValue), y + max(0, heightValue))
        }
        onLayoutChanged?.invoke()
    }

    private fun distribution(free: Float, count: Int): Pair<Float, Float> {
        val available = free
        return when (justifyContent) {
            "center" -> available / 2f to 0f
            "flex-end" -> available to 0f
            "space-between" -> 0f to if (count > 1) available / (count - 1).toFloat() else 0f
            "space-around" -> available / (count * 2).toFloat() to available / count.toFloat()
            "space-evenly" -> available / (count + 1).toFloat() to available / (count + 1).toFloat()
            else -> 0f to 0f
        }
    }

    /** First text baseline in pixels; non-text views align by their bottom. */
    private fun baselineOffset(view: View, cross: Int): Int = view.baseline.takeIf { it >= 0 }?.coerceIn(0, cross) ?: cross
}

