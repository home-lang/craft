private const val CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS = 30_000L

private data class CraftNativeLength(
    val points: Int? = null,
    val fraction: Double? = null,
) {
    fun resolve(base: Int?): Int? = points ?: fraction?.let { value -> base?.let { max(0, (it * value).roundToInt()) } }

    companion object {
        fun from(value: Any?, density: Float): CraftNativeLength? {
            if (value == null || value == JSONObject.NULL) return null
            if (value is Number) return CraftNativeLength(points = (value.toDouble() * density).roundToInt())
            val text = value.toString().trim()
            if (text.endsWith('%')) return text.dropLast(1).toDoubleOrNull()?.let { CraftNativeLength(fraction = it / 100) }
            if (text.endsWith("px")) return text.dropLast(2).toDoubleOrNull()?.let { CraftNativeLength(points = (it * density).roundToInt()) }
            return text.toDoubleOrNull()?.let { CraftNativeLength(points = (it * density).roundToInt()) }
        }
    }
}

private data class CraftNativeLayoutStyle(
    val width: CraftNativeLength? = null,
    val height: CraftNativeLength? = null,
    val minWidth: CraftNativeLength? = null,
    val maxWidth: CraftNativeLength? = null,
    val minHeight: CraftNativeLength? = null,
    val maxHeight: CraftNativeLength? = null,
    val position: String = "relative",
    val top: Int? = null,
    val right: Int? = null,
    val bottom: Int? = null,
    val left: Int? = null,
    val alignSelf: String? = null,
    val flexGrow: Double = 0.0,
    val flexShrink: Double? = null,
    val flexBasis: CraftNativeLength? = null,
) {
    companion object {
        fun from(raw: JSONObject, density: Float): CraftNativeLayoutStyle {
            fun length(name: String): CraftNativeLength? = CraftNativeLength.from(raw.opt(name), density)
            fun number(name: String): Int? {
                if (!raw.has(name) || raw.isNull(name)) return null
                return raw.optDouble(name, Double.NaN).takeUnless { it.isNaN() }?.let { (it * density).roundToInt() }
            }
            fun decimal(name: String): Double? {
                if (!raw.has(name) || raw.isNull(name)) return null
                return raw.optDouble(name, Double.NaN).takeUnless { it.isNaN() }
            }
            val flex = decimal("flex")
            return CraftNativeLayoutStyle(
                width = length("width"), height = length("height"),
                minWidth = length("minWidth"), maxWidth = length("maxWidth"),
                minHeight = length("minHeight"), maxHeight = length("maxHeight"),
                position = raw.opt("position")
                    ?.takeUnless { it == JSONObject.NULL }
                    ?.toString()
                    ?.takeIf { it.isNotBlank() }
                    ?: "relative",
                top = number("top"), right = number("right"), bottom = number("bottom"), left = number("left"),
                alignSelf = raw.opt("alignSelf")
                    ?.takeUnless { it == JSONObject.NULL }
                    ?.toString()
                    ?.takeIf { it.isNotBlank() && it != "auto" },
                flexGrow = decimal("flexGrow") ?: flex?.coerceAtLeast(0.0) ?: 0.0,
                flexShrink = decimal("flexShrink") ?: flex?.let { if (it != 0.0) 1.0 else 0.0 },
                flexBasis = length("flexBasis")
                    ?: flex?.takeIf { it > 0.0 }?.let { CraftNativeLength(points = 0) },
            )
        }
    }
}

private fun craftNativeGridColumnCount(value: Any?): Int {
    if (value is Number) return max(1, value.toInt())
    val text = value as? String ?: return 1
    val trimmed = text.trim()
    if (trimmed.startsWith("repeat(")) {
        val count = trimmed.removePrefix("repeat(").takeWhile { it.isDigit() }.toIntOrNull()
        if (count != null) return max(1, count)
    }
    return max(1, trimmed.split(Regex("\\s+")).count { it.isNotBlank() })
}

/** A DOM-free SVG surface for the geometry emitted by the shared STX native protocol. */
private class CraftNativeSvgView(context: Context) : View(context) {
    var drawing: JSONObject = JSONObject()
        set(value) {
            field = value
            invalidate()
            requestLayout()
        }

    private data class SvgPaint(
        val fill: String? = "#000000",
        val stroke: String? = null,
        val strokeWidth: Float = 1f,
        val color: String = "#000000",
        val opacity: Float = 1f,
        val typeface: Typeface = Typeface.DEFAULT,
    ) {
        fun merge(node: JSONObject): SvgPaint {
            val props = node.optJSONObject("props") ?: JSONObject()
            val style = node.optJSONObject("style") ?: JSONObject()
            fun value(name: String): String? = when {
                style.has(name) && !style.isNull(name) -> style.optString(name)
                props.has(name) && !props.isNull(name) -> props.optString(name)
                else -> null
            }
            val weight = value("fontWeight")
            return copy(
                fill = value("fill") ?: fill,
                stroke = value("stroke") ?: stroke,
                strokeWidth = value("strokeWidth")?.toFloatOrNull() ?: strokeWidth,
                color = value("color") ?: color,
                opacity = (value("opacity")?.toFloatOrNull() ?: 1f) * opacity,
                typeface = if (weight in setOf("bold", "700")) Typeface.DEFAULT_BOLD else typeface,
            )
        }
    }

    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val width = MeasureSpec.getSize(widthMeasureSpec)
        val box = viewBox()
        val naturalHeight = if (box != null && box.second > 0) (width * box.second / box.first).roundToInt() else 0
        val height = when (MeasureSpec.getMode(heightMeasureSpec)) {
            MeasureSpec.EXACTLY -> MeasureSpec.getSize(heightMeasureSpec)
            MeasureSpec.AT_MOST -> min(naturalHeight, MeasureSpec.getSize(heightMeasureSpec))
            else -> naturalHeight
        }
        setMeasuredDimension(resolveSize(width, widthMeasureSpec), resolveSize(height, heightMeasureSpec))
    }

    /** viewBox units to the view's pixels, set by each draw. */
    private val viewTransform = Matrix()
    private val inverseTransform = Matrix()

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        val box = viewBox() ?: return
        if (box.first <= 0 || box.second <= 0) return
        // Centred at one scale (SVG's default, `xMidYMid meet`), or each axis
        // stretched to fill (`preserveAspectRatio="none"`).
        val stretch = drawing.optJSONObject("props")?.optString("preserveAspectRatio")?.trim() == "none"
        var sx = width.toFloat() / box.first
        var sy = height.toFloat() / box.second
        var dx = 0f
        var dy = 0f
        if (!stretch) {
            val scale = min(sx, sy)
            sx = scale
            sy = scale
            dx = (width - box.first * scale) / 2f
            dy = (height - box.second * scale) / 2f
        }
        if (!sx.isFinite() || !sy.isFinite() || sx <= 0f || sy <= 0f) return
        viewTransform.reset()
        viewTransform.postTranslate(-box.third, -box.fourth)
        viewTransform.postScale(sx, sy)
        viewTransform.postTranslate(dx, dy)
        viewTransform.invert(inverseTransform)
        canvas.save()
        canvas.concat(viewTransform)
        drawNodes(canvas, drawing.optJSONArray("children") ?: JSONArray(), SvgPaint().merge(drawing))
        canvas.restore()
    }

    private fun viewBox(): Quadruple<Float, Float, Float, Float>? {
        val values = drawing.optJSONObject("props")?.optJSONArray("viewBox") ?: return null
        if (values.length() != 4) return null
        val x = values.optDouble(0, Double.NaN).toFloat()
        val y = values.optDouble(1, Double.NaN).toFloat()
        val width = values.optDouble(2, Double.NaN).toFloat()
        val height = values.optDouble(3, Double.NaN).toFloat()
        if (!x.isFinite() || !y.isFinite() || !width.isFinite() || !height.isFinite()) return null
        return Quadruple(width, height, x, y)
    }

    private fun drawNodes(canvas: Canvas, children: JSONArray, inherited: SvgPaint) {
        for (index in 0 until children.length()) {
            val node = children.optJSONObject(index) ?: continue
            val style = node.optJSONObject("style") ?: JSONObject()
            if (style.optString("display") == "none") continue
            val paint = inherited.merge(node)
            when (node.optString("type")) {
                "G" -> drawNodes(canvas, node.optJSONArray("children") ?: JSONArray(), paint)
                "SvgText" -> drawText(canvas, node, paint)
                else -> drawPath(canvas, node, paint)
            }
        }
    }

    private fun drawPath(canvas: Canvas, node: JSONObject, style: SvgPaint) {
        val props = node.optJSONObject("props") ?: JSONObject()
        val geometry = props.optJSONArray("geometry") ?: return
        val path = Path()
        var index = 0
        while (index < geometry.length()) {
            val command = geometry.optDouble(index, Double.NaN).toInt()
            fun number(offset: Int): Float = geometry.optDouble(index + offset, Double.NaN).toFloat()
            when (command) {
                0 -> if (index + 2 < geometry.length()) { path.moveTo(number(1), number(2)); index += 3 } else break
                1 -> if (index + 2 < geometry.length()) { path.lineTo(number(1), number(2)); index += 3 } else break
                2 -> if (index + 6 < geometry.length()) { path.cubicTo(number(1), number(2), number(3), number(4), number(5), number(6)); index += 7 } else break
                3 -> if (index + 4 < geometry.length()) { path.quadTo(number(1), number(2), number(3), number(4)); index += 5 } else break
                4 -> { path.close(); index += 1 }
                else -> break
            }
        }
        val fill = android.graphics.Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = resolveColor(style.fill, style.color, Color.TRANSPARENT)
            alpha = (style.opacity * 255f).roundToInt().coerceIn(0, 255)
            this.style = Paint.Style.FILL
        }
        if (style.fill != "none" && style.fill != "transparent") canvas.drawPath(path, fill)
        if (!style.stroke.isNullOrBlank() && style.stroke != "none" && style.stroke != "transparent" && style.strokeWidth > 0) {
            val stroke = android.graphics.Paint(Paint.ANTI_ALIAS_FLAG).apply {
                color = resolveColor(style.stroke, style.color, Color.TRANSPARENT)
                alpha = (style.opacity * 255f).roundToInt().coerceIn(0, 255)
                this.style = Paint.Style.STROKE
                strokeWidth = style.strokeWidth
                strokeCap = when (props.optString("strokeLinecap")) {
                    "round" -> Paint.Cap.ROUND
                    "square" -> Paint.Cap.SQUARE
                    else -> Paint.Cap.BUTT
                }
                strokeJoin = when (props.optString("strokeLinejoin")) {
                    "round" -> Paint.Join.ROUND
                    "bevel" -> Paint.Join.BEVEL
                    else -> Paint.Join.MITER
                }
                props.optJSONArray("strokeDasharray")?.let { values ->
                    val dashes: List<Float> = (0 until values.length()).mapNotNull {
                        values.optDouble(it, Double.NaN).takeUnless { value -> value.isNaN() }?.toFloat()
                    }
                    if (dashes.isNotEmpty()) {
                        val dashPattern = dashes.toFloatArray()
                        val pattern: FloatArray = if (dashPattern.size % 2 == 1) {
                            FloatArray(dashPattern.size * 2) { index -> dashPattern[index % dashPattern.size] }
                        } else {
                            dashPattern
                        }
                        pathEffect = DashPathEffect(pattern, 0f)
                    }
                }
            }
            // `vector-effect="non-scaling-stroke"`: the stroke is in the view's
            // pixels, so a stretched chart's line keeps its width.
            if (props.optString("vectorEffect") == "non-scaling-stroke") {
                val line = Path(path).apply { transform(viewTransform) }
                canvas.save()
                canvas.concat(inverseTransform)
                canvas.drawPath(line, stroke)
                canvas.restore()
            } else {
                canvas.drawPath(path, stroke)
            }
        }
    }

    private fun drawText(canvas: Canvas, node: JSONObject, style: SvgPaint) {
        val props = node.optJSONObject("props") ?: JSONObject()
        val nodeStyle = node.optJSONObject("style") ?: JSONObject()
        val text = buildString {
            val children = node.optJSONArray("children") ?: JSONArray()
            for (index in 0 until children.length()) if (children.opt(index) is String) append(children.optString(index))
        }
        if (text.isEmpty()) return
        val size = (if (props.has("fontSize")) props.optDouble("fontSize", 12.0) else nodeStyle.optDouble("fontSize", 12.0))
            .toFloat()
        val paint = android.graphics.Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = resolveColor(style.fill, style.color, Color.BLACK)
            alpha = (style.opacity * 255f).roundToInt().coerceIn(0, 255)
            textSize = size
            typeface = style.typeface
        }
        var x = props.optDouble("x", 0.0).toFloat()
        val y = props.optDouble("y", 0.0).toFloat()
        when (props.optString("textAnchor")) {
            "middle" -> x -= paint.measureText(text) / 2f
            "end" -> x -= paint.measureText(text)
        }
        canvas.drawText(text, x, y, paint)
    }

    private fun resolveColor(value: String?, current: String, fallback: Int): Int = runCatching {
        Color.parseColor(if (value == "currentColor") current else value ?: current)
    }.getOrDefault(fallback)

    private data class Quadruple<T1, T2, T3, T4>(val first: T1, val second: T2, val third: T3, val fourth: T4)
}

/** A deterministic flex-shaped container shared by normal views and scroll content. */
private class CraftNativeFlexLayout(context: Context) : LinearLayout(context) {
    var onLayoutChanged: (() -> Unit)? = null
    private val styles = mutableMapOf<View, CraftNativeLayoutStyle>()
    private var wrap = false
    private var alignItems = "stretch"
    private var alignContent = "flex-start"
    private var justifyContent = "flex-start"
    private var rowGap = 0
    private var columnGap = 0
    private var grid = false
    private var gridColumns = 1
    private var gridAutoRows: CraftNativeLength? = null
    private var reverse = false

    fun configure(style: JSONObject, density: Float) {
        orientation = if (style.optString("flexDirection") in setOf("row", "row-reverse")) HORIZONTAL else VERTICAL
        reverse = style.optString("flexDirection").endsWith("-reverse")
        wrap = style.optString("flexWrap") == "wrap" || style.optBoolean("flexWrap", false)
        alignItems = style.optString("alignItems", "stretch")
        alignContent = style.optString("alignContent", "flex-start")
        justifyContent = style.optString("justifyContent", "flex-start")
        val gap = (style.optDouble("gap", 0.0) * density).toInt()
        rowGap = (style.optDouble("rowGap", gap.toDouble() / density.toDouble()) * density).toInt()
        columnGap = (style.optDouble("columnGap", gap.toDouble() / density.toDouble()) * density).toInt()
        grid = style.optString("display") == "grid"
        gridColumns = craftNativeGridColumnCount(
            if (style.has("gridTemplateColumns")) style.opt("gridTemplateColumns") else style.opt("gridColumns")
        )
        gridAutoRows = CraftNativeLength.from(style.opt("gridAutoRows"), density)
        val padding = (style.optDouble("padding", 0.0) * density).toInt()
        val horizontal = (style.optDouble("paddingHorizontal", padding.toDouble() / density.toDouble()) * density).toInt()
        val vertical = (style.optDouble("paddingVertical", padding.toDouble() / density.toDouble()) * density).toInt()
        setPadding(
            (style.optDouble("paddingLeft", horizontal.toDouble() / density.toDouble()) * density).toInt(),
            (style.optDouble("paddingTop", vertical.toDouble() / density.toDouble()) * density).toInt(),
            (style.optDouble("paddingRight", horizontal.toDouble() / density.toDouble()) * density).toInt(),
            (style.optDouble("paddingBottom", vertical.toDouble() / density.toDouble()) * density).toInt(),
        )
        requestLayout()
    }

    fun setChildStyle(view: View, style: JSONObject, density: Float) {
        styles[view] = CraftNativeLayoutStyle.from(style, density)
        requestLayout()
    }

    override fun onViewRemoved(child: View) {
        styles.remove(child)
        super.onViewRemoved(child)
    }

    private data class Entry(val view: View, val style: CraftNativeLayoutStyle, val width: Int, val height: Int)
    private data class Line(val entries: MutableList<Entry> = mutableListOf(), var main: Int = 0, var cross: Int = 0)
    private data class GridLayout(val rows: List<List<Entry>>, val absolute: List<Entry>, val cellWidth: Int, val rowHeights: List<Int>)

    private fun entries(width: Int, height: Int): Pair<List<Line>, List<Entry>> {
        val availableMain = if (orientation == HORIZONTAL) max(0, width - paddingLeft - paddingRight)
        else max(0, height - paddingTop - paddingBottom)
        val gap = if (orientation == HORIZONTAL) columnGap else rowGap
        val lines = mutableListOf<Line>()
        val absolute = mutableListOf<Entry>()
        val pending = mutableListOf<Entry>()
        for (index in 0 until childCount) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            if (child is CraftNativeModalView) {
                val modalWidth = max(0, width - paddingLeft - paddingRight)
                val modalHeight = max(0, height - paddingTop - paddingBottom)
                child.measure(
                    View.MeasureSpec.makeMeasureSpec(modalWidth, View.MeasureSpec.EXACTLY),
                    View.MeasureSpec.makeMeasureSpec(modalHeight, View.MeasureSpec.EXACTLY),
                )
                absolute += Entry(child, style, modalWidth, modalHeight)
                continue
            }
            val childWidth = measureChildWidth(child, style, width - paddingLeft - paddingRight, horizontalMargins)
            val childHeight = measureChildHeight(child, style, height - paddingTop - paddingBottom, verticalMargins)
            val entry = Entry(child, style, childWidth, childHeight)
            if (style.position == "absolute") { absolute += entry; continue }
            pending += entry
        }
        if (pending.isNotEmpty()) {
            val basis = pending.map { entry ->
                if (orientation == HORIZONTAL) entry.width.toFloat() else entry.height.toFloat()
            }.toFloatArray()
            val margins = pending.flatMap { entry ->
                val lp = entry.view.layoutParams as? MarginLayoutParams
                if (orientation == HORIZONTAL) listOf((lp?.leftMargin ?: 0).toFloat(), (lp?.rightMargin ?: 0).toFloat())
                else listOf((lp?.topMargin ?: 0).toFloat(), (lp?.bottomMargin ?: 0).toFloat())
            }.toFloatArray()
            val sharedLineIds = CraftNative.flexLines(availableMain.toFloat(), gap.toFloat(), wrap, basis, margins)
            val lineIds = sharedLineIds?.takeIf { ids ->
                ids.size >= pending.size && ids.firstOrNull() == 0 &&
                    ids.indices.drop(1).all { index -> ids[index] >= ids[index - 1] }
            }
            var line = Line()
            pending.forEachIndexed { index, entry ->
                val childMain = if (orientation == HORIZONTAL) entry.width + (margins[index * 2] + margins[index * 2 + 1]).roundToInt()
                else entry.height + (margins[index * 2] + margins[index * 2 + 1]).roundToInt()
                val lp = entry.view.layoutParams as? MarginLayoutParams
                val crossMargins = if (orientation == HORIZONTAL) (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                else (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                val childCross = if (orientation == HORIZONTAL) entry.height + crossMargins else entry.width + crossMargins
                if (index > 0 && lineIds != null && lineIds[index] != lineIds[index - 1]) {
                    lines += line
                    line = Line()
                } else if (index > 0 && lineIds == null && wrap && line.entries.isNotEmpty() && line.main + gap + childMain > availableMain) {
                    lines += line
                    line = Line()
                }
                line.entries += entry
                line.main = if (line.entries.size == 1) childMain else line.main + gap + childMain
                line.cross = max(line.cross, childCross)
            }
            if (line.entries.isNotEmpty()) lines += line
        }
        return lines to absolute
    }

    private fun gridLayout(width: Int, height: Int): GridLayout {
        val availableWidth = max(0, width - paddingLeft - paddingRight)
        val gap = columnGap
        val cellWidth = max(0, (availableWidth - max(0, gridColumns - 1) * gap) / max(1, gridColumns))
        val rows = mutableListOf<MutableList<Entry>>()
        val absolute = mutableListOf<Entry>()
        for (index in 0 until childCount) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            if (child is CraftNativeModalView) {
                val modalWidth = max(0, width - paddingLeft - paddingRight)
                val modalHeight = max(0, height - paddingTop - paddingBottom)
                child.measure(
                    View.MeasureSpec.makeMeasureSpec(modalWidth, View.MeasureSpec.EXACTLY),
                    View.MeasureSpec.makeMeasureSpec(modalHeight, View.MeasureSpec.EXACTLY),
                )
                absolute += Entry(child, style, modalWidth, modalHeight)
                continue
            }
            val childWidth = measureChildWidth(child, style, cellWidth, horizontalMargins)
            val childHeight = measureChildHeight(child, style, height - paddingTop - paddingBottom, verticalMargins)
            val entry = Entry(child, style, childWidth, childHeight)
            if (style.position == "absolute") absolute += entry
            else {
                if (rows.isEmpty() || rows.last().size == gridColumns) rows.add(mutableListOf())
                rows.last() += entry
            }
        }
        val rowHeights = rows.map { row ->
            max(gridAutoRows?.resolve(height - paddingTop - paddingBottom) ?: 0, row.maxOfOrNull { entry ->
                val lp = entry.view.layoutParams as? MarginLayoutParams
                entry.height + (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            } ?: 0)
        }
        return GridLayout(rows, absolute, cellWidth, rowHeights)
    }

    private fun gridIntrinsicSize(height: Int): Pair<Int, Int> {
        val columns = max(1, gridColumns)
        val columnWidths = IntArray(columns)
        val rowHeights = mutableListOf<Int>()
        var flowIndex = 0
        for (index in 0 until childCount) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            if (style.position == "absolute" || child is CraftNativeModalView) continue
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            val childWidth = measureChildWidth(child, style, 1_000_000, horizontalMargins)
            val childHeight = measureChildHeight(child, style, height, verticalMargins)
            val column = flowIndex % columns
            val row = flowIndex / columns
            while (rowHeights.size <= row) rowHeights += gridAutoRows?.resolve(null) ?: 0
            columnWidths[column] = max(columnWidths[column], childWidth + horizontalMargins)
            rowHeights[row] = max(rowHeights[row], childHeight + verticalMargins)
            flowIndex += 1
        }
        val cellWidth = columnWidths.maxOrNull() ?: 0
        val width = paddingLeft + paddingRight + cellWidth * columns + max(0, columns - 1) * columnGap
        val rowGapTotal = max(0, rowHeights.size - 1) * rowGap
        val measuredHeight = paddingTop + paddingBottom + rowHeights.sum() + rowGapTotal
        return width to measuredHeight
    }

    private fun measureChildWidth(child: View, style: CraftNativeLayoutStyle, available: Int, margins: Int): Int {
        val base = max(0, available - margins)
        val flexBasis = if (orientation == HORIZONTAL) style.flexBasis?.resolve(base) else null
        // The STX style is authoritative. A reused View may still carry a
        // previous fixed LayoutParams width after a reactive width is removed;
        // using that value here prevents intrinsic sizing from being restored.
        val explicit = style.width?.resolve(base) ?: flexBasis
        if (explicit != null) {
            child.measure(
                View.MeasureSpec.makeMeasureSpec(explicit, View.MeasureSpec.EXACTLY),
                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
            )
            return clamp(explicit, style.minWidth?.resolve(base), style.maxWidth?.resolve(base))
        }
        // Measure text and nested flex containers at max-content first. An
        // AT_MOST spec equal to the available room can make Android report the
        // longest-word (min-content) width for a wrapping TextView, collapsing
        // shrink-to-fit bubbles and pills before the parent can clamp them.
        val intrinsicSpec = if (child is TextView && child !is EditText) 1_000_000 else base
        child.measure(
            View.MeasureSpec.makeMeasureSpec(intrinsicSpec, View.MeasureSpec.AT_MOST),
            View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
        )
        val target = clamp(min(base, child.measuredWidth), style.minWidth?.resolve(base), style.maxWidth?.resolve(base))
        child.measure(
            View.MeasureSpec.makeMeasureSpec(target, View.MeasureSpec.AT_MOST),
            View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
        )
        return target
    }

    private fun measureChildHeight(child: View, style: CraftNativeLayoutStyle, available: Int, margins: Int): Int {
        val base = max(0, available - margins)
        val flexBasis = if (orientation == VERTICAL) style.flexBasis?.resolve(base) else null
        // Match width measurement: do not let stale native LayoutParams keep
        // a removed reactive height fixed.
        val explicit = style.height?.resolve(base) ?: flexBasis
        val target = explicit ?: base
        val spec = if (explicit != null) View.MeasureSpec.makeMeasureSpec(target, View.MeasureSpec.EXACTLY)
        else View.MeasureSpec.makeMeasureSpec(base, View.MeasureSpec.AT_MOST)
        child.measure(child.measuredWidth.let { View.MeasureSpec.makeMeasureSpec(max(0, it), View.MeasureSpec.EXACTLY) }, spec)
        return clamp(if (explicit != null) target else child.measuredHeight, style.minHeight?.resolve(base), style.maxHeight?.resolve(base))
    }

    private fun clamp(value: Int, lower: Int?, upper: Int?): Int {
        var result = value
        if (lower != null) result = max(result, lower)
        if (upper != null) result = min(result, upper)
        return result
    }

    private fun defaultFlexShrink(view: View): Double = when {
        view is ScrollView || view is HorizontalScrollView -> 1.0
        view is TextView && view !is Button && view !is EditText && orientation == HORIZONTAL -> 1.0
        else -> 0.0
    }

    private fun justifyCode(): Int = when (justifyContent) {
        "center" -> 1
        "flex-end" -> 2
        "space-between" -> 3
        "space-around" -> 4
        "space-evenly" -> 5
        else -> 0
    }

    private fun alignContentCode(): Int = when (alignContent) {
        "center" -> 1
        "flex-end" -> 2
        "space-between" -> 3
        "space-around" -> 4
        "stretch" -> 5
        else -> 0
    }

    /** Keep the old-runtime shim on the same bounded-flex water-fill rule as the Zig bridge. */
    private fun fallbackFlexWidths(line: Line, available: Int, gap: Int): IntArray {
        val horizontal = orientation == HORIZONTAL
        val hypothetical = line.entries.sumOf { entry ->
            val lp = entry.view.layoutParams as? MarginLayoutParams
            val margins = if (horizontal) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            (if (horizontal) entry.width else entry.height) + margins
        } + max(0, line.entries.size - 1) * gap
        val free = available - hypothetical
        val growTotal = line.entries.sumOf { it.style.flexGrow }
        val shrinkTotal = line.entries.sumOf {
            (it.style.flexShrink ?: defaultFlexShrink(it.view)) * (if (horizontal) it.width else it.height)
        }
        val growing = free > 0 && growTotal > 0
        val shrinking = free < 0 && shrinkTotal > 0
        val widths = IntArray(line.entries.size) { index -> if (horizontal) line.entries[index].width else line.entries[index].height }
        if (!growing && !shrinking) return widths

        val frozen = BooleanArray(widths.size)
        repeat(widths.size + 1) {
            var fixed = max(0, widths.size - 1) * gap.toDouble()
            var activeBasis = 0.0
            var factor = 0.0
            for ((index, entry) in line.entries.withIndex()) {
                val lp = entry.view.layoutParams as? MarginLayoutParams
                val margins = if (horizontal) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                fixed += margins
                if (frozen[index]) fixed += widths[index]
                else {
                    val basis = if (horizontal) entry.width else entry.height
                    activeBasis += basis
                    factor += if (growing) entry.style.flexGrow
                    else (entry.style.flexShrink ?: defaultFlexShrink(entry.view)) * basis
                }
            }
            if (factor <= 0) return@repeat
            val remaining = available - fixed - activeBasis
            var froze = false
            for ((index, entry) in line.entries.withIndex()) {
                if (frozen[index]) continue
                val basis = (if (horizontal) entry.width else entry.height).toDouble()
                val share = if (growing) remaining * entry.style.flexGrow / factor
                else -remaining * (entry.style.flexShrink ?: defaultFlexShrink(entry.view)) * basis / factor
                val raw = if (growing) basis + share else basis - share
                val lower = (if (horizontal) entry.style.minWidth else entry.style.minHeight)?.resolve(if (horizontal) width - paddingLeft - paddingRight else height - paddingTop - paddingBottom)
                val upper = (if (horizontal) entry.style.maxWidth else entry.style.maxHeight)?.resolve(if (horizontal) width - paddingLeft - paddingRight else height - paddingTop - paddingBottom)
                var bounded = raw
                if (lower != null) bounded = max(bounded, lower.toDouble())
                if (upper != null) bounded = min(bounded, upper.toDouble())
                widths[index] = bounded.roundToInt().coerceAtLeast(0)
                if (bounded != raw) {
                    frozen[index] = true
                    froze = true
                }
            }
            if (!froze) return@repeat
        }
        return widths
    }

    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val widthMode = View.MeasureSpec.getMode(widthMeasureSpec)
        val width = View.MeasureSpec.getSize(widthMeasureSpec).takeUnless { widthMode == View.MeasureSpec.UNSPECIFIED } ?: 1_000_000
        val height = View.MeasureSpec.getSize(heightMeasureSpec).takeUnless { View.MeasureSpec.getMode(heightMeasureSpec) == View.MeasureSpec.UNSPECIFIED } ?: 1_000_000
        if (grid) {
            if (widthMode == View.MeasureSpec.UNSPECIFIED) {
                val (intrinsicWidth, intrinsicHeight) = gridIntrinsicSize(height)
                setMeasuredDimension(
                    resolveSize(intrinsicWidth, widthMeasureSpec),
                    resolveSize(intrinsicHeight, heightMeasureSpec),
                )
                return
            }
            val layout = gridLayout(width, height)
            val desiredWidth = paddingLeft + paddingRight + layout.cellWidth * gridColumns + max(0, gridColumns - 1) * columnGap
            val desiredHeight = paddingTop + paddingBottom + layout.rowHeights.sum() + max(0, layout.rowHeights.size - 1) * rowGap
            setMeasuredDimension(resolveSize(desiredWidth, widthMeasureSpec), resolveSize(desiredHeight, heightMeasureSpec))
            return
        }
        val (lines, absolute) = entries(width, height)
        val main = lines.maxOfOrNull { it.main } ?: 0
        val cross = lines.sumOf { it.cross } + max(0, lines.size - 1) * (if (orientation == HORIZONTAL) rowGap else columnGap)
        val desiredWidth = if (orientation == HORIZONTAL) main else cross
        val desiredHeight = if (orientation == HORIZONTAL) cross else main
        val absWidth = absolute.maxOfOrNull { it.width } ?: 0
        val absHeight = absolute.maxOfOrNull { it.height } ?: 0
        setMeasuredDimension(
            resolveSize(max(desiredWidth + paddingLeft + paddingRight, absWidth + paddingLeft + paddingRight), widthMeasureSpec),
            resolveSize(max(desiredHeight + paddingTop + paddingBottom, absHeight + paddingTop + paddingBottom), heightMeasureSpec),
        )
    }

    override fun onLayout(changed: Boolean, left: Int, top: Int, right: Int, bottom: Int) {
        if (grid) {
            val layout = gridLayout(width, height)
            val contentWidth = width - paddingLeft - paddingRight
            val contentHeight = height - paddingTop - paddingBottom
            val flow = layout.rows.flatten()
            // Older runtimes return null for the optional symbol; the local
            // layout below remains the compatibility path in that case.
            val sharedFrames = CraftNative.grid(
                contentWidth.toFloat(), contentHeight.toFloat(), gridColumns, columnGap.toFloat(), rowGap.toFloat(),
                flow.map { it.width.toFloat() }.toFloatArray(), flow.map { it.height.toFloat() }.toFloatArray(),
                flow.map { it.style.width?.resolve(layout.cellWidth)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.height?.resolve(null)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.minWidth?.resolve(layout.cellWidth)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.maxWidth?.resolve(layout.cellWidth)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.minHeight?.resolve(null)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.maxHeight?.resolve(null)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.flatMap {
                    val lp = it.view.layoutParams as? MarginLayoutParams
                    listOf((lp?.leftMargin ?: 0).toFloat(), (lp?.rightMargin ?: 0).toFloat(), (lp?.topMargin ?: 0).toFloat(), (lp?.bottomMargin ?: 0).toFloat())
                }.toFloatArray(),
                flow.flatMap {
                    val align = it.style.alignSelf ?: alignItems
                    listOf(if (align == "stretch") 1f else 0f, if (align == "center") 1f else if (align == "flex-end") 2f else 0f)
                }.toFloatArray(),
                gridAutoRows?.resolve(contentHeight)?.toFloat(),
            )
            if (sharedFrames != null) {
                for ((index, entry) in flow.withIndex()) {
                    val offset = index * 4
                    val x = paddingLeft + sharedFrames[offset].roundToInt()
                    val y = paddingTop + sharedFrames[offset + 1].roundToInt()
                    val childWidth = sharedFrames[offset + 2].roundToInt()
                    val childHeight = sharedFrames[offset + 3].roundToInt()
                    entry.view.layout(x, y, x + childWidth, y + childHeight)
                }
            } else {
                var rowTop = paddingTop
                for ((rowIndex, row) in layout.rows.withIndex()) {
                    val rowHeight = layout.rowHeights[rowIndex]
                    for ((column, entry) in row.withIndex()) {
                        val align = entry.style.alignSelf ?: alignItems
                        val lp = entry.view.layoutParams as? MarginLayoutParams
                        val marginLeft = lp?.leftMargin ?: 0
                        val marginRight = lp?.rightMargin ?: 0
                        val marginTop = lp?.topMargin ?: 0
                        val marginBottom = lp?.bottomMargin ?: 0
                        val availableWidth = max(0, layout.cellWidth - marginLeft - marginRight)
                        val availableHeight = max(0, rowHeight - marginTop - marginBottom)
                        val childWidth = if (align == "stretch" && entry.style.width == null) availableWidth else min(availableWidth, entry.width)
                        val childHeight = if (align == "stretch" && entry.style.height == null) availableHeight else min(availableHeight, entry.height)
                        val x = paddingLeft + column * (layout.cellWidth + columnGap) + marginLeft + when (align) {
                            "center" -> (availableWidth - childWidth) / 2
                            "flex-end" -> availableWidth - childWidth
                            else -> 0
                        }
                        val y = rowTop + marginTop + when (align) {
                            "center" -> (availableHeight - childHeight) / 2
                            "flex-end" -> availableHeight - childHeight
                            else -> 0
                        }
                        entry.view.layout(x, y, x + childWidth, y + childHeight)
                    }
                    rowTop += rowHeight + rowGap
                }
            }
            for (entry in layout.absolute) {
                if (entry.view is CraftNativeModalView && entry.view.visibility == View.VISIBLE) entry.view.bringToFront()
                val childWidth = if (entry.style.left != null && entry.style.right != null) contentWidth - entry.style.left!! - entry.style.right!! else entry.width
                val childHeight = if (entry.style.top != null && entry.style.bottom != null) contentHeight - entry.style.top!! - entry.style.bottom!! else entry.height
                val x = paddingLeft + (entry.style.left ?: (entry.style.right?.let { contentWidth - it - childWidth } ?: 0))
                val y = paddingTop + (entry.style.top ?: (entry.style.bottom?.let { contentHeight - it - childHeight } ?: 0))
                entry.view.layout(x, y, x + max(0, childWidth), y + max(0, childHeight))
            }
            onLayoutChanged?.invoke()
            return
        }
        val contentWidth = width - paddingLeft - paddingRight
        val contentHeight = height - paddingTop - paddingBottom
        val (lines, absolute) = entries(width, height)
        val gap = if (orientation == HORIZONTAL) columnGap else rowGap
        val crossGap = if (orientation == HORIZONTAL) rowGap else columnGap
        val availableMain = if (orientation == HORIZONTAL) contentWidth else contentHeight
        val availableCross = if (orientation == HORIZONTAL) contentHeight else contentWidth
        val totalCross = lines.sumOf { it.cross } + max(0, lines.size - 1) * crossGap
        val crossFree = max(0, availableCross - totalCross)
        var crossLeading = 0
        var crossBetween = crossGap
        val sharedCross = if (wrap && lines.size > 1) {
            CraftNative.flexLineDistribution(
                availableCross.toFloat(), crossGap.toFloat(), alignContentCode(), lines.map { it.cross.toFloat() }.toFloatArray()
            )
        } else null
        sharedCross?.second?.forEachIndexed { index, size -> lines[index].cross = size.roundToInt() }
        if (wrap && lines.size > 1) {
            if (sharedCross == null) when (alignContent) {
                "center" -> crossLeading = crossFree / 2
                "flex-end" -> crossLeading = crossFree
                "space-between" -> crossBetween = crossFree / (lines.size - 1) + crossGap
                "space-around" -> {
                    crossBetween = crossFree / lines.size + crossGap
                    crossLeading = crossFree / (lines.size * 2)
                }
                "stretch" -> {
                    val extra = crossFree / lines.size
                    lines.forEach { it.cross += extra }
                }
            }
        }
        var crossOffset = (if (orientation == HORIZONTAL) paddingTop else paddingLeft) + crossLeading
        for ((lineIndex, line) in lines.withIndex()) {
            val lineOffset = sharedCross?.first?.get(lineIndex)?.roundToInt()?.let { (if (orientation == HORIZONTAL) paddingTop else paddingLeft) + it } ?: crossOffset
            val fallbackWidths = fallbackFlexWidths(line, availableMain, gap)
            val sharedPrimary = CraftNative.flexRow(
                availableMain.toFloat(),
                gap.toFloat(),
                justifyCode(),
                line.entries.map { entry -> if (orientation == HORIZONTAL) entry.width.toFloat() else entry.height.toFloat() }.toFloatArray(),
                line.entries.map { it.style.flexGrow.toFloat() }.toFloatArray(),
                line.entries.map { (it.style.flexShrink ?: defaultFlexShrink(it.view)).toFloat() }.toFloatArray(),
                line.entries.map {
                    (if (orientation == HORIZONTAL) it.style.minWidth?.resolve(contentWidth) else it.style.minHeight?.resolve(contentHeight))?.toFloat()
                        ?: Float.NaN
                }.toFloatArray(),
                line.entries.map {
                    (if (orientation == HORIZONTAL) it.style.maxWidth?.resolve(contentWidth) else it.style.maxHeight?.resolve(contentHeight))?.toFloat()
                        ?: Float.NaN
                }.toFloatArray(),
                line.entries.flatMap { entry ->
                    val lp = entry.view.layoutParams as? MarginLayoutParams
                    if (orientation == HORIZONTAL) listOf((lp?.leftMargin ?: 0).toFloat(), (lp?.rightMargin ?: 0).toFloat())
                    else listOf((lp?.topMargin ?: 0).toFloat(), (lp?.bottomMargin ?: 0).toFloat())
                }.toFloatArray(),
            )
            val sharedPositions = sharedPrimary?.takeIf { it.size == line.entries.size * 2 }
            val distributedMain = if (sharedPrimary != null) {
                line.entries.indices.sumOf { index ->
                    val lp = line.entries[index].view.layoutParams as? MarginLayoutParams
                    val margins = if (orientation == HORIZONTAL) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                    else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                    sharedPrimary[index].roundToInt() + margins
                } + max(0, line.entries.size - 1) * gap
            } else {
                line.entries.indices.sumOf { index ->
                    val constrained = fallbackWidths[index]
                    val lp = line.entries[index].view.layoutParams as? MarginLayoutParams
                    val margins = if (orientation == HORIZONTAL) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                        else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                    constrained + margins
                } + max(0, line.entries.size - 1) * gap
            }
            val free = max(0, availableMain - distributedMain)
            val (leading, between) = distribution(free, line.entries.size)
            var mainOffset = if (orientation == HORIZONTAL) paddingLeft else paddingTop
            mainOffset += leading
            for ((index, entry) in line.entries.withIndex()) {
                val lp = entry.view.layoutParams as? MarginLayoutParams
                val marginStart = if (orientation == HORIZONTAL) lp?.leftMargin ?: 0 else lp?.topMargin ?: 0
                val marginEnd = if (orientation == HORIZONTAL) lp?.rightMargin ?: 0 else lp?.bottomMargin ?: 0
                val crossSize = if ((entry.style.alignSelf ?: alignItems) == "stretch" && (if (orientation == HORIZONTAL) entry.style.height else entry.style.width) == null)
                    max(0, line.cross - (if (orientation == HORIZONTAL) (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0) else (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)))
                else if (orientation == HORIZONTAL) entry.height else entry.width
                val align = entry.style.alignSelf ?: alignItems
                val crossLeading = if (orientation == HORIZONTAL) lp?.topMargin ?: 0 else lp?.leftMargin ?: 0
                val crossTrailing = if (orientation == HORIZONTAL) lp?.bottomMargin ?: 0 else lp?.rightMargin ?: 0
                val alignment = when (align) {
                    "center" -> 1
                    "flex-end" -> 2
                    else -> 0
                }
                val crossPosition = CraftNative.crossAxisPosition(
                    line.cross.toFloat(), crossSize.toFloat(), crossLeading.toFloat(), crossTrailing.toFloat(), alignment
                )?.roundToInt() ?: when (alignment) {
                    1 -> crossLeading + (line.cross - crossLeading - crossTrailing - crossSize) / 2
                    2 -> line.cross - crossTrailing - crossSize
                    else -> crossLeading
                }
                // Shared positions cover every non-reverse justification; the
                // local main-axis rule remains the fallback for old runtimes
                // that return widths only.
                val sharedPosition = if (!reverse) sharedPositions?.get(index)?.roundToInt() else null
                val positionedMain = sharedPosition?.let { (if (orientation == HORIZONTAL) paddingLeft else paddingTop) + it }
                    ?: mainOffset + marginStart
                val x = if (orientation == HORIZONTAL) positionedMain else lineOffset + crossPosition
                val y = if (orientation == HORIZONTAL) lineOffset + crossPosition else positionedMain
                val distributedPrimary = sharedPrimary?.get(index)?.roundToInt() ?: fallbackWidths[index]
                val w = if (orientation == HORIZONTAL) distributedPrimary else crossSize
                val h = if (orientation == HORIZONTAL) crossSize else distributedPrimary
                entry.view.layout(x, y, x + w, y + h)
                if (sharedPosition == null) mainOffset += distributedPrimary + marginStart + marginEnd + gap + between
            }
            if (sharedCross == null) crossOffset += line.cross + crossBetween
        }
        for (entry in absolute) {
            if (entry.view is CraftNativeModalView && entry.view.visibility == View.VISIBLE) entry.view.bringToFront()
            val widthValue = if (entry.style.left != null && entry.style.right != null) contentWidth - entry.style.left!! - entry.style.right!! else entry.width
            val heightValue = if (entry.style.top != null && entry.style.bottom != null) contentHeight - entry.style.top!! - entry.style.bottom!! else entry.height
            val x = paddingLeft + (entry.style.left ?: (entry.style.right?.let { contentWidth - it - widthValue } ?: 0))
            val y = paddingTop + (entry.style.top ?: (entry.style.bottom?.let { contentHeight - it - heightValue } ?: 0))
            entry.view.layout(x, y, x + max(0, widthValue), y + max(0, heightValue))
        }
        onLayoutChanged?.invoke()
    }

    private fun distribution(free: Int, count: Int): Pair<Int, Int> = when (justifyContent) {
        "center" -> free / 2 to 0
        "flex-end" -> free to 0
        "space-between" -> 0 to if (count > 1) free / (count - 1) else 0
        "space-around" -> free / (count * 2) to free / count
        "space-evenly" -> free / (count + 1) to free / (count + 1)
        else -> 0 to 0
    }
}

private class CraftNativeScrollView(context: Context) : SwipeRefreshLayout(context) {
    val content = CraftNativeFlexLayout(context)
    private val vertical = ScrollView(context)
    private val horizontal = HorizontalScrollView(context)
    private var horizontalMode: Boolean? = null
    private var pagingEnabled = false
    private var bounces = true
    private var alwaysBounceVertical = true
    private var alwaysBounceHorizontal = true
    private var keyboardShouldPersistTaps = "never"
    private var refreshHandler: (() -> Unit)? = null

    init {
        vertical.isNestedScrollingEnabled = true
        horizontal.isNestedScrollingEnabled = true
        vertical.isFillViewport = true
        horizontal.isFillViewport = true
        setOnRefreshListener { refreshHandler?.invoke() }
        isEnabled = false
        setHorizontal(false)
    }

    fun setRefreshHandler(handler: (() -> Unit)?, refreshing: Boolean) {
        refreshHandler = handler
        isEnabled = handler != null
        isRefreshing = handler != null && refreshing
        if (handler == null) isRefreshing = false
    }

    override fun onDetachedFromWindow() {
        refreshHandler = null
        isRefreshing = false
        super.onDetachedFromWindow()
    }

    fun setHorizontal(value: Boolean) {
        if (horizontalMode == value) return
        horizontalMode = value
        (content.parent as? ViewGroup)?.removeView(content)
        removeAllViews()
        val scroller: ViewGroup = if (value) horizontal else vertical
        scroller.removeAllViews()
        content.orientation = if (value) LinearLayout.HORIZONTAL else LinearLayout.VERTICAL
        scroller.addView(content, if (value)
            ViewGroup.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.MATCH_PARENT)
        else ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
        addView(scroller, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
    }

    /**
     * A targeted mutation can change a child's size without reconciling the
     * scroll content tree. Invalidate both the custom content layout and the
     * platform scroller so its measured content range is recomputed too.
     */
    fun invalidateContentLayout() {
        content.forceLayout()
        content.requestLayout()
        val scroller = if (horizontalMode == true) horizontal else vertical
        scroller.forceLayout()
        scroller.requestLayout()
        forceLayout()
        requestLayout()
    }

    fun setNativeNestedScrollingEnabled(value: Boolean) {
        vertical.isNestedScrollingEnabled = value
        horizontal.isNestedScrollingEnabled = value
    }

    fun setScrollEnabled(value: Boolean) {
        vertical.isEnabled = value
        horizontal.isEnabled = value
    }

    fun setKeyboardShouldPersistTaps(value: String?) {
        keyboardShouldPersistTaps = value?.takeIf { it in setOf("always", "handled", "never") } ?: "never"
    }

    fun setBounces(value: Boolean) {
        bounces = value
        applyBounceModes()
    }

    fun setAlwaysBounce(vertical: Boolean, horizontal: Boolean) {
        alwaysBounceVertical = vertical
        alwaysBounceHorizontal = horizontal
        applyBounceModes()
    }

    private fun applyBounceModes() {
        vertical.overScrollMode = if (bounces && alwaysBounceVertical) View.OVER_SCROLL_ALWAYS else View.OVER_SCROLL_NEVER
        horizontal.overScrollMode = if (bounces && alwaysBounceHorizontal) View.OVER_SCROLL_ALWAYS else View.OVER_SCROLL_NEVER
    }

    private fun tapTarget(view: View, x: Float, y: Float): View? {
        if (x < 0 || y < 0 || x >= view.width || y >= view.height || view.visibility != View.VISIBLE) return null
        if (view is ViewGroup) {
            for (index in view.childCount - 1 downTo 0) {
                val child = view.getChildAt(index)
                tapTarget(child, x - child.left, y - child.top)?.let { return it }
            }
        }
        return view
    }

    private fun shouldDismissKeyboard(scroller: View, event: android.view.MotionEvent): Boolean {
        if (keyboardShouldPersistTaps == "always") return false
        return when (keyboardShouldPersistTaps) {
            "handled" -> (scroller as? ViewGroup)?.let { tapTarget(it, event.x, event.y)?.isClickable != true } ?: true
            else -> true
        }
    }

    fun setPagingEnabled(value: Boolean) {
        pagingEnabled = value
    }

    private fun snapToPage(scroller: View) {
        val horizontal = horizontalMode == true
        val pageSize = if (horizontal) scroller.width else scroller.height
        if (pageSize <= 0) return
        val offset = if (horizontal) scroller.scrollX else scroller.scrollY
        val target = (offset.toFloat() / pageSize).roundToInt() * pageSize
        if (horizontal) {
            (scroller as HorizontalScrollView).smoothScrollTo(target, 0)
        } else {
            (scroller as ScrollView).smoothScrollTo(0, target)
        }
    }

    fun setScrollIndicators(verticalVisible: Boolean, horizontalVisible: Boolean) {
        vertical.isVerticalScrollBarEnabled = verticalVisible
        horizontal.isHorizontalScrollBarEnabled = horizontalVisible
    }

    fun setScrollListeners(
        onScroll: ((Int, Int) -> Unit)?,
        onBeginDrag: (() -> Unit)?,
        onEndDrag: (() -> Unit)?,
        onMomentumBegin: (() -> Unit)?,
        onMomentumEnd: (() -> Unit)?,
        keyboardDismissMode: String,
        dismissKeyboard: (() -> Unit)?,
    ) {
        fun attach(scroller: View) {
            var dismissed = false
            var moved = false
            var momentumActive = false
            var lastX = 0
            var lastY = 0

            fun pollMomentum() {
                if (!momentumActive) return
                val x = scroller.scrollX
                val y = scroller.scrollY
                if (x == lastX && y == lastY) {
                    momentumActive = false
                    onMomentumEnd?.invoke()
                } else {
                    lastX = x
                    lastY = y
                    scroller.postDelayed({ pollMomentum() }, 16L)
                }
            }

            scroller.setOnScrollChangeListener { _, x, y, _, _ -> onScroll?.invoke(x, y) }
            scroller.setOnTouchListener { _, event ->
                when (event.actionMasked) {
                    android.view.MotionEvent.ACTION_DOWN -> {
                        if (momentumActive) {
                            momentumActive = false
                            onMomentumEnd?.invoke()
                        }
                        dismissed = false
                        moved = false
                        onBeginDrag?.invoke()
                    }
                    android.view.MotionEvent.ACTION_MOVE -> {
                        moved = true
                        if (!dismissed && keyboardDismissMode in setOf("on-drag", "interactive")) {
                            dismissed = true
                            dismissKeyboard?.invoke()
                        }
                    }
                    android.view.MotionEvent.ACTION_UP, android.view.MotionEvent.ACTION_CANCEL -> {
                        if (event.actionMasked == android.view.MotionEvent.ACTION_UP && shouldDismissKeyboard(scroller, event)) {
                            dismissKeyboard?.invoke()
                        }
                        onEndDrag?.invoke()
                        if (pagingEnabled) snapToPage(scroller)
                        if (moved && !momentumActive) {
                            momentumActive = true
                            lastX = scroller.scrollX
                            lastY = scroller.scrollY
                            onMomentumBegin?.invoke()
                            scroller.postDelayed({ pollMomentum() }, 16L)
                        }
                    }
                }
                false
            }
        }
        attach(vertical)
        attach(horizontal)
    }
}

private class CraftNativeFlexSpacer(context: Context) : View(context)

private class CraftNativeModalView(context: Context) : FrameLayout(context) {
    val content = CraftNativeFlexLayout(context)
    private val blocker = View(context)
    private var renderedVisible = false
    private var dismissSuppressedByRequest = false
    private var animationGeneration = 0
    var onRequestClose: (() -> Unit)? = null

    var transparent: Boolean = false
        set(value) {
            field = value
            blocker.setBackgroundColor(if (value) Color.TRANSPARENT else Color.argb(82, 0, 0, 0))
        }

    init {
        isClickable = true
        blocker.isClickable = true
        blocker.setOnTouchListener { _, event ->
            if (event.action == MotionEvent.ACTION_UP) requestClose()
            true
        }
        blocker.setBackgroundColor(Color.argb(82, 0, 0, 0))
        addView(blocker, LayoutParams(-1, -1))
        addView(content, LayoutParams(-1, -1))
    }

    fun requestClose() {
        val handler = onRequestClose ?: return
        dismissSuppressedByRequest = true
        isClickable = false
        blocker.isEnabled = false
        handler()
    }

    fun consumeDismissSuppression(): Boolean {
        val suppressed = dismissSuppressedByRequest
        dismissSuppressedByRequest = false
        return suppressed
    }

    fun clearDismissSuppression() {
        dismissSuppressedByRequest = false
    }

    fun setVisible(visible: Boolean, opacity: Float, animationType: String?) {
        if (visible) {
            isClickable = true
            blocker.isEnabled = true
        }
        if (renderedVisible == visible && visibility == if (visible) View.VISIBLE else View.GONE) {
            if (visible && alpha != opacity) alpha = opacity
            return
        }
        val wasVisible = renderedVisible && visibility == View.VISIBLE
        renderedVisible = visible
        animationGeneration += 1
        val generation = animationGeneration
        animate().cancel()
        if (!visible) {
            if (animationType == "slide" && wasVisible) {
                val distance = max(height, (parent as? View)?.height ?: resources.displayMetrics.heightPixels).toFloat()
                animate().translationY(distance).alpha(0f).setDuration(240L).withEndAction {
                    if (animationGeneration != generation) return@withEndAction
                    visibility = View.GONE
                    translationY = 0f
                    alpha = 0f
                }.start()
            } else {
                alpha = 0f
                translationY = 0f
                visibility = View.GONE
            }
            return
        }
        visibility = View.VISIBLE
        if (animationType == "none") {
            translationY = 0f
            alpha = opacity
        } else if (animationType == "slide") {
            alpha = opacity
            translationY = max(height, (parent as? View)?.height ?: resources.displayMetrics.heightPixels).toFloat()
            post {
                if (animationGeneration != generation || visibility != View.VISIBLE) return@post
                val distance = max(height, (parent as? View)?.height ?: resources.displayMetrics.heightPixels).toFloat()
                translationY = distance
                animate().translationY(0f).setDuration(240L).start()
            }
        } else {
            translationY = 0f
            alpha = 0f
            animate().alpha(opacity).setDuration(180L).start()
        }
    }

    fun resetForTeardown() {
        animationGeneration += 1
        animate().cancel()
        visibility = View.GONE
        translationY = 0f
        alpha = 0f
        isClickable = true
        blocker.isEnabled = true
        dismissSuppressedByRequest = false
        onRequestClose = null
    }
}

private data class LayoutBounds(
    val x: Double,
    val y: Double,
    val width: Double,
    val height: Double,
)

/**
 * Android's default spinner style is indeterminate-only, so assigning
 * `isIndeterminate = false` to it is silently ignored. Use a determinate
 * ProgressBar style and carry over the platform spinner drawable instead;
 * that preserves the native look while allowing `animating={false}` to be a
 * genuinely stopped control.
 */
private class CraftNativeActivityIndicator(context: Context) :
    android.widget.ProgressBar(context, null, android.R.attr.progressBarStyleHorizontal) {
    init {
        val spinner = android.widget.ProgressBar(context).indeterminateDrawable
        indeterminateDrawable = spinner
        progressDrawable = spinner?.constantState?.newDrawable()?.mutate() ?: spinner
    }
}

/** Android counterpart to iOS's UIDatePicker-backed native DatePicker. */
private class CraftNativeDatePickerView(context: Context) : FrameLayout(context) {
    private enum class PickerMode { DATE, TIME, DATE_TIME, COUNTDOWN }

    private var pickerMode: PickerMode? = null
    private var datePicker: DatePicker? = null
    private var timePicker: TimePicker? = null
    private var minuteInterval = 1
    private var suppressChanges = true
    var onValueChanged: (() -> Unit)? = null

    init {
        isFocusable = true
    }

    fun configure(props: JSONObject) {
        val requestedMode = when (props.optString("mode")) {
            "time" -> PickerMode.TIME
            "datetime", "dateAndTime", "datetime-local" -> PickerMode.DATE_TIME
            "countdown" -> PickerMode.COUNTDOWN
            else -> PickerMode.DATE
        }
        if (pickerMode != requestedMode) {
            pickerMode = requestedMode
            datePicker = null
            timePicker = null
            removeAllViews()
            val content = LinearLayout(context).apply {
                orientation = LinearLayout.VERTICAL
                gravity = Gravity.CENTER
            }
            if (requestedMode == PickerMode.DATE || requestedMode == PickerMode.DATE_TIME) {
                datePicker = DatePicker(context).also { picker ->
                    val today = Calendar.getInstance()
                    picker.init(today.get(Calendar.YEAR), today.get(Calendar.MONTH), today.get(Calendar.DAY_OF_MONTH)) { _, _, _, _ -> changed() }
                    content.addView(picker, LinearLayout.LayoutParams(
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                    ))
                }
            }
            if (requestedMode != PickerMode.DATE) {
                timePicker = TimePicker(context).also { picker ->
                    picker.setIs24HourView(true)
                    picker.setOnTimeChangedListener { _, _, _ -> changed() }
                    content.addView(picker, LinearLayout.LayoutParams(
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                    ))
                }
            }
            addView(content, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
        }

        suppressChanges = true
        minuteInterval = props.optInt("minuteInterval", 1).takeIf { it in 1..30 && 60 % it == 0 } ?: 1
        pickerDate(props.opt("minimumDate"))?.let { datePicker?.minDate = it.timeInMillis }
        pickerDate(props.opt("maximumDate"))?.let { datePicker?.maxDate = it.timeInMillis }
        pickerDate(props.opt("value"))?.let { applyDate(it) }
        val enabled = !props.optBoolean("disabled", false)
        isEnabled = enabled
        datePicker?.isEnabled = enabled
        timePicker?.isEnabled = enabled
        for (index in 0 until childCount) getChildAt(index).isEnabled = enabled
        suppressChanges = false
    }

    fun event(): JSONObject {
        val current = currentDate()
        val valueFormat = when (pickerMode) {
            PickerMode.DATE -> "yyyy-MM-dd"
            PickerMode.TIME -> "HH:mm"
            else -> "yyyy-MM-dd'T'HH:mm"
        }
        val value = SimpleDateFormat(valueFormat, Locale.US).apply { isLenient = false }.format(current.time)
        val iso = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSXXX", Locale.US).format(current.time)
        return JSONObject().put("value", value).put("iso", iso).put("timestamp", current.timeInMillis)
    }

    private fun changed() {
        if (suppressChanges) return
        val picker = timePicker ?: return
        val snapped = ((picker.minute + minuteInterval / 2) / minuteInterval * minuteInterval).coerceAtMost(59)
        if (snapped != picker.minute) {
            suppressChanges = true
            picker.minute = snapped
            suppressChanges = false
        }
        onValueChanged?.invoke()
    }

    private fun applyDate(value: Calendar) {
        datePicker?.updateDate(value.get(Calendar.YEAR), value.get(Calendar.MONTH), value.get(Calendar.DAY_OF_MONTH))
        timePicker?.hour = value.get(Calendar.HOUR_OF_DAY)
        timePicker?.minute = value.get(Calendar.MINUTE)
    }

    private fun currentDate(): Calendar = Calendar.getInstance().also { current ->
        datePicker?.let {
            current.set(Calendar.YEAR, it.year)
            current.set(Calendar.MONTH, it.month)
            current.set(Calendar.DAY_OF_MONTH, it.dayOfMonth)
        }
        timePicker?.let {
            current.set(Calendar.HOUR_OF_DAY, it.hour)
            current.set(Calendar.MINUTE, it.minute)
            current.set(Calendar.SECOND, 0)
            current.set(Calendar.MILLISECOND, 0)
        }
    }

    private fun pickerDate(value: Any?): Calendar? {
        if (value is Number && value !is Boolean) return Calendar.getInstance().apply { timeInMillis = value.toLong() }
        val text = value?.toString()?.trim().orEmpty()
        if (text.isBlank() || text == JSONObject.NULL.toString()) return null
        val formats = listOf(
            "HH:mm", "HH:mm:ss", "yyyy-MM-dd", "yyyy-MM-dd'T'HH:mm",
            "yyyy-MM-dd'T'HH:mm:ss", "yyyy-MM-dd'T'HH:mm:ss.SSSXXX", "yyyy-MM-dd'T'HH:mm:ssX",
        )
        formats.firstNotNullOfOrNull { format ->
            runCatching {
                SimpleDateFormat(format, Locale.US).apply { isLenient = false }.parse(text)
            }.getOrNull()
        }?.let { parsed ->
            return Calendar.getInstance().apply { time = parsed }
        }
        return null
    }
}

private class CraftNativeVideoView(context: Context) : VideoView(context) {
    private var sourceUri = ""
    private var shouldLoop = false
    private var shouldPlay = false
    private var muted = false

    fun configure(source: Any?, autoplay: Boolean, paused: Boolean, loop: Boolean, muted: Boolean, controls: Boolean) {
        val uri = when (source) {
            is String -> source
            is JSONObject -> source.optString("uri")
            else -> ""
        }
        shouldLoop = loop
        shouldPlay = autoplay && !paused
        this.muted = muted
        setMediaController(if (controls) MediaController(context).also { it.setAnchorView(this) } else null)
        if (uri != sourceUri) {
            sourceUri = uri
            stopPlayback()
            if (uri.isBlank()) return
            setVideoURI(Uri.parse(uri))
            setOnPreparedListener { mediaPlayer ->
                mediaPlayer.isLooping = shouldLoop
                val volume = if (this.muted) 0f else 1f
                mediaPlayer.setVolume(volume, volume)
                if (shouldPlay) start()
            }
            setOnCompletionListener { if (shouldLoop && !isPlaying) start() }
        }
        if (uri.isBlank()) return
        runCatching {
            if (shouldPlay && !isPlaying) start()
            else if (!shouldPlay && isPlaying) pause()
        }
    }

    fun stop() {
        stopPlayback()
        sourceUri = ""
    }
}

/** The oscillator/gain subset of Web Audio used by native STX screens. */
private class CraftNativeAudio {
    private data class ParameterEvent(val time: Double, val value: Double, val ramp: Boolean)

    private class Parameter(initial: Double) {
        private var current = initial
        private val events = mutableListOf<ParameterEvent>()

        @Synchronized fun set(value: Double) {
            current = value
            events.clear()
        }

        @Synchronized fun schedule(value: Double, time: Double, ramp: Boolean) {
            events += ParameterEvent(time.coerceAtLeast(0.0), value, ramp)
            events.sortBy { it.time }
        }

        @Synchronized fun valueAt(time: Double): Double {
            var previousTime = 0.0
            var previousValue = current
            for (event in events) {
                if (time < event.time) {
                    if (!event.ramp || event.time <= previousTime) return previousValue
                    val fraction = (time - previousTime) / (event.time - previousTime)
                    return previousValue + (event.value - previousValue) * fraction
                }
                previousTime = event.time
                previousValue = event.value
            }
            return previousValue
        }
    }

    private class OscillatorState {
        val frequency = Parameter(440.0)
        @Volatile var gain = Parameter(1.0)
        @Volatile var phase = 0.0
        @Volatile var active = false
        var contextStart = 0.0
    }

    private val handler = Handler(Looper.getMainLooper())
    private val oscillators = mutableMapOf<String, OscillatorState>()
    private val gains = mutableMapOf<String, Parameter>()
    private val contextStarts = mutableMapOf<String, Double>()
    private var track: AudioTrack? = null
    @Volatile private var running = false
    private var renderThread: Thread? = null

    @Synchronized fun handle(payload: JSONObject) {
        when (payload.optString("action")) {
            "createContext" -> {
                payload.optString("contextId").takeIf { it.isNotBlank() }?.let {
                    contextStarts[it] = System.nanoTime() / 1_000_000_000.0
                }
            }
            "createOscillator" -> {
                val id = payload.optString("nodeId")
                if (id.isNotBlank()) oscillators.putIfAbsent(id, OscillatorState()).also {
                    oscillators[id]?.contextStart = contextStarts[payload.optString("contextId")]
                        ?: (System.nanoTime() / 1_000_000_000.0)
                    oscillators[id]?.frequency?.set(payload.optDouble("frequency", 440.0).coerceAtLeast(0.0))
                }
            }
            "createGain" -> {
                val id = payload.optString("nodeId")
                if (id.isNotBlank()) gains[id] = Parameter(payload.optDouble("gain", 1.0).coerceAtLeast(0.0))
            }
            "connect" -> {
                val source = payload.optString("sourceId")
                oscillators[source]?.gain = gains[payload.optString("destinationId")] ?: Parameter(1.0)
            }
            "frequency" -> oscillators[payload.optString("nodeId")]?.frequency?.set(payload.optDouble("value", 0.0).coerceAtLeast(0.0))
            "frequencyAtTime", "frequencyRampToTime" -> oscillators[payload.optString("nodeId")]?.frequency?.schedule(
                payload.optDouble("value", 0.0).coerceAtLeast(0.0),
                payload.optDouble("time", 0.0),
                payload.optString("action") == "frequencyRampToTime",
            )
            "gain" -> gains[payload.optString("nodeId")]?.set(payload.optDouble("value", 0.0).coerceAtLeast(0.0))
            "gainAtTime", "gainRampToTime" -> gains[payload.optString("nodeId")]?.schedule(
                payload.optDouble("value", 0.0).coerceAtLeast(0.0),
                payload.optDouble("time", 0.0),
                payload.optString("action") == "gainRampToTime",
            )
            "start", "stop" -> {
                val state = oscillators[payload.optString("nodeId")] ?: return
                ensureTrack()
                val active = payload.optString("action") == "start"
                val delay = (payload.optDouble("delay", 0.0).coerceAtLeast(0.0) * 1000).roundToLong()
                handler.postDelayed({ state.active = active }, delay)
            }
            "close" -> close()
        }
    }

    @Synchronized fun close() {
        oscillators.values.forEach { it.active = false }
        oscillators.clear()
        gains.clear()
        contextStarts.clear()
        running = false
        renderThread?.interrupt()
        renderThread = null
        track?.let { output ->
            runCatching {
                output.pause()
                output.flush()
                output.release()
            }
        }
        track = null
    }

    @Synchronized private fun ensureTrack() {
        if (track != null) return
        val sampleRate = 44_100
        val minBuffer = AudioTrack.getMinBufferSize(sampleRate, AudioFormat.CHANNEL_OUT_STEREO, AudioFormat.ENCODING_PCM_16BIT)
        val format = AudioFormat.Builder()
            .setSampleRate(sampleRate)
            .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
            .setChannelMask(AudioFormat.CHANNEL_OUT_STEREO)
            .build()
        val attributes = AudioAttributes.Builder()
            .setUsage(AudioAttributes.USAGE_MEDIA)
            .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
            .build()
        val created = AudioTrack.Builder()
            .setAudioAttributes(attributes)
            .setAudioFormat(format)
            .setBufferSizeInBytes(max(minBuffer, sampleRate / 4))
            .setTransferMode(AudioTrack.MODE_STREAM)
            .build()
        track = created
        running = true
        created.play()
        renderThread = Thread({ render(created, sampleRate) }, "craft-native-audio").also { it.start() }
    }

    private fun render(output: AudioTrack, sampleRate: Int) {
        val buffer = ShortArray(1024 * 2)
        while (running && !Thread.currentThread().isInterrupted) {
            val snapshot = synchronized(this) {
                oscillators.mapValues { (id, state) ->
                    Triple(state, state.gain, state.active)
                }
            }
            val now = System.nanoTime() / 1_000_000_000.0
            for (frame in 0 until 1024) {
                var sample = 0.0
                snapshot.forEach { (_, value) ->
                    val (state, gain, active) = value
                    if (!active) return@forEach
                    val time = (now - state.contextStart).coerceAtLeast(0.0) + frame.toDouble() / sampleRate
                    val frequency = state.frequency.valueAt(time)
                    sample += sin(state.phase) * gain.valueAt(time)
                    state.phase += 2 * PI * frequency / sampleRate
                    if (state.phase >= 2 * PI) state.phase -= 2 * PI
                }
                val value = (sample.coerceIn(-1.0, 1.0) * Short.MAX_VALUE).toInt().toShort()
                buffer[frame * 2] = value
                buffer[frame * 2 + 1] = value
            }
            if (output.write(buffer, 0, buffer.size, AudioTrack.WRITE_BLOCKING) < 0) break
        }
    }
}

/** WebView-free host for a route bundle compiled by `stx native compile`. */
class MainActivity : AppCompatActivity() {
    private class Screen(
        val route: String?,
        val params: JSONObject,
        val view: CraftNativeFlexLayout,
        val isolate: JavaScriptIsolate,
        val port: MessagePort?
    ) {
        val drafts = mutableMapOf<String, String>()
        val inputIdentities = mutableMapOf<EditText, String>()
        val suppressedTextChanges = mutableSetOf<EditText>()
        val controls = mutableMapOf<String, View>()
        // Protocol ids identify mutation targets; authored keys identify the
        // retained view. Keep both mappings so a targeted update can recover
        // the original tree path without manufacturing a detached view.
        val nodeViews = mutableMapOf<String, View>()
        val nodePaths = mutableMapOf<String, String>()
        val handlers = mutableMapOf<View, String>()
        val pressInHandlers = mutableMapOf<View, String>()
        val pressOutHandlers = mutableMapOf<View, String>()
        val longPressHandlers = mutableMapOf<View, String>()
        val scrollHandlers = mutableMapOf<View, String>()
        val scrollBeginHandlers = mutableMapOf<View, String>()
        val scrollEndHandlers = mutableMapOf<View, String>()
        val scrollMomentumBeginHandlers = mutableMapOf<View, String>()
        val scrollMomentumEndHandlers = mutableMapOf<View, String>()
        val sliderCompleteHandlers = mutableMapOf<View, String>()
        val sliderSteps = mutableMapOf<View, Double>()
        val focusHandlers = mutableMapOf<View, String>()
        val blurHandlers = mutableMapOf<View, String>()
        val endEditingHandlers = mutableMapOf<View, String>()
        val submitHandlers = mutableMapOf<View, String>()
        val imageLoadStartHandlers = mutableMapOf<ImageView, String>()
        val imageLoadHandlers = mutableMapOf<ImageView, String>()
        val imageLoadEndHandlers = mutableMapOf<ImageView, String>()
        val imageErrorHandlers = mutableMapOf<ImageView, String>()
        val pressActiveOpacities = mutableMapOf<View, Float>()
        val pressBaseOpacities = mutableMapOf<View, Float>()
        val modalVisibility = mutableMapOf<View, Boolean>()
        val modalCloseHandlers = mutableMapOf<View, String>()
        val layoutHandlers = mutableMapOf<View, String>()
        val layoutListeners = mutableMapOf<View, View.OnLayoutChangeListener>()
        val lastLayoutBounds = mutableMapOf<View, LayoutBounds>()
        val flatListRows = mutableMapOf<CraftNativeFlatList, MutableMap<String, MutableMap<String, View>>>()
        val flatListOwners = mutableMapOf<String, String>()
        val flatListOwnerByView = mutableMapOf<CraftNativeFlatList, String>()
        val mutations = CraftNativeMutationDocument()
        val capabilityScope = UUID.randomUUID().toString()
        val pendingCapabilities = mutableSetOf<String>()
        val capabilityTimeouts = mutableMapOf<String, Runnable>()
        val audio = CraftNativeAudio()
        var active = true

        fun close() {
            if (!active) return
            active = false
            audio.close()
            val finish = {
                port?.close()
                isolate.close()
            }
            val teardown = runCatching {
                isolate.evaluateJavaScriptAsync(
                    "globalThis.__stxNativeUnmount && globalThis.__stxNativeUnmount()"
                )
            }.getOrNull()
            if (teardown == null) {
                finish()
                return
            }
            teardown.addListener({
                runCatching { teardown.get() }
                finish()
            }, java.util.concurrent.Executor { command -> command.run() })
        }
    }

    private lateinit var root: FrameLayout
    private var sandbox: JavaScriptSandbox? = null
    private val screens = mutableListOf<Screen>()
    private var bundle = ""
    private lateinit var config: JSONObject
    private lateinit var capabilities: CraftNativeCapabilities
    private val capabilityHandler = Handler(Looper.getMainLooper())
    private var hapticsEnabled = false
    private var clipboardEnabled = false
    internal var nativeAppState = "inactive"
        private set
    private var deliveredInitialDeepLink = false
    private var initialDeepLink: Uri? = null
    private var initialDeepLinkClaimed = false
    private var defaultTextColor = Color.WHITE
    private var useMessagePorts = false
    private val imageExecutor = Executors.newFixedThreadPool(2)
    private val imageSources = mutableMapOf<ImageView, String>()
    private val imageJobs = mutableMapOf<ImageView, Future<*>>()
    private val imageErrors = mutableMapOf<ImageView, String>()
    private val inputHintDefaults = mutableMapOf<EditText, ColorStateList>()
    private val inputHighlightDefaults = mutableMapOf<EditText, Int>()
    private val defaultBackgrounds = mutableMapOf<View, Drawable?>()

    override fun onCreate(savedInstanceState: Bundle?) {
        applyConfiguredAppearance()
        super.onCreate(savedInstanceState)
        initialDeepLink = savedInstanceState?.getString("craft.initialDeepLink")?.let(Uri::parse) ?: intent?.data
        initialDeepLinkClaimed = savedInstanceState?.getBoolean("craft.initialDeepLinkClaimed", false) ?: false
        deliveredInitialDeepLink = savedInstanceState?.getBoolean("craft.deliveredInitialDeepLink", false) ?: false
        setContentView(R.layout.activity_main)
        root = findViewById(R.id.native_root)
        ViewCompat.setOnApplyWindowInsetsListener(root) { view, insets ->
            val safe = insets.getInsets(WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout())
            view.setPadding(safe.left, safe.top, safe.right, safe.bottom)
            view.requestLayout()
            view.post { screens.lastOrNull()?.takeIf { it.active }?.let(::emitLayoutEvents) }
            insets
        }
        ViewCompat.requestApplyInsets(root)
        config = runCatching {
            assets.open("craft.config.json").bufferedReader().use {
                JSONObject(it.readText())
            }
        }.getOrDefault(JSONObject())
        hapticsEnabled = config.optBoolean("enableHaptics", false)
        clipboardEnabled = config.optBoolean("enableClipboard", false)
        capabilities = CraftNativeCapabilities(this, config)
        refreshThemeDefaults()
        bundle = runCatching {
            assets.open("native-screen.js").bufferedReader().use { it.readText() }
        }.getOrElse {
            showError("Missing native-screen.js. Build with --native-bundle after compiling STX.")
            return
        }
        if (!JavaScriptSandbox.isSupported()) {
            showError("Native STX requires Android JavaScriptSandbox, which is unavailable on this device.")
            return
        }
        val connection = synchronized(SANDBOX_LOCK) {
            sharedSandboxConnection ?: sharedSandbox?.let { existing ->
                sandbox = existing
                null
            } ?: JavaScriptSandbox.createConnectedInstanceAsync(applicationContext).also {
                sharedSandboxConnection = it
            }
        }
        if (connection == null) {
            sandbox?.let(::attachSandbox)
        } else {
            connection.addListener({
                try {
                    val engine = connection.get()
                    synchronized(SANDBOX_LOCK) {
                        sharedSandbox = engine
                    }
                    if (!isDestroyed) {
                        sandbox = engine
                        attachSandbox(engine)
                    }
                } catch (error: Exception) {
                    synchronized(SANDBOX_LOCK) { sharedSandboxConnection = null }
                    Log.e(TAG, "JavaScriptSandbox connection failed", error)
                    if (!isDestroyed) showError("Native STX JavaScript engine could not start: ${error.message}")
                }
            }, ContextCompat.getMainExecutor(this))
        }
    }

    private fun applyConfiguredAppearance() {
        val configured = runCatching {
            assets.open("craft.config.json").bufferedReader().use { JSONObject(it.readText()) }
        }.getOrNull()
        val mode = when (configured?.optString("appearance")) {
            "light" -> AppCompatDelegate.MODE_NIGHT_NO
            "dark" -> AppCompatDelegate.MODE_NIGHT_YES
            "system" -> AppCompatDelegate.MODE_NIGHT_FOLLOW_SYSTEM
            else -> if (configured?.optBoolean("darkMode", true) == false) {
                AppCompatDelegate.MODE_NIGHT_NO
            } else {
                AppCompatDelegate.MODE_NIGHT_YES
            }
        }
        AppCompatDelegate.setDefaultNightMode(mode)
    }

    private fun attachSandbox(engine: JavaScriptSandbox) {
        useMessagePorts = engine.isFeatureSupported(JavaScriptSandbox.JS_FEATURE_MESSAGE_PORTS)
            && engine.isFeatureSupported(JavaScriptSandbox.JS_FEATURE_PROMISE_RETURN)
        if (!useMessagePorts && !engine.isFeatureSupported(JavaScriptSandbox.JS_FEATURE_CONSOLE_MESSAGING)) {
            showError("Native STX requires JavaScript message ports or console messaging, unavailable on this device.")
            return
        }
        Log.i(TAG, "Native STX bridge: ${if (useMessagePorts) "message ports" else "console callback"}")
        openScreen(null)
    }

    private fun openScreen(route: String?, params: JSONObject = JSONObject()) {
        val engine = sandbox ?: return
        val isolate = engine.createIsolate()
        val view = CraftNativeFlexLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = FrameLayout.LayoutParams(-1, -1)
        }
        var screen: Screen? = null
        val executor = ContextCompat.getMainExecutor(this)
        val token = UUID.randomUUID().toString()
        val prefix = "CRAFT_STX_$token:"
        val port = if (useMessagePorts) {
            isolate.createMessageChannel("craft", executor, MessagePortClient { message ->
                val current = screen ?: return@MessagePortClient
                if (current.active && message.type == Message.TYPE_STRING) receiveSafely(current, message.string)
            })
        } else {
            isolate.setConsoleCallback(executor, JavaScriptConsoleCallback { entry ->
                val current = screen ?: return@JavaScriptConsoleCallback
                if (current.active && entry.message.startsWith(prefix)) {
                    receiveSafely(current, entry.message.removePrefix(prefix))
                }
            })
            null
        }
        val activeScreen = Screen(route, params, view, isolate, port)
        activeScreen.view.onLayoutChanged = {
            if (activeScreen.active) emitLayoutEvents(activeScreen)
        }
        screen = activeScreen
        screens.add(activeScreen)
        show(activeScreen)
        val routePrelude = """
            globalThis.__stxNativeRoute = ${route?.let { JSONObject.quote(it) } ?: "undefined"};
            globalThis.__stxNativeParams = ${params};
        """.trimIndent()
        val audioPrelude = """
            (function() {
              if (typeof globalThis.AudioContext !== 'function') {
                var nextAudioId = 0;
                function audioMessage(payload) {
                  globalThis.__stxNativeBridge.postMessage({ type: 'AUDIO', payload: payload });
                }
                function audioParam(contextId, nodeId, action, initial) {
                  var current = Number(initial) || 0;
                  var param = {};
                  Object.defineProperty(param, 'value', {
                    configurable: true,
                    enumerable: true,
                    get: function() { return current; },
                    set: function(value) {
                      current = Number(value) || 0;
                      audioMessage({ action: action, contextId: contextId, nodeId: nodeId, value: current });
                    }
                  });
                  function schedule(value, when, ramp) {
                    current = Number(value) || 0;
                    var time = Number(when);
                    audioMessage({ action: action + (ramp ? 'RampToTime' : 'AtTime'), contextId: contextId, nodeId: nodeId, value: current, time: isFinite(time) ? Math.max(0, time) : 0 });
                  }
                  param.setValueAtTime = function(value, when) { schedule(value, when, false); return param; };
                  param.linearRampToValueAtTime = function(value, when) { schedule(value, when, true); return param; };
                  return param;
                }
                function AudioContext() {
                  this._id = 'audio-' + (++nextAudioId);
                  this._started = Date.now() / 1000;
                  this.state = 'running';
                  this.destination = { _contextId: this._id, _nodeId: 'destination' };
                  audioMessage({ action: 'createContext', contextId: this._id });
                }
                Object.defineProperty(AudioContext.prototype, 'currentTime', {
                  get: function() { return Date.now() / 1000 - this._started; }
                });
                AudioContext.prototype.createOscillator = function() {
                  var context = this;
                  var node = { _contextId: context._id, _nodeId: context._id + '-osc-' + (++nextAudioId) };
                  node.frequency = audioParam(context._id, node._nodeId, 'frequency', 440);
                  node.connect = function(destination) {
                    audioMessage({ action: 'connect', contextId: context._id, sourceId: node._nodeId, destinationId: destination && destination._nodeId || 'destination' });
                    return destination;
                  };
                  node.start = function(when) {
                    audioMessage({ action: 'start', contextId: context._id, nodeId: node._nodeId, delay: Math.max(0, (Number(when) || 0) - context.currentTime) });
                  };
                  node.stop = function(when) {
                    audioMessage({ action: 'stop', contextId: context._id, nodeId: node._nodeId, delay: Math.max(0, (Number(when) || 0) - context.currentTime) });
                  };
                  audioMessage({ action: 'createOscillator', contextId: context._id, nodeId: node._nodeId, frequency: node.frequency.value });
                  return node;
                };
                AudioContext.prototype.createGain = function() {
                  var context = this;
                  var node = { _contextId: context._id, _nodeId: context._id + '-gain-' + (++nextAudioId) };
                  node.gain = audioParam(context._id, node._nodeId, 'gain', 1);
                  node.connect = function(destination) {
                    audioMessage({ action: 'connect', contextId: context._id, sourceId: node._nodeId, destinationId: destination && destination._nodeId || 'destination' });
                    return destination;
                  };
                  audioMessage({ action: 'createGain', contextId: context._id, nodeId: node._nodeId, gain: node.gain.value });
                  return node;
                };
                AudioContext.prototype.resume = function() { this.state = 'running'; return Promise.resolve(); };
                AudioContext.prototype.suspend = function() { this.state = 'suspended'; return Promise.resolve(); };
                AudioContext.prototype.close = function() { this.state = 'closed'; audioMessage({ action: 'close', contextId: this._id }); return Promise.resolve(); };
                globalThis.AudioContext = AudioContext;
                globalThis.webkitAudioContext = AudioContext;
              }
            })()
        """.trimIndent()
        val prelude = if (useMessagePorts) """
            (async function() {
              const port = await android.getNamedPort('craft');
              $routePrelude
              globalThis.__stxNativeBridge = {
                platform: 'android',
                mutationProtocolVersion: 1,
                capabilityProtocolVersion: $CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION,
                capabilityTimeoutMs: $CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS,
                capabilities: ${capabilities.names()},
                initialAppState: ${JSONObject.quote(nativeAppState)},
                colorScheme: ${JSONObject.quote(colorScheme())},
                postMessage: function(value) { port.postMessage(value); },
                onMessage: function(callback) { port.onmessage = function(event) { callback(event.data); }; }
              };
              $audioPrelude
            })()
        """.trimIndent() else """
            $routePrelude
            globalThis.__stxNativeBridge = {
              platform: 'android',
              mutationProtocolVersion: 1,
              capabilityProtocolVersion: $CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION,
              capabilityTimeoutMs: $CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS,
              capabilities: ${capabilities.names()},
              initialAppState: ${JSONObject.quote(nativeAppState)},
              colorScheme: ${JSONObject.quote(colorScheme())},
              postMessage: function(value) { console.log(${JSONObject.quote(prefix)} + value); },
              onMessage: function(callback) { globalThis.__stxNativeCallback = callback; }
            };
            $audioPrelude
        """.trimIndent()
        val setup = isolate.evaluateJavaScriptAsync(prelude)
        setup.addListener({
            if (!activeScreen.active) return@addListener
            try {
                setup.get()
                val load = isolate.evaluateJavaScriptAsync(bundle)
                load.addListener({
                    try {
                        load.get()
                        val launchLink = initialDeepLink
                        if (!deliveredInitialDeepLink
                            && config.optBoolean("enableDeepLinks")
                            && launchLink != null
                            && screens.lastOrNull() === activeScreen
                        ) {
                            deliveredInitialDeepLink = true
                            send(activeScreen, "DEEP_LINK", deepLinkData(launchLink).put("initial", true))
                        }
                    } catch (error: Exception) {
                        Log.e(TAG, "Native STX bundle failed", error)
                        if (activeScreen.active) showError("Native STX bundle failed: ${error.message}")
                    }
                }, executor)
            } catch (error: Exception) {
                Log.e(TAG, "Native STX bridge failed", error)
                showError("Native STX bridge failed: ${error.message}")
            }
        }, executor)
    }

    private fun show(screen: Screen) {
        root.removeAllViews()
        (screen.view.parent as? ViewGroup)?.removeView(screen.view)
        root.addView(screen.view)
        refreshScreenTheme(screen)
    }

    override fun onSaveInstanceState(outState: Bundle) {
        outState.putString("craft.initialDeepLink", initialDeepLink?.toString())
        outState.putBoolean("craft.initialDeepLinkClaimed", initialDeepLinkClaimed)
        outState.putBoolean("craft.deliveredInitialDeepLink", deliveredInitialDeepLink)
        super.onSaveInstanceState(outState)
    }

    override fun onConfigurationChanged(newConfig: Configuration) {
        super.onConfigurationChanged(newConfig)
        if (!::root.isInitialized) return
        refreshThemeDefaults()
        ViewCompat.requestApplyInsets(root)
        refreshInputDefaultsForTraitChange()
        screens.lastOrNull()?.let { screen ->
            refreshScreenTheme(screen)
            if (screen.active) {
                send(screen, "APPEARANCE", JSONObject().put("colorScheme", colorScheme()))
            }
        }
    }

    private fun refreshScreenTheme(screen: Screen) {
        screen.mutations.node("root")?.let { renderCommitted(screen, it) }
        screen.controls.values.mapNotNull {
            when (it) {
                is CraftNativeRefreshableFlatList -> it.list
                is CraftNativeFlatList -> it
                else -> null
            }
        }.forEach { it.refreshThemeDefaults() }
    }

    private fun refreshThemeDefaults() {
        val background = ContextCompat.getColor(this, R.color.background)
        root.setBackgroundColor(background)
        defaultTextColor = if (Color.luminance(background) < 0.5) Color.WHITE else Color.BLACK
    }

    private fun colorScheme(): String = if (
        resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK == Configuration.UI_MODE_NIGHT_YES
    ) "dark" else "light"

    private fun refreshInputDefaultsForTraitChange() {
        if (inputHintDefaults.isEmpty() && inputHighlightDefaults.isEmpty()) return
        val probe = EditText(this)
        val hintColors = probe.hintTextColors
        val highlightColor = probe.highlightColor
        inputHintDefaults.keys.toList().forEach { inputHintDefaults[it] = hintColors }
        inputHighlightDefaults.keys.toList().forEach { inputHighlightDefaults[it] = highlightColor }
    }

    private fun receive(screen: Screen, raw: String) {
        val message = runCatching { JSONObject(raw) }.getOrNull() ?: return
        val payload = message.optJSONObject("payload") ?: JSONObject()
        Log.d(TAG, "Native STX ${message.optString("type")} (${raw.length} chars) for ${screen.route ?: "home"}")
        when (message.optString("type")) {
            "RENDER" -> payload.optJSONObject("document")?.let { render(screen, it) }
            "MUTATE" -> try {
                val result = applyMutation(screen, payload)
                send(screen, "MUTATION_ACK", JSONObject()
                    .put("batchId", result.batchId)
                    .put("revision", result.revision)
                    .put("version", CRAFT_NATIVE_MUTATION_PROTOCOL_VERSION))
            }
            catch (failure: CraftNativeMutationFailure) {
                val error = JSONObject()
                    .put("batchId", payload.optString("batchId"))
                    .put("code", failure.code)
                    .put("message", failure.message)
                    .put("version", CRAFT_NATIVE_MUTATION_PROTOCOL_VERSION)
                failure.operationIndex?.let { error.put("operationIndex", it) }
                send(screen, "MUTATION_ERROR", error)
            }
            catch (_: Exception) {
                send(screen, "MUTATION_ERROR", JSONObject()
                    .put("batchId", payload.optString("batchId"))
                    .put("code", "INVALID_BATCH")
                    .put("message", "mutation batch could not be applied")
                    .put("version", CRAFT_NATIVE_MUTATION_PROTOCOL_VERSION))
            }
            "NAVIGATE", "NAVIGATE_REPLACE" -> {
                if (screens.lastOrNull() !== screen) return
                val route = payload.optString("screen").takeIf { it.isNotBlank() } ?: return
                if (message.optString("type") == "NAVIGATE_REPLACE") {
                    closeScreen(screens.removeAt(screens.lastIndex))
                }
                openScreen(route, payload.optJSONObject("params") ?: JSONObject())
            }
            "NAVIGATE_BACK" -> if (screens.lastOrNull() === screen) back()
            "NAVIGATE_POP_TO_ROOT" -> if (screens.lastOrNull() === screen) popToRoot()
            "API_REQUEST" -> answerAPI(screen, message, payload)
            "API_CANCEL" -> {
                val id = payload.optString("requestId")
                if (id.isNotBlank()) {
                    val token = "${screen.capabilityScope}/$id"
                    screen.pendingCapabilities.remove(token)
                    screen.capabilityTimeouts.remove(token)?.let(capabilityHandler::removeCallbacks)
                    capabilities.cancel(token)
                }
            }
            "AUDIO" -> screen.audio.handle(payload)
        }
    }

    private fun receiveSafely(screen: Screen, raw: String) {
        try {
            receive(screen, raw)
        }
        catch (error: Exception) {
            val route = screen.route ?: "home"
            Log.e(TAG, "Native STX message failed for $route", error)
            if (screen.active) showError("Native STX message failed for $route: ${error.message}")
        }
    }

    private fun render(screen: Screen, document: JSONObject) {
        screen.mutations.replace(document)
        renderCommitted(screen, document)
    }

    private fun applyMutation(screen: Screen, payload: JSONObject): CraftNativeMutationResult {
        val result = screen.mutations.apply(payload)
        if (!result.requiresFullRender && applyTargetedUpdates(screen, result.affectedNodeIds)) return result
        result.document?.let { renderCommitted(screen, it) } ?: clearRenderedTree(screen)
        return result
    }

    private fun applyTargetedUpdates(screen: Screen, ids: List<String>): Boolean {
        val applied = mutableSetOf<String>()
        for (id in ids) {
            val target = screen.flatListOwners[id] ?: id
            if (!applied.add(target)) continue
            val document = screen.mutations.node(target) ?: return false
            val path = screen.nodePaths[target] ?: return false
            if (screen.nodeViews[target] == null) return false
            makeView(screen, document, path, screen.controls)
            val updated = screen.nodeViews[target] ?: return false
            screen.lastLayoutBounds.remove(updated)
            if (!updateParentLayoutStyle(updated, document.optJSONObject("style") ?: JSONObject())) return false
        }
        if (applied.isNotEmpty()) {
            scheduleLayoutEvents(screen)
        }
        return true
    }

    private fun scheduleLayoutEvents(screen: Screen) {
        if (!screen.active) return
        val observer = screen.view.viewTreeObserver
        if (observer.isAlive) {
            val listener = object : ViewTreeObserver.OnPreDrawListener {
                override fun onPreDraw(): Boolean {
                    if (observer.isAlive) observer.removeOnPreDrawListener(this)
                    if (screen.active) emitLayoutEvents(screen)
                    return true
                }
            }
            observer.addOnPreDrawListener(listener)
        }
        screen.view.forceLayout()
        screen.view.requestLayout()
        // A tree that is already settled may not produce a global-layout
        // callback; keep the event path live for that case as well.
        screen.view.postOnAnimation { if (screen.active) emitLayoutEvents(screen) }
    }

    /**
     * Targeted mutations bypass the parent's child reconciliation. Rebind the
     * updated node's layout style explicitly so removing a width/height (or
     * changing flex participation) invalidates the native parent's metrics.
     */
    private fun updateParentLayoutStyle(view: View, style: JSONObject): Boolean {
        var parent = view.parent
        var found = false
        // A targeted style update can arrive while Android considers the
        // existing traversal settled. Invalidate the node itself as well as
        // every ancestor, including the platform ScrollView between the
        // native content layout and CraftNativeScrollView.
        view.forceLayout()
        view.requestLayout()
        while (parent != null) {
            when (parent) {
                is CraftNativeFlexLayout -> {
                    if (!found) parent.setChildStyle(view, style, resources.displayMetrics.density)
                    parent.forceLayout()
                    parent.requestLayout()
                    found = true
                }
                is CraftNativeScrollView -> {
                    parent.invalidateContentLayout()
                }
            }
            (parent as? View)?.let {
                it.forceLayout()
                it.requestLayout()
            }
            parent = parent.parent
        }
        return found
    }

    private fun renderCommitted(screen: Screen, document: JSONObject) {
        // Keep live controls (especially the focused EditText) across renders.
        val next = mutableMapOf<String, View>()
        screen.nodeViews.clear()
        screen.nodePaths.clear()
        val tree = makeView(screen, document, "root", next)
        if (screen.view.getChildAt(0) !== tree) {
            (tree.parent as? ViewGroup)?.removeView(tree)
            screen.view.removeAllViews()
            screen.view.addView(tree)
        }
        releaseViewState(screen, screen.controls.values.filter { it !in next.values })
        screen.controls.clear()
        screen.controls.putAll(next)
        screen.handlers.keys.retainAll(retainedViews(screen))
        screen.view.setChildStyle(tree, document.optJSONObject("style") ?: JSONObject(), resources.displayMetrics.density)
        // A full render can change a view's custom layout style without
        // changing the root bounds. Ensure native @layout observers still see
        // the settled child frame after the next traversal.
        scheduleLayoutEvents(screen)
    }

    private fun clearRenderedTree(screen: Screen) {
        releaseViewState(screen, retainedViews(screen).toList())
        screen.view.removeAllViews()
        screen.controls.clear()
        screen.nodeViews.clear()
        screen.nodePaths.clear()
        screen.handlers.clear()
        screen.flatListRows.clear()
        screen.flatListOwners.clear()
        screen.flatListOwnerByView.clear()
    }

    private fun makeView(
        screen: Screen,
        node: JSONObject,
        path: String,
        next: MutableMap<String, View>,
        previousControls: Map<String, View> = screen.controls,
    ): View {
        val type = canonicalType(node.optString("type", "View"))
        val props = node.optJSONObject("props") ?: JSONObject()
        val style = node.optJSONObject("style") ?: JSONObject()
        val events = node.optJSONObject("events") ?: JSONObject()
        val children = node.optJSONArray("children") ?: JSONArray()
        val protocolId = node.optString("id").takeIf { it.isNotBlank() }
        val explicitKey = authoredKey(node, props)
        val identity = explicitKey?.let { "${path.substringBeforeLast('.', "")}/$it" }
            ?: protocolId?.let { "id:$it" }
            ?: path
        val previous = previousControls[identity]
        val reusableInput = previous as? EditText
        val control = when (type) {
            "Text" -> ((previous as? TextView)?.takeUnless { it is Button || it is EditText } ?: TextView(this)).apply {
                includeFontPadding = false
                maxLines = props.optInt("numberOfLines", 0).takeIf { it > 0 } ?: Int.MAX_VALUE
                ellipsize = when (props.optString("ellipsizeMode")) {
                    "head" -> TextUtils.TruncateAt.START
                    "middle" -> TextUtils.TruncateAt.MIDDLE
                    "tail" -> TextUtils.TruncateAt.END
                    else -> null
                }
                configureText(this, childText(children), style)
            }
            "Link" -> ((previous as? TextView)?.takeUnless { it is Button } ?: TextView(this)).apply {
                includeFontPadding = false
                configureText(this, props.optString("title").ifBlank { childText(children) }, style)
                val linkColor = props.optString("color").takeIf { it.isNotBlank() } ?: style.optString("color")
                setTextColor(color(linkColor, Color.rgb(33, 150, 243)))
                paintFlags = paintFlags or Paint.UNDERLINE_TEXT_FLAG
                isEnabled = !props.optBoolean("disabled", false)
                isClickable = true
                isFocusable = true
                val handler = events.optString("onPress").ifBlank { events.optString("onClick") }
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                setOnClickListener {
                    val current = screen.handlers[this] ?: return@setOnClickListener
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                }
            }
            "Button" -> (previous as? Button ?: Button(this)).apply {
                val title = props.optString("title").ifBlank { childText(children) }
                isAllCaps = false
                configureText(this, title, style)
                props.optString("color").takeIf { it.isNotBlank() }?.let { setTextColor(color(it, defaultTextColor)) }
                isEnabled = !props.optBoolean("disabled", false)
                val handler = events.optString("onPress").ifBlank { events.optString("onClick") }
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                setOnClickListener {
                    val current = screen.handlers[this] ?: return@setOnClickListener
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                }
            }
            "TextInput" -> (reusableInput?.takeIf { it.isSingleLine == !props.optBoolean("multiline", false) }
                ?: EditText(this)).apply {
                val defaultHintColors = inputHintDefaults.getOrPut(this) {
                    hintTextColors ?: ColorStateList.valueOf(Color.GRAY)
                }
                val defaultHighlightColor = inputHighlightDefaults.getOrPut(this) { highlightColor }
                hint = props.optString("placeholder")
                setHintTextColor(
                    props.optString("placeholderTextColor").takeIf { it.isNotBlank() }
                        ?.let { ColorStateList.valueOf(color(it, Color.GRAY)) }
                        ?: defaultHintColors,
                )
                highlightColor = props.optString("selectionColor").takeIf { it.isNotBlank() }
                    ?.let { color(it, defaultHighlightColor) }
                    ?: defaultHighlightColor
                val maxLength = props.optInt("maxLength", 0)
                filters = if (maxLength > 0) arrayOf(InputFilter.LengthFilter(maxLength)) else emptyArray()
                inputType = inputTypeFor(props)
                imeOptions = imeOptionsFor(props)
                val multiline = props.optBoolean("multiline", false)
                isSingleLine = !multiline
                maxLines = if (multiline) props.optInt("numberOfLines", Int.MAX_VALUE).coerceAtLeast(1) else 1
                isEnabled = props.optBoolean("editable", true)
                configureTextStyle(this, style)
                // The style's padding is where the text starts, as on iOS and
                // the web; without one the field keeps its own.
                if (listOf("padding", "paddingHorizontal", "paddingVertical", "paddingLeft", "paddingRight", "paddingTop", "paddingBottom").any { style.has(it) }) {
                    val density = resources.displayMetrics.density
                    val all = style.optDouble("padding", 0.0)
                    val horizontal = style.optDouble("paddingHorizontal", all)
                    val vertical = style.optDouble("paddingVertical", all)
                    setPadding(
                        (style.optDouble("paddingLeft", horizontal) * density).toInt(),
                        (style.optDouble("paddingTop", vertical) * density).toInt(),
                        (style.optDouble("paddingRight", horizontal) * density).toInt(),
                        (style.optDouble("paddingBottom", vertical) * density).toInt(),
                    )
                }
                autofillHintFor(props)?.let { setAutofillHints(it) }
                val controlledValue = props.opt("value")?.takeUnless { it == JSONObject.NULL }?.toString()
                if (controlledValue != null && text.toString() != controlledValue) {
                    screen.suppressedTextChanges.add(this)
                    setTextPreservingSelection(this, controlledValue)
                }
                else if (this !== previous && screen.drafts.containsKey(identity)) setText(screen.drafts[identity])
                else if (this !== previous && props.has("defaultValue") && !props.isNull("defaultValue")) setText(props.optString("defaultValue"))
                screen.inputIdentities[this] = identity
                val handler = events.optString("onChange").ifBlank { events.optString("onChangeText") }
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                val onFocus = events.optString("onFocus")
                if (onFocus.isNotBlank()) screen.focusHandlers[this] = onFocus else screen.focusHandlers.remove(this)
                val onBlur = events.optString("onBlur")
                if (onBlur.isNotBlank()) screen.blurHandlers[this] = onBlur else screen.blurHandlers.remove(this)
                val onEndEditing = events.optString("onEndEditing")
