        "view" -> "View"
        "safeareaview" -> "SafeAreaView"
        "text" -> "Text"
        "button" -> "Button"
        "link" -> "Link"
        "textinput", "input" -> "TextInput"
        "picker", "select" -> "Picker"
        "datepicker", "date-picker", "date" -> "DatePicker"
        "modal" -> "Modal"
        "switch" -> "Switch"
        "slider" -> "Slider"
        "activityindicator" -> "ActivityIndicator"
        "image" -> "Image"
        "video" -> "Video"
        "icon" -> "Icon"
        "scrollview" -> "ScrollView"
        "flatlist" -> "FlatList"
        "svg" -> "Svg"
