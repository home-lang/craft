/** A flex container that responds to the activity's IME inset. */
private class CraftNativeKeyboardAvoidingView(context: Context) : FrameLayout(context) {
    val content = CraftNativeFlexLayout(context)
    private var behavior = "padding"
    private var keyboardVerticalOffset = 0
    private var keyboardInset = 0
    private var basePadding = intArrayOf(0, 0, 0, 0)

    init {
        addView(content, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
    }

    fun configure(props: JSONObject, style: JSONObject, density: Float) {
        behavior = props.optString("behavior", "padding").takeIf { it in setOf("height", "position", "padding") } ?: "padding"
        val authoredOffset = craftNativeFiniteDouble(props, "keyboardVerticalOffset", 0.0)
        val pixelOffset = (authoredOffset * density.toDouble()).takeIf { it.isFinite() } ?: 0.0
        keyboardVerticalOffset = pixelOffset.roundToInt()
        content.configure(style, density)
        basePadding = intArrayOf(content.paddingLeft, content.paddingTop, content.paddingRight, content.paddingBottom)
        applyKeyboardInset()
    }

    fun setKeyboardInset(inset: Int) {
        if (keyboardInset == inset) return
        keyboardInset = max(0, inset)
        applyKeyboardInset()
    }

    private fun effectiveInset(): Int = max(0, keyboardInset - keyboardVerticalOffset)

    private fun applyKeyboardInset() {
        val inset = effectiveInset()
        translationY = if (behavior == "position") -inset.toFloat() else 0f
        val bottom = if (behavior == "padding") basePadding[3] + inset else basePadding[3]
        content.setPadding(basePadding[0], basePadding[1], basePadding[2], bottom)
        requestLayout()
    }

    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val inset = effectiveInset()
        val adjustedHeight = if (behavior == "height" && inset > 0 && MeasureSpec.getMode(heightMeasureSpec) != MeasureSpec.UNSPECIFIED) {
            MeasureSpec.makeMeasureSpec(max(0, MeasureSpec.getSize(heightMeasureSpec) - inset), MeasureSpec.getMode(heightMeasureSpec))
        } else {
            heightMeasureSpec
        }
        super.onMeasure(widthMeasureSpec, adjustedHeight)
    }
}

private class CraftNativeScrollView(context: Context) : SwipeRefreshLayout(context) {
    val content = CraftNativeFlexLayout(context)
    private val vertical = ScrollView(context)
    private val horizontal = HorizontalScrollView(context)
    private var horizontalMode: Boolean? = null
    private var pagingEnabled = false
    private var bounces = true
    private var alwaysBounceVertical = true
    private var alwaysBounceHorizontal = true
    private var keyboardShouldPersistTaps = "never"
    private var refreshHandler: (() -> Unit)? = null

    init {
        vertical.isNestedScrollingEnabled = true
        horizontal.isNestedScrollingEnabled = true
        vertical.isFillViewport = true
        horizontal.isFillViewport = true
        setOnRefreshListener { refreshHandler?.invoke() }
        isEnabled = false
        setHorizontal(false)
    }

    /**
     * Along an axis its parent does not fix, a scroll view is as big as its
     * content (up to what the parent allows): a horizontal strip is as tall
     * as its row, a vertical scroll with room to spare as tall as what it
     * holds. SwipeRefreshLayout alone takes all of an AT_MOST size, which
     * made a strip in a column a million pixels tall.
     */
    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val widthMode = MeasureSpec.getMode(widthMeasureSpec)
        val heightMode = MeasureSpec.getMode(heightMeasureSpec)
        val widthSize = MeasureSpec.getSize(widthMeasureSpec)
        val heightSize = MeasureSpec.getSize(heightMeasureSpec)
        if (widthMode == MeasureSpec.EXACTLY && heightMode == MeasureSpec.EXACTLY) {
            super.onMeasure(widthMeasureSpec, heightMeasureSpec)
            return
        }
        val sideways = horizontalMode == true
        val unspecified = MeasureSpec.makeMeasureSpec(0, MeasureSpec.UNSPECIFIED)
        val horizontalPadding = paddingLeft + paddingRight
        val verticalPadding = paddingTop + paddingBottom
        content.measure(
            if (sideways || widthMode == MeasureSpec.UNSPECIFIED) unspecified
            else MeasureSpec.makeMeasureSpec(max(0, widthSize - horizontalPadding), MeasureSpec.EXACTLY),
            if (!sideways || heightMode == MeasureSpec.UNSPECIFIED) unspecified
            else MeasureSpec.makeMeasureSpec(max(0, heightSize - verticalPadding), MeasureSpec.AT_MOST),
        )
        fun fit(mode: Int, size: Int, wanted: Int): Int = when (mode) {
            MeasureSpec.EXACTLY -> size
            MeasureSpec.AT_MOST -> min(size, wanted)
            else -> wanted
        }
        val width = fit(widthMode, widthSize, content.measuredWidth + horizontalPadding)
        val height = fit(heightMode, heightSize, content.measuredHeight + verticalPadding)
        super.onMeasure(
            MeasureSpec.makeMeasureSpec(width, MeasureSpec.EXACTLY),
            MeasureSpec.makeMeasureSpec(height, MeasureSpec.EXACTLY),
        )
    }

    fun setRefreshHandler(handler: (() -> Unit)?, refreshing: Boolean) {
        refreshHandler = handler
        isEnabled = handler != null
        isRefreshing = handler != null && refreshing
        if (handler == null) isRefreshing = false
    }

    fun setRefreshAppearance(props: JSONObject, density: Float) {
        val tint = craftNativeOptionalString(props.opt("tintColor"))
        if (tint != null) setColorSchemeColors(craftNativeColor(tint))
        else setColorSchemeColors(Color.WHITE)
        val background = craftNativeOptionalString(props.opt("progressBackgroundColor"))
        if (background != null) setProgressBackgroundColorSchemeColor(craftNativeColor(background))
        else setProgressBackgroundColorSchemeColor(Color.TRANSPARENT)
        val offset = props.optDouble("progressViewOffset", Double.NaN)
        if (offset.isFinite()) setProgressViewOffset(true, 0, (offset * density).roundToInt())
        else setProgressViewOffset(false, 0, 0)
    }

    override fun onDetachedFromWindow() {
        refreshHandler = null
        isRefreshing = false
        super.onDetachedFromWindow()
    }

    fun setHorizontal(value: Boolean) {
        if (horizontalMode == value) return
        horizontalMode = value
        (content.parent as? ViewGroup)?.removeView(content)
        removeAllViews()
        val scroller: ViewGroup = if (value) horizontal else vertical
        scroller.removeAllViews()
        content.orientation = if (value) LinearLayout.HORIZONTAL else LinearLayout.VERTICAL
        scroller.addView(content, if (value)
            ViewGroup.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.MATCH_PARENT)
        else ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
        addView(scroller, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
    }

    /**
     * A targeted mutation can change a child's size without reconciling the
     * scroll content tree. Invalidate both the custom content layout and the
     * platform scroller so its measured content range is recomputed too.
     */
    fun invalidateContentLayout() {
        content.forceLayout()
        content.requestLayout()
        val scroller = if (horizontalMode == true) horizontal else vertical
        scroller.forceLayout()
        scroller.requestLayout()
        forceLayout()
        requestLayout()
    }

    fun setNativeNestedScrollingEnabled(value: Boolean) {
        vertical.isNestedScrollingEnabled = value
        horizontal.isNestedScrollingEnabled = value
    }

    fun setScrollEnabled(value: Boolean) {
        vertical.isEnabled = value
        horizontal.isEnabled = value
    }

    fun setKeyboardShouldPersistTaps(value: String?) {
        keyboardShouldPersistTaps = value?.takeIf { it in setOf("always", "handled", "never") } ?: "never"
    }

    fun setBounces(value: Boolean) {
        bounces = value
        applyBounceModes()
    }

    fun setAlwaysBounce(vertical: Boolean, horizontal: Boolean) {
        alwaysBounceVertical = vertical
        alwaysBounceHorizontal = horizontal
        applyBounceModes()
    }

    private fun applyBounceModes() {
        vertical.overScrollMode = if (bounces && alwaysBounceVertical) View.OVER_SCROLL_ALWAYS else View.OVER_SCROLL_NEVER
        horizontal.overScrollMode = if (bounces && alwaysBounceHorizontal) View.OVER_SCROLL_ALWAYS else View.OVER_SCROLL_NEVER
    }

    private fun tapTarget(view: View, x: Float, y: Float): View? {
        if (x < 0 || y < 0 || x >= view.width || y >= view.height || view.visibility != View.VISIBLE) return null
        if (view is ViewGroup) {
            for (index in view.childCount - 1 downTo 0) {
                val child = view.getChildAt(index)
                tapTarget(child, x - child.left, y - child.top)?.let { return it }
            }
        }
        return view
    }

    private fun shouldDismissKeyboard(scroller: View, event: android.view.MotionEvent): Boolean {
        if (keyboardShouldPersistTaps == "always") return false
        return when (keyboardShouldPersistTaps) {
            "handled" -> (scroller as? ViewGroup)?.let { tapTarget(it, event.x, event.y)?.isClickable != true } ?: true
            else -> true
        }
    }

    fun setPagingEnabled(value: Boolean) {
        pagingEnabled = value
    }

    private fun snapToPage(scroller: View) {
        val horizontal = horizontalMode == true
        val pageSize = if (horizontal) scroller.width else scroller.height
        if (pageSize <= 0) return
        val offset = if (horizontal) scroller.scrollX else scroller.scrollY
        val target = (offset.toFloat() / pageSize).roundToInt() * pageSize
        if (horizontal) {
            (scroller as HorizontalScrollView).smoothScrollTo(target, 0)
        } else {
            (scroller as ScrollView).smoothScrollTo(0, target)
        }
    }

    fun setScrollIndicators(verticalVisible: Boolean, horizontalVisible: Boolean) {
        vertical.isVerticalScrollBarEnabled = verticalVisible
        horizontal.isHorizontalScrollBarEnabled = horizontalVisible
    }

    fun setScrollListeners(
        onScroll: ((Int, Int) -> Unit)?,
        onBeginDrag: (() -> Unit)?,
        onEndDrag: (() -> Unit)?,
        onMomentumBegin: (() -> Unit)?,
        onMomentumEnd: (() -> Unit)?,
        keyboardDismissMode: String,
        dismissKeyboard: (() -> Unit)?,
    ) {
        fun attach(scroller: View) {
            var dismissed = false
            var moved = false
            var momentumActive = false
            var lastX = 0
            var lastY = 0

            fun pollMomentum() {
                if (!momentumActive) return
                val x = scroller.scrollX
                val y = scroller.scrollY
                if (x == lastX && y == lastY) {
                    momentumActive = false
                    onMomentumEnd?.invoke()
                } else {
                    lastX = x
                    lastY = y
                    scroller.postDelayed({ pollMomentum() }, 16L)
                }
            }

            scroller.setOnScrollChangeListener { _, x, y, _, _ -> onScroll?.invoke(x, y) }
            scroller.setOnTouchListener { _, event ->
                when (event.actionMasked) {
                    android.view.MotionEvent.ACTION_DOWN -> {
                        if (momentumActive) {
                            momentumActive = false
                            onMomentumEnd?.invoke()
                        }
                        dismissed = false
                        moved = false
                        onBeginDrag?.invoke()
                    }
                    android.view.MotionEvent.ACTION_MOVE -> {
                        moved = true
                        if (!dismissed && keyboardDismissMode in setOf("on-drag", "interactive")) {
                            dismissed = true
                            dismissKeyboard?.invoke()
                        }
                    }
                    android.view.MotionEvent.ACTION_UP, android.view.MotionEvent.ACTION_CANCEL -> {
                        if (event.actionMasked == android.view.MotionEvent.ACTION_UP && shouldDismissKeyboard(scroller, event)) {
                            dismissKeyboard?.invoke()
                        }
                        onEndDrag?.invoke()
                        if (pagingEnabled) snapToPage(scroller)
                        if (moved && !momentumActive) {
                            momentumActive = true
                            lastX = scroller.scrollX
                            lastY = scroller.scrollY
                            onMomentumBegin?.invoke()
                            scroller.postDelayed({ pollMomentum() }, 16L)
                        }
                    }
                }
                false
            }
        }
        attach(vertical)
        attach(horizontal)
    }
}

private class CraftNativeFlexSpacer(context: Context) : View(context)

/**
 * A small, dependency-free native icon surface for Android.
 *
 * STX resolves Iconify names to the SF Symbol name that iOS draws. Android
 * does not ship SF Symbols, so the maintained host uses the corresponding
 * Unicode glyph for the common cross-platform symbols and a hollow circle for
 * an unknown symbol. Keeping this as a TextView gives the glyph the same
 * intrinsic measurement, tint, accessibility, and reconciliation behavior as
 * the other native leaf controls without adding an icon-font dependency.
 */
private class CraftNativeIconView(context: Context) : TextView(context) {
    /** The app's vector for the icon (CraftNativeIcons), drawn in place of the glyph. */
    var vector: Drawable? = null
        set(value) {
            field = value
            invalidate()
        }

    init {
        includeFontPadding = false
        gravity = Gravity.CENTER
        setPadding(0, 0, 0, 0)
        isSingleLine = true
    }

    override fun onDraw(canvas: Canvas) {
        val icon = vector ?: return super.onDraw(canvas)
        // A single-line TextView keeps a horizontal scroll from centring its
        // text in a max-content measure (half a million pixels): the canvas
        // arrives scrolled, so the box is placed where the view is.
        icon.setBounds(scrollX + paddingLeft, scrollY + paddingTop, scrollX + width - paddingRight, scrollY + height - paddingBottom)
        icon.draw(canvas)
    }
}

private class CraftNativeModalView(context: Context) : FrameLayout(context) {
    val content = CraftNativeFlexLayout(context)
    private val blocker = View(context)
    private var renderedVisible = false
    private var dismissSuppressedByRequest = false
    private var animationGeneration = 0
    var onRequestClose: (() -> Unit)? = null

    var transparent: Boolean = false
        set(value) {
            field = value
            blocker.setBackgroundColor(if (value) Color.TRANSPARENT else Color.argb(82, 0, 0, 0))
        }

    init {
        isClickable = true
        blocker.isClickable = true
        blocker.setOnTouchListener { _, event ->
            if (event.action == MotionEvent.ACTION_UP) requestClose()
            true
        }
        blocker.setBackgroundColor(Color.argb(82, 0, 0, 0))
        addView(blocker, LayoutParams(-1, -1))
        addView(content, LayoutParams(-1, -1))
    }

    fun requestClose() {
        val handler = onRequestClose ?: return
        dismissSuppressedByRequest = true
        isClickable = false
        blocker.isEnabled = false
        handler()
    }

    fun consumeDismissSuppression(): Boolean {
        val suppressed = dismissSuppressedByRequest
        dismissSuppressedByRequest = false
        return suppressed
    }

    fun clearDismissSuppression() {
        dismissSuppressedByRequest = false
    }

    fun setVisible(visible: Boolean, opacity: Float, animationType: String?) {
        if (visible) {
            isClickable = true
            blocker.isEnabled = true
        }
        if (renderedVisible == visible && visibility == if (visible) View.VISIBLE else View.GONE) {
            if (visible && alpha != opacity) alpha = opacity
            return
        }
        val wasVisible = renderedVisible && visibility == View.VISIBLE
        renderedVisible = visible
        animationGeneration += 1
        val generation = animationGeneration
        animate().cancel()
        if (!visible) {
            if (animationType == "slide" && wasVisible) {
                val distance = max(height, (parent as? View)?.height ?: resources.displayMetrics.heightPixels).toFloat()
                animate().translationY(distance).alpha(0f).setDuration(240L).withEndAction {
                    if (animationGeneration != generation) return@withEndAction
                    visibility = View.GONE
                    translationY = 0f
                    alpha = 0f
                }.start()
            } else {
                alpha = 0f
                translationY = 0f
                visibility = View.GONE
            }
            return
        }
        visibility = View.VISIBLE
        if (animationType == "none") {
            translationY = 0f
            alpha = opacity
        } else if (animationType == "slide") {
            alpha = opacity
            translationY = max(height, (parent as? View)?.height ?: resources.displayMetrics.heightPixels).toFloat()
            post {
                if (animationGeneration != generation || visibility != View.VISIBLE) return@post
                val distance = max(height, (parent as? View)?.height ?: resources.displayMetrics.heightPixels).toFloat()
                translationY = distance
                animate().translationY(0f).setDuration(240L).start()
            }
        } else {
            translationY = 0f
            alpha = 0f
            animate().alpha(opacity).setDuration(180L).start()
        }
    }

    fun resetForTeardown() {
        animationGeneration += 1
        animate().cancel()
        visibility = View.GONE
        translationY = 0f
        alpha = 0f
        isClickable = true
        blocker.isEnabled = true
        dismissSuppressedByRequest = false
        onRequestClose = null
    }
}

private data class LayoutBounds(
    val x: Double,
    val y: Double,
    val width: Double,
    val height: Double,
)

/**
 * Android's default spinner style is indeterminate-only, so assigning
 * `isIndeterminate = false` to it is silently ignored. Use a determinate
 * ProgressBar style and carry over the platform spinner drawable instead;
 * that preserves the native look while allowing `animating={false}` to be a
 * genuinely stopped control.
 */
private class CraftNativeActivityIndicator(context: Context) :
    android.widget.ProgressBar(context, null, android.R.attr.progressBarStyleHorizontal) {
    init {
        val spinner = android.widget.ProgressBar(context).indeterminateDrawable
        indeterminateDrawable = spinner
        progressDrawable = spinner?.constantState?.newDrawable()?.mutate() ?: spinner
    }
}

/** Android counterpart to iOS's UIDatePicker-backed native DatePicker. */
private class CraftNativeDatePickerView(context: Context) : FrameLayout(context) {
    private enum class PickerMode { DATE, TIME, DATE_TIME, COUNTDOWN }
    private val maxCountdownSeconds = 23 * 3600 + 59 * 60 + 59

    private var pickerMode: PickerMode? = null
    private var datePicker: DatePicker? = null
    private var timePicker: TimePicker? = null
    private var defaultDateBounds: Pair<Long, Long>? = null
    private var minuteInterval = 1
    private var countdownSecond = 0
    private var suppressChanges = true
    var onValueChanged: (() -> Unit)? = null

    init {
        isFocusable = true
    }

    fun configure(props: JSONObject) {
        val requestedMode = when (props.optString("mode")) {
            "time" -> PickerMode.TIME
            "datetime", "dateAndTime", "datetime-local" -> PickerMode.DATE_TIME
            "countdown" -> PickerMode.COUNTDOWN
            else -> PickerMode.DATE
        }
        if (pickerMode != requestedMode) {
            pickerMode = requestedMode
            datePicker = null
            timePicker = null
            removeAllViews()
            val content = LinearLayout(context).apply {
                orientation = LinearLayout.VERTICAL
                gravity = Gravity.CENTER
            }
            if (requestedMode == PickerMode.DATE || requestedMode == PickerMode.DATE_TIME) {
                datePicker = DatePicker(context).also { picker ->
                    defaultDateBounds = picker.minDate to picker.maxDate
                    val today = Calendar.getInstance()
                    picker.init(today.get(Calendar.YEAR), today.get(Calendar.MONTH), today.get(Calendar.DAY_OF_MONTH)) { _, _, _, _ -> changed() }
                    content.addView(picker, LinearLayout.LayoutParams(
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                    ))
                }
            }
            if (requestedMode != PickerMode.DATE) {
                timePicker = TimePicker(context).also { picker ->
                    picker.setIs24HourView(true)
                    picker.setOnTimeChangedListener { _, _, _ -> changed() }
                    content.addView(picker, LinearLayout.LayoutParams(
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                    ))
                }
            }
            addView(content, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
        }

        suppressChanges = true
        minuteInterval = props.optInt("minuteInterval", 1).takeIf { it in 1..30 && 60 % it == 0 } ?: 1
        val defaults = defaultDateBounds
        datePicker?.minDate = pickerDate(props.opt("minimumDate"))?.timeInMillis ?: defaults?.first ?: datePicker?.minDate ?: 0L
        datePicker?.maxDate = pickerDate(props.opt("maximumDate"))?.timeInMillis ?: defaults?.second ?: datePicker?.maxDate ?: Long.MAX_VALUE
        if (requestedMode == PickerMode.COUNTDOWN) {
            countdownSecond = 0
            countdownSeconds(props.opt("value"))?.let { applyCountdown(it) }
        } else {
            pickerDate(props.opt("value"))?.let { applyDate(it) }
        }
        val enabled = !props.optBoolean("disabled", false)
        isEnabled = enabled
        datePicker?.isEnabled = enabled
        timePicker?.isEnabled = enabled
        for (index in 0 until childCount) getChildAt(index).isEnabled = enabled
        suppressChanges = false
    }

    fun event(): JSONObject {
        if (pickerMode == PickerMode.COUNTDOWN) {
            val seconds = currentCountdownSeconds()
            return JSONObject()
                .put("value", formatCountdown(seconds))
                .put("iso", "PT${seconds}S")
                .put("timestamp", seconds * 1000L)
        }
        val current = currentDate()
        val valueFormat = when (pickerMode) {
            PickerMode.DATE -> "yyyy-MM-dd"
            PickerMode.TIME -> "HH:mm"
            else -> "yyyy-MM-dd'T'HH:mm"
        }
        val value = SimpleDateFormat(valueFormat, Locale.US).apply { isLenient = false }.format(current.time)
        val iso = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSXXX", Locale.US).format(current.time)
        return JSONObject().put("value", value).put("iso", iso).put("timestamp", current.timeInMillis)
    }

    private fun changed() {
        if (suppressChanges) return
        // A date-only picker has no time half to snap, but its change is
        // still the screen's to hear.
        timePicker?.let { picker ->
            val snapped = ((picker.minute + minuteInterval / 2) / minuteInterval * minuteInterval).coerceAtMost(59)
            if (snapped != picker.minute) {
                suppressChanges = true
                picker.minute = snapped
                suppressChanges = false
            }
        }
        onValueChanged?.invoke()
    }

    private fun applyDate(value: Calendar) {
        datePicker?.updateDate(value.get(Calendar.YEAR), value.get(Calendar.MONTH), value.get(Calendar.DAY_OF_MONTH))
        timePicker?.hour = value.get(Calendar.HOUR_OF_DAY)
        timePicker?.minute = value.get(Calendar.MINUTE)
    }

    private fun applyCountdown(seconds: Int) {
        countdownSecond = seconds % 60
        timePicker?.hour = (seconds / 3600).coerceIn(0, 23)
        timePicker?.minute = (seconds % 3600 / 60).coerceIn(0, 59)
    }

    private fun currentCountdownSeconds(): Int = timePicker?.let { it.hour * 3600 + it.minute * 60 + countdownSecond } ?: 0

    private fun formatCountdown(seconds: Int): String = "%02d:%02d:%02d".format(
        Locale.US,
        seconds / 3600,
        seconds % 3600 / 60,
        seconds % 60,
    )

    private fun currentDate(): Calendar = Calendar.getInstance().also { current ->
        datePicker?.let {
            current.set(Calendar.YEAR, it.year)
            current.set(Calendar.MONTH, it.month)
            current.set(Calendar.DAY_OF_MONTH, it.dayOfMonth)
        }
        timePicker?.let {
            current.set(Calendar.HOUR_OF_DAY, it.hour)
            current.set(Calendar.MINUTE, it.minute)
            current.set(Calendar.SECOND, 0)
            current.set(Calendar.MILLISECOND, 0)
        }
    }

    private fun pickerDate(value: Any?): Calendar? {
        if (value is Number && value !is Boolean) {
            val milliseconds = value.toDouble()
            if (!milliseconds.isFinite()) return null
            return runCatching { Calendar.getInstance().apply { timeInMillis = milliseconds.toLong() } }.getOrNull()
        }
        val text = value?.toString()?.trim().orEmpty()
        if (text.isBlank() || text == JSONObject.NULL.toString()) return null
        val formats = listOf(
            "HH:mm", "HH:mm:ss", "yyyy-MM-dd", "yyyy-MM-dd'T'HH:mm",
            "yyyy-MM-dd'T'HH:mm:ss", "yyyy-MM-dd'T'HH:mm:ss.SSSXXX", "yyyy-MM-dd'T'HH:mm:ssX",
        )
        formats.firstNotNullOfOrNull { format ->
            runCatching {
                SimpleDateFormat(format, Locale.US).apply { isLenient = false }.parse(text)
            }.getOrNull()
        }?.let { parsed ->
            return Calendar.getInstance().apply { time = parsed }
        }
        return null
    }

    private fun countdownSeconds(value: Any?): Int? {
        if (value is Number && value !is Boolean) {
            val seconds = value.toDouble()
            if (!seconds.isFinite()) return null
            return seconds.coerceIn(0.0, maxCountdownSeconds.toDouble()).roundToInt()
        }
        val text = value?.toString()?.trim().orEmpty()
        if (text.isBlank() || text == JSONObject.NULL.toString()) return null
        text.toDoubleOrNull()?.takeIf { it.isFinite() }?.let { return it.coerceIn(0.0, maxCountdownSeconds.toDouble()).roundToInt() }
        val parts = text.split(':')
        if (parts.size != 2 && parts.size != 3) return null
        val hours = parts[0].toDoubleOrNull() ?: return null
        val minutes = parts[1].toDoubleOrNull() ?: return null
        val seconds = if (parts.size == 3) parts[2].toDoubleOrNull() ?: return null else 0.0
        if (!hours.isFinite() || !minutes.isFinite() || !seconds.isFinite() ||
            hours < 0 || minutes !in 0.0..<60.0 || seconds !in 0.0..<60.0) return null
        return (hours * 3600 + minutes * 60 + seconds).coerceIn(0.0, maxCountdownSeconds.toDouble()).roundToInt()
    }
}

private class CraftNativeVideoView(context: Context) : VideoView(context) {
    private var sourceUri = ""
    private var shouldLoop = false
    private var shouldPlay = false
    private var muted = false
    private var resizeMode = "contain"
    private var preparedPlayer: MediaPlayer? = null

    fun configure(source: Any?, autoplay: Boolean, paused: Boolean, loop: Boolean, muted: Boolean, controls: Boolean, resizeMode: String?) {
        val uri = when (source) {
            is String -> source
            is JSONObject -> craftNativeOptionalString(source.opt("uri")).orEmpty()
            else -> ""
        }
        shouldLoop = loop
        shouldPlay = autoplay && !paused
        this.muted = muted
        this.resizeMode = resizeMode?.lowercase()?.takeIf { it in setOf("cover", "contain", "stretch", "center") } ?: "contain"
        applyScalingMode()
        setMediaController(if (controls) MediaController(context).also { it.setAnchorView(this) } else null)
        if (uri != sourceUri) {
            sourceUri = uri
            stopPlayback()
            preparedPlayer = null
            if (uri.isBlank()) return
            // A copy kept on the phone (craft.media.keep) plays in place of
            // the address: offline in a gym with no signal.
            val kept = CraftNativeMedia.local(context, uri)
            setVideoURI(if (kept != null) Uri.fromFile(kept) else Uri.parse(uri))
            setOnPreparedListener { mediaPlayer ->
                preparedPlayer = mediaPlayer
                applyScalingMode()
                mediaPlayer.isLooping = shouldLoop
                val volume = if (this.muted) 0f else 1f
                mediaPlayer.setVolume(volume, volume)
                if (shouldPlay) start()
            }
            setOnCompletionListener { if (shouldLoop && !isPlaying) start() }
        }
        if (uri.isBlank()) return
        runCatching {
            if (shouldPlay && !isPlaying) start()
            else if (!shouldPlay && isPlaying) pause()
        }
    }

    fun stop() {
        stopPlayback()
        sourceUri = ""
        preparedPlayer = null
    }

    private fun applyScalingMode() {
        preparedPlayer?.setVideoScalingMode(
            if (resizeMode == "cover") MediaPlayer.VIDEO_SCALING_MODE_SCALE_TO_FIT_WITH_CROPPING
            else MediaPlayer.VIDEO_SCALING_MODE_SCALE_TO_FIT,
        )
    }
}

/** The oscillator/gain subset of Web Audio used by native STX screens. */
private class CraftNativeAudio {
    private data class ParameterEvent(val time: Double, val value: Double, val ramp: Boolean)

    private class Parameter(initial: Double) {
        private var current = initial
        private val events = mutableListOf<ParameterEvent>()

        @Synchronized fun set(value: Double) {
            current = value
            events.clear()
        }

        @Synchronized fun schedule(value: Double, time: Double, ramp: Boolean) {
            events += ParameterEvent(time.coerceAtLeast(0.0), value, ramp)
            events.sortBy { it.time }
        }

        @Synchronized fun valueAt(time: Double): Double {
            var previousTime = 0.0
            var previousValue = current
            for (event in events) {
                if (time < event.time) {
                    if (!event.ramp || event.time <= previousTime) return previousValue
                    val fraction = (time - previousTime) / (event.time - previousTime)
                    return previousValue + (event.value - previousValue) * fraction
                }
                previousTime = event.time
                previousValue = event.value
            }
            return previousValue
        }
    }

    private class OscillatorState {
        val frequency = Parameter(440.0)
        @Volatile var gain = Parameter(1.0)
        @Volatile var phase = 0.0
        @Volatile var active = false
        var contextStart = 0.0
    }

    private val handler = Handler(Looper.getMainLooper())
    private val oscillators = mutableMapOf<String, OscillatorState>()
    private val gains = mutableMapOf<String, Parameter>()
    private val contextStarts = mutableMapOf<String, Double>()
    private var track: AudioTrack? = null
    @Volatile private var running = false
    private var renderThread: Thread? = null

    @Synchronized fun handle(payload: JSONObject) {
        when (payload.optString("action")) {
            "createContext" -> {
                payload.optString("contextId").takeIf { it.isNotBlank() }?.let {
                    contextStarts[it] = System.nanoTime() / 1_000_000_000.0
                }
            }
            "createOscillator" -> {
                val id = payload.optString("nodeId")
                if (id.isNotBlank()) oscillators.putIfAbsent(id, OscillatorState()).also {
                    oscillators[id]?.contextStart = contextStarts[payload.optString("contextId")]
                        ?: (System.nanoTime() / 1_000_000_000.0)
                    oscillators[id]?.frequency?.set(payload.optDouble("frequency", 440.0).coerceAtLeast(0.0))
                }
            }
            "createGain" -> {
                val id = payload.optString("nodeId")
                if (id.isNotBlank()) gains[id] = Parameter(payload.optDouble("gain", 1.0).coerceAtLeast(0.0))
            }
            "connect" -> {
                val source = payload.optString("sourceId")
                oscillators[source]?.gain = gains[payload.optString("destinationId")] ?: Parameter(1.0)
            }
            "frequency" -> oscillators[payload.optString("nodeId")]?.frequency?.set(payload.optDouble("value", 0.0).coerceAtLeast(0.0))
            "frequencyAtTime", "frequencyRampToTime" -> oscillators[payload.optString("nodeId")]?.frequency?.schedule(
                payload.optDouble("value", 0.0).coerceAtLeast(0.0),
                payload.optDouble("time", 0.0),
                payload.optString("action") == "frequencyRampToTime",
            )
            "gain" -> gains[payload.optString("nodeId")]?.set(payload.optDouble("value", 0.0).coerceAtLeast(0.0))
            "gainAtTime", "gainRampToTime" -> gains[payload.optString("nodeId")]?.schedule(
                payload.optDouble("value", 0.0).coerceAtLeast(0.0),
                payload.optDouble("time", 0.0),
                payload.optString("action") == "gainRampToTime",
            )
            "start", "stop" -> {
                val state = oscillators[payload.optString("nodeId")] ?: return
                ensureTrack()
                val active = payload.optString("action") == "start"
                val delay = (payload.optDouble("delay", 0.0).coerceAtLeast(0.0) * 1000).roundToLong()
                handler.postDelayed({ state.active = active }, delay)
            }
            "close" -> close()
        }
    }

    @Synchronized fun close() {
        oscillators.values.forEach { it.active = false }
        oscillators.clear()
        gains.clear()
        contextStarts.clear()
        running = false
        renderThread?.interrupt()
        renderThread = null
        track?.let { output ->
            runCatching {
                output.pause()
                output.flush()
                output.release()
            }
        }
        track = null
    }

    @Synchronized private fun ensureTrack() {
        if (track != null) return
        val sampleRate = 44_100
        val minBuffer = AudioTrack.getMinBufferSize(sampleRate, AudioFormat.CHANNEL_OUT_STEREO, AudioFormat.ENCODING_PCM_16BIT)
        val format = AudioFormat.Builder()
            .setSampleRate(sampleRate)
            .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
            .setChannelMask(AudioFormat.CHANNEL_OUT_STEREO)
            .build()
        val attributes = AudioAttributes.Builder()
            .setUsage(AudioAttributes.USAGE_MEDIA)
            .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
            .build()
        val created = AudioTrack.Builder()
            .setAudioAttributes(attributes)
            .setAudioFormat(format)
            .setBufferSizeInBytes(max(minBuffer, sampleRate / 4))
            .setTransferMode(AudioTrack.MODE_STREAM)
            .build()
        track = created
        running = true
        created.play()
        renderThread = Thread({ render(created, sampleRate) }, "craft-native-audio").also { it.start() }
    }

    private fun render(output: AudioTrack, sampleRate: Int) {
        val buffer = ShortArray(1024 * 2)
        while (running && !Thread.currentThread().isInterrupted) {
            val snapshot = synchronized(this) {
                oscillators.mapValues { (id, state) ->
                    Triple(state, state.gain, state.active)
                }
            }
            val now = System.nanoTime() / 1_000_000_000.0
            for (frame in 0 until 1024) {
                var sample = 0.0
                snapshot.forEach { (_, value) ->
                    val (state, gain, active) = value
                    if (!active) return@forEach
                    val time = (now - state.contextStart).coerceAtLeast(0.0) + frame.toDouble() / sampleRate
                    val frequency = state.frequency.valueAt(time)
                    sample += sin(state.phase) * gain.valueAt(time)
                    state.phase += 2 * PI * frequency / sampleRate
                    if (state.phase >= 2 * PI) state.phase -= 2 * PI
                }
                val value = (sample.coerceIn(-1.0, 1.0) * Short.MAX_VALUE).toInt().toShort()
                buffer[frame * 2] = value
                buffer[frame * 2 + 1] = value
            }
            if (output.write(buffer, 0, buffer.size, AudioTrack.WRITE_BLOCKING) < 0) break
        }
    }
}

private class CraftTextDecorationSpan(
    private val line: String,
    private val style: String,
    private val decorationColor: Int?,
) : ReplacementSpan() {
    override fun getSize(paint: Paint, text: CharSequence, start: Int, end: Int, fm: Paint.FontMetricsInt?): Int {
        return ceil(paint.measureText(text, start, end).toDouble()).toInt()
    }

    override fun draw(
        canvas: Canvas,
        text: CharSequence,
        start: Int,
        end: Int,
        x: Float,
        top: Int,
        y: Int,
        bottom: Int,
        paint: Paint,
    ) {
        val originalColor = paint.color
        val originalStyle = paint.style
        val originalStrokeWidth = paint.strokeWidth
        val originalPathEffect = paint.pathEffect
        val originalStrokeCap = paint.strokeCap
        paint.style = Paint.Style.FILL
        paint.pathEffect = null
        canvas.drawText(text, start, end, x, y.toFloat(), paint)

        val width = paint.measureText(text, start, end)
        val thickness = max(1f, paint.textSize / 16f)
        val underlineY = y + max(1f, paint.descent() * 0.15f)
        val strikeY = y - paint.textSize * 0.3f
        val decoration = decorationColor ?: originalColor
        paint.color = decoration
        paint.style = Paint.Style.STROKE
        paint.strokeWidth = thickness
        paint.strokeCap = if (style == "dotted") Paint.Cap.ROUND else Paint.Cap.BUTT
        paint.pathEffect = when (style) {
            "dashed" -> DashPathEffect(floatArrayOf(paint.textSize * 0.35f, paint.textSize * 0.25f), 0f)
            "dotted" -> DashPathEffect(floatArrayOf(thickness, paint.textSize * 0.22f), 0f)
            else -> null
        }

        fun drawLine(position: Float) {
            canvas.drawLine(x, position, x + width, position, paint)
        }
        if (line == "underline" || line == "underline line-through") {
            drawLine(underlineY)
            if (style == "double") drawLine(underlineY + thickness * 2.5f)
        }
        if (line == "line-through" || line == "underline line-through") {
            drawLine(strikeY)
            if (style == "double") drawLine(strikeY + thickness * 2.5f)
        }

        paint.color = originalColor
        paint.style = originalStyle
        paint.strokeWidth = originalStrokeWidth
        paint.pathEffect = originalPathEffect
        paint.strokeCap = originalStrokeCap
    }
}

private class CraftNativeSideBorderDrawable(
    private val fillColor: Int,
    private val radii: FloatArray,
    private val widths: IntArray,
    private val colors: IntArray,
) : Drawable() {
    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)

    override fun draw(canvas: Canvas) {
        val bounds = RectF(this.bounds)
        paint.style = Paint.Style.FILL
        paint.color = fillColor
        if (Color.alpha(fillColor) > 0) {
            val path = Path().apply { addRoundRect(bounds, radii, Path.Direction.CW) }
            canvas.drawPath(path, paint)
        }
        val top = widths.getOrElse(0) { 0 }
        val right = widths.getOrElse(1) { 0 }
        val bottom = widths.getOrElse(2) { 0 }
        val left = widths.getOrElse(3) { 0 }
        if (top > 0) { paint.color = colors.getOrElse(0) { Color.TRANSPARENT }; canvas.drawRect(bounds.left, bounds.top, bounds.right, bounds.top + top, paint) }
        if (right > 0) { paint.color = colors.getOrElse(1) { Color.TRANSPARENT }; canvas.drawRect(bounds.right - right, bounds.top, bounds.right, bounds.bottom, paint) }
        if (bottom > 0) { paint.color = colors.getOrElse(2) { Color.TRANSPARENT }; canvas.drawRect(bounds.left, bounds.bottom - bottom, bounds.right, bounds.bottom, paint) }
        if (left > 0) { paint.color = colors.getOrElse(3) { Color.TRANSPARENT }; canvas.drawRect(bounds.left, bounds.top, bounds.left + left, bounds.bottom, paint) }
    }

    override fun setAlpha(alpha: Int) { paint.alpha = alpha; invalidateSelf() }
    override fun setColorFilter(colorFilter: ColorFilter?) { paint.colorFilter = colorFilter; invalidateSelf() }
    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
}

/** WebView-free host for a route bundle compiled by `stx native compile`. */
class MainActivity : AppCompatActivity() {
    private class Screen(
        val route: String?,
        val params: JSONObject,
        val view: CraftNativeFlexLayout,
        val isolate: JavaScriptIsolate,
        val port: MessagePort?,
        /** The app script (`nativeApp`): runs beside the screens and draws nothing. */
        val headless: Boolean = false,
    ) {
        /** What the screen set with `craft.navigation.setOptions`, merged. */
        var options = JSONObject()
        /** Overrides from a native `<StatusBar>` node, reset on each render. */
        var statusBarStyle: String? = null
        var statusBarHidden: Boolean? = null
        /** Shown before: its next showing is a `SCREEN_FOCUS`. */
        var shown = false
        /** The app path it was opened for (`/m/workout/42`), to find it again. */
        var path: String? = null
        /** Long messages from the console bridge, put back together. */
        val chunks = CraftNativeChunks()
        /** A `requestAnimationFrame` is waiting for the next frame. */
        var frameRequested = false
        /** The screen's timers (`setTimeout`), kept by the host. */
        val timers = mutableMapOf<Int, Runnable>()
        val drafts = mutableMapOf<String, String>()
        val inputIdentities = mutableMapOf<EditText, String>()
        val suppressedTextChanges = mutableSetOf<EditText>()
        /**
         * The texts a field sent the screen that its `value` has not come
         * back as yet, oldest first. Typing faster than the round trip makes
         * the screen answer with a value the field has already moved past;
         * that echo is not written back over what was typed since.
         */
        val inputEchoes = mutableMapOf<EditText, ArrayDeque<String>>()
        val controls = mutableMapOf<String, View>()
        // Protocol ids identify mutation targets; authored keys identify the
        // retained view. Keep both mappings so a targeted update can recover
        // the original tree path without manufacturing a detached view.
        val nodeViews = mutableMapOf<String, View>()
        val nodePaths = mutableMapOf<String, String>()
        val handlers = mutableMapOf<View, String>()
        val linkTargets = mutableMapOf<View, String>()
        val pressInHandlers = mutableMapOf<View, String>()
        val pressOutHandlers = mutableMapOf<View, String>()
        val longPressHandlers = mutableMapOf<View, String>()
        val scrollHandlers = mutableMapOf<View, String>()
        val scrollBeginHandlers = mutableMapOf<View, String>()
        val scrollEndHandlers = mutableMapOf<View, String>()
        val scrollMomentumBeginHandlers = mutableMapOf<View, String>()
        val scrollMomentumEndHandlers = mutableMapOf<View, String>()
        val sliderCompleteHandlers = mutableMapOf<View, String>()
        val sliderSteps = mutableMapOf<View, Double>()
        val focusHandlers = mutableMapOf<View, String>()
        val blurHandlers = mutableMapOf<View, String>()
        val endEditingHandlers = mutableMapOf<View, String>()
        val submitHandlers = mutableMapOf<View, String>()
        val imageLoadStartHandlers = mutableMapOf<ImageView, String>()
        val imageLoadHandlers = mutableMapOf<ImageView, String>()
        val imageLoadEndHandlers = mutableMapOf<ImageView, String>()
        val imageErrorHandlers = mutableMapOf<ImageView, String>()
        val pressActiveOpacities = mutableMapOf<View, Float>()
        val pressBaseOpacities = mutableMapOf<View, Float>()
        val modalVisibility = mutableMapOf<View, Boolean>()
        val modalCloseHandlers = mutableMapOf<View, String>()
        val layoutHandlers = mutableMapOf<View, String>()
        val layoutListeners = mutableMapOf<View, View.OnLayoutChangeListener>()
        val lastLayoutBounds = mutableMapOf<View, LayoutBounds>()
        val flatListRows = mutableMapOf<CraftNativeFlatList, MutableMap<String, MutableMap<String, View>>>()
        val flatListOwners = mutableMapOf<String, String>()
        val flatListOwnerByView = mutableMapOf<CraftNativeFlatList, String>()
        val mutations = CraftNativeMutationDocument()
        val capabilityScope = UUID.randomUUID().toString()
        val pendingCapabilities = mutableSetOf<String>()
        val capabilityTimeouts = mutableMapOf<String, Runnable>()
        val audio = CraftNativeAudio()
        var active = true

        fun close() {
            if (!active) return
            active = false
            audio.close()
            val finish = {
                port?.close()
                isolate.close()
            }
            val teardown = runCatching {
                isolate.evaluateJavaScriptAsync(
                    "globalThis.__stxNativeUnmount && globalThis.__stxNativeUnmount()"
                )
            }.getOrNull()
            if (teardown == null) {
                finish()
                return
            }
            teardown.addListener({
                runCatching { teardown.get() }
                finish()
            }, java.util.concurrent.Executor { command -> command.run() })
        }
    }

    private lateinit var root: FrameLayout
    private var sandbox: JavaScriptSandbox? = null
    /** The stack on screen: the current tab's, or the only one in an app without tabs. */
    private var screens = mutableListOf<Screen>()
    private lateinit var routes: CraftNativeRoutes
    private lateinit var stores: CraftNativeStores
    private lateinit var services: CraftNativeServices
    private var chrome: CraftNativeChrome? = null
    private val tabStacks = mutableListOf<MutableList<Screen>>()
    private var currentTab = 0
    private var visibleScreen: Screen? = null
    private var tabSwipeTarget: Screen? = null
    private var tabSwipeTargetIndex = -1
    private var tabSwipeDirection = 0
    /** The app script's isolate (`nativeApp`), when the app has one. */
    private var appScreen: Screen? = null
    private val urlSchemes = mutableSetOf<String>()
    /** Background refreshes the running app script was handed, by id, until it answers. */
    private val backgroundWaiters = mutableMapOf<String, (Boolean) -> Unit>()
    /** A tapped notification that opened the app, for the app script once it runs. */
    private var pendingNotificationTap: JSONObject? = null
    private var bundle = ""
    private lateinit var config: JSONObject
    private lateinit var capabilities: CraftNativeCapabilities
    private val capabilityHandler = Handler(Looper.getMainLooper())
    private var hapticsEnabled = false
    private var clipboardEnabled = false
    internal var nativeAppState = "inactive"
        private set
    private var deliveredInitialDeepLink = false
    private var initialDeepLink: Uri? = null
    private var initialDeepLinkClaimed = false
    private var defaultTextColor = Color.WHITE
    private var windowSafeInsets = intArrayOf(0, 0, 0, 0)
    private var useMessagePorts = false
    private val imageExecutor = Executors.newFixedThreadPool(2)
    /** Lays out each isolate's prelude (the synchronous stores) off the main thread. */
    private val preludeExecutor = Executors.newSingleThreadExecutor()
    private val imageSources = mutableMapOf<ImageView, String>()
    private val imageJobs = mutableMapOf<ImageView, Future<*>>()
    private val imageErrors = mutableMapOf<ImageView, String>()
    private val inputHintDefaults = mutableMapOf<EditText, ColorStateList>()
    /** Fields that already carry their text watcher. */
    private val watchedInputs: MutableSet<EditText> = java.util.Collections.newSetFromMap(WeakHashMap())
    private val inputHighlightDefaults = mutableMapOf<EditText, Int>()
    private val defaultBackgrounds = mutableMapOf<View, Drawable?>()
    private var keyboardInset = 0
    private var animationScaleObserverRegistered = false
    private val animationScaleObserver = object : ContentObserver(Handler(Looper.getMainLooper())) {
        override fun onChange(selfChange: Boolean, uri: Uri?) {
            publishAppearance()
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        applyConfiguredAppearance()
        super.onCreate(savedInstanceState)
        initialDeepLink = savedInstanceState?.getString("craft.initialDeepLink")?.let(Uri::parse) ?: intent?.data
        initialDeepLinkClaimed = savedInstanceState?.getBoolean("craft.initialDeepLinkClaimed", false) ?: false
        deliveredInitialDeepLink = savedInstanceState?.getBoolean("craft.deliveredInitialDeepLink", false) ?: false
        if (savedInstanceState == null) pendingNotificationTap = notificationTap(intent)
        setContentView(R.layout.activity_main)
        root = findViewById(R.id.native_root)
        ViewCompat.setOnApplyWindowInsetsListener(root) { view, insets ->
            val safe = insets.getInsets(WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout())
            val ime = insets.getInsets(WindowInsetsCompat.Type.ime())
            windowSafeInsets = intArrayOf(safe.left, safe.top, safe.right, safe.bottom)
            keyboardInset = max(0, ime.bottom - safe.bottom)
            updateSafeAreaViews()
            updateKeyboardAvoidingViews()
            view.requestLayout()
            view.post { screens.lastOrNull()?.takeIf { it.active }?.let(::emitLayoutEvents) }
            insets
        }
        ViewCompat.requestApplyInsets(root)
        config = runCatching {
            assets.open("craft.config.json").bufferedReader().use {
                JSONObject(it.readText())
            }
        }.getOrDefault(JSONObject())
        hapticsEnabled = config.optBoolean("enableHaptics", false)
        clipboardEnabled = config.optBoolean("enableClipboard", false)
        capabilities = CraftNativeCapabilities(this, config)
        routes = CraftNativeRoutes(config)
        stores = CraftNativeStores.get(this, config)
        services = CraftNativeServices(this, config) { this }
        services.onBackgroundComplete = { ok, id ->
            if (id == null) {
                val waiting = backgroundWaiters.values.toList()
                backgroundWaiters.clear()
                waiting.forEach { it(ok) }
            } else backgroundWaiters.remove(id)?.invoke(ok)
        }
        capabilities.storeObserver = { store, key, value -> stores.changed(store, key, value, null) }
        val schemes = config.optJSONArray("urlSchemes") ?: JSONArray()
        for (index in 0 until schemes.length()) urlSchemes.add(schemes.optString(index).lowercase())
        if (!routes.isEmpty) installChrome()
        refreshThemeDefaults()
        bundle = runCatching {
            assets.open("native-screen.js").bufferedReader().use { it.readText() }
        }.getOrElse {
            showError("Missing native-screen.js. Build with --native-bundle after compiling STX.")
            return
        }
        if (!JavaScriptSandbox.isSupported()) {
            showError("Native STX requires Android JavaScriptSandbox, which is unavailable on this device.")
            return
        }
        // One sandbox for the process, shared with a background refresh
        // (CraftNativeBackground.kt): an app may hold only one.
        CraftNativeSandbox.connect(applicationContext) { engine, error ->
            if (isDestroyed) return@connect
            if (engine == null) {
                Log.e(TAG, "JavaScriptSandbox connection failed", error)
                showError("Native STX JavaScript engine could not start: ${error?.message}")
                return@connect
            }
            sandbox = engine
            attachSandbox(engine)
        }
        if (!routes.isEmpty) CraftNativeBackground.schedule(applicationContext, config)
    }

    private fun applyConfiguredAppearance() {
        val configured = runCatching {
            assets.open("craft.config.json").bufferedReader().use { JSONObject(it.readText()) }
        }.getOrNull()
        val mode = when (configured?.optString("appearance")) {
            "light" -> AppCompatDelegate.MODE_NIGHT_NO
            "dark" -> AppCompatDelegate.MODE_NIGHT_YES
            "system" -> AppCompatDelegate.MODE_NIGHT_FOLLOW_SYSTEM
            else -> if (configured?.optBoolean("darkMode", true) == false) {
                AppCompatDelegate.MODE_NIGHT_NO
            } else {
                AppCompatDelegate.MODE_NIGHT_YES
            }
        }
        AppCompatDelegate.setDefaultNightMode(mode)
    }

    private fun attachSandbox(engine: JavaScriptSandbox) {
        useMessagePorts = engine.isFeatureSupported(JavaScriptSandbox.JS_FEATURE_MESSAGE_PORTS)
            && engine.isFeatureSupported(JavaScriptSandbox.JS_FEATURE_PROMISE_RETURN)
        if (!useMessagePorts && !engine.isFeatureSupported(JavaScriptSandbox.JS_FEATURE_CONSOLE_MESSAGING)) {
            showError("Native STX requires JavaScript message ports or console messaging, unavailable on this device.")
            return
        }
        Log.i(TAG, "Native STX bridge: ${if (useMessagePorts) "message ports" else "console callback"}")
        startApp()
    }

    /**
     * An app with `nativeScreens`: the app script, then the first tab (or
     * the screen the launch link names). A bundle with no route table opens
     * its initial screen, as it always did.
     */
    private fun startApp() {
        if (routes.isEmpty) {
            openScreen(null)
            return
        }
        config.optString("nativeApp").takeIf { it.isNotBlank() }?.let { route ->
            appScreen = openScreen(route, JSONObject(), headless = true)
        }
        val launch = initialDeepLink?.let { routes.appPath(it.toString(), urlSchemes) }
        if (launch != null) deliveredInitialDeepLink = true
        selectTab(routes.tabFor(launch ?: routes.initialPath)?.let { routes.tabs.indexOf(it) } ?: 0)
        if (launch != null && routes.tabFor(launch) == null) navigateOpen(launch, fromLink = true)
        else if (routes.tabs.isEmpty() && screens.isEmpty()) navigateOpen(routes.initialPath)
    }

    private fun installChrome() {
        val bars = CraftNativeChrome(this, routes.tabs)
        bars.layoutParams = FrameLayout.LayoutParams(-1, -1)
        bars.onBack = { onBackPressedDispatcherCompat() }
        bars.onButton = { id -> visibleScreen?.takeIf { it.active }?.let { send(it, "NAV_BUTTON", JSONObject().put("id", id)) } }
        bars.onTab = { index ->
            haptic()
            if (index == currentTab) popToRoot() else selectTab(index)
        }
        bars.onTabSwipeStart = { dx, x, y -> beginTabSwipe(dx, x, y) }
        bars.onTabSwipeMove = { dx -> updateTabSwipe(dx) }
        bars.onTabSwipeEnd = { dx, cancelled -> finishTabSwipe(dx, cancelled) }
        root.addView(bars)
        chrome = bars
        tabStacks.clear()
        repeat(maxOf(1, routes.tabs.size)) { tabStacks.add(mutableListOf()) }
        screens = tabStacks[0]
    }

    private fun onBackPressedDispatcherCompat() {
        @Suppress("DEPRECATION")
        onBackPressed()
    }

    private fun haptic() {
        if (!hapticsEnabled) return
        root.performHapticFeedback(android.view.HapticFeedbackConstants.KEYBOARD_TAP)
    }

    /** A tab chosen: its stack shows, its root screen opened the first time. */
    private fun selectTab(index: Int) {
        if (index !in tabStacks.indices) return
        currentTab = index
        screens = tabStacks[index]
        chrome?.selectTab(index)
        ensureTabRoot(index)?.let(::show)
    }

    /** Mount a tab's root without stealing focus, for an interactive swipe. */
    private fun ensureTabRoot(index: Int): Screen? {
        if (index !in tabStacks.indices) return null
        tabStacks[index].lastOrNull()?.let { return it }
        val previous = screens
        screens = tabStacks[index]
        val match = routes.tabs.getOrNull(index)?.let { routes.match(it.id) }
        val screen = if (match != null) openScreen(match.screen, match.params, showImmediately = false) else openScreen(null, showImmediately = false)
        screen?.path = match?.path
        screens = previous
        return screen
    }

    /** Start an interactive horizontal transition to the adjacent tab. */
    private fun beginTabSwipe(dx: Float, x: Float, y: Float): Boolean {
        if (tabSwipeTarget != null || screens.size != 1 || chrome?.tabSwipeEnabled != true) return false
        val direction = if (dx < 0) 1 else -1
        val targetIndex = currentTab + direction
        val current = visibleScreen ?: return false
        val target = ensureTabRoot(targetIndex) ?: return false
        val host = chrome?.content ?: return false
        if (target === current || host.width <= 0) return false
        if (horizontalScrollCanConsume(current.view, host, x, y, dx)) return false
        (target.view.parent as? ViewGroup)?.removeView(target.view)
        host.addView(target.view, FrameLayout.LayoutParams(-1, -1))
        target.view.translationX = if (direction > 0) host.width.toFloat() else -host.width.toFloat()
        current.view.translationX = 0f
        host.bringChildToFront(target.view)
        tabSwipeTarget = target
        tabSwipeTargetIndex = targetIndex
        tabSwipeDirection = direction
        chrome?.selectTab(targetIndex)
        return true
    }

    private fun updateTabSwipe(dx: Float) {
        val current = visibleScreen ?: return
        val target = tabSwipeTarget ?: return
        val width = (chrome?.content?.width ?: return).toFloat().coerceAtLeast(1f)
        val offset = dx.coerceIn(-width, width)
        target.view.translationX = (if (tabSwipeDirection > 0) width else -width) + offset
        current.view.translationX = offset
    }

    private fun finishTabSwipe(dx: Float, cancelled: Boolean) {
        val current = visibleScreen ?: return
        val target = tabSwipeTarget ?: return
        val host = chrome?.content ?: return
        val width = host.width.toFloat().coerceAtLeast(1f)
        val complete = !cancelled && kotlin.math.abs(dx) >= width * 0.28f
        val endOffset = if (complete) {
            if (tabSwipeDirection > 0) -width else width
        } else 0f
        val targetOffset = if (complete) 0f else if (tabSwipeDirection > 0) width else -width
        current.view.animate().translationX(endOffset).setDuration(180).start()
        target.view.animate().translationX(targetOffset).setDuration(180).withEndAction {
            target.view.animate().setListener(null)
            if (complete) {
                current.view.translationX = 0f
                currentTab = tabSwipeTargetIndex
                screens = tabStacks[currentTab]
                tabSwipeTarget = null
                tabSwipeTargetIndex = -1
                tabSwipeDirection = 0
                haptic()
                show(target)
            } else {
                host.removeView(target.view)
                current.view.translationX = 0f
                chrome?.selectTab(currentTab)
                tabSwipeTarget = null
                tabSwipeTargetIndex = -1
                tabSwipeDirection = 0
            }
        }.start()
    }

    private fun horizontalScrollCanConsume(view: View, host: ViewGroup, x: Float, y: Float, dx: Float): Boolean {
        val localX = x - view.left
        val localY = y - host.top - view.top
        if (view !is ViewGroup || localX < 0 || localY < 0 || localX > view.width || localY > view.height) return false
        for (index in view.childCount - 1 downTo 0) {
            val child = view.getChildAt(index)
            if (!child.isShown || localX < child.left || localX > child.right || localY < child.top || localY > child.bottom) continue
            if (child is android.widget.HorizontalScrollView && child.canScrollHorizontally(if (dx < 0) 1 else -1)) return true
            if (horizontalScrollCanConsume(child, host, localX - child.left, localY - child.top, dx)) return true
        }
        return false
    }

    /**
     * `craft.navigation.open(path)`: the tab whose root it is, the screen
     * that draws it (pushed on the current tab, or its params changed when
     * that screen is already in front), or, for a path no screen draws, the
     * page on the app's site in the in-app browser. Another site's address
     * opens in the browser too.
     */
    private fun navigateOpen(target: String, fromLink: Boolean = false) {
        val path = routes.appPath(target, urlSchemes)
        if (path == null) {
            openExternal(target)
            return
        }
        val match = routes.match(path)
        val tab = routes.tabFor(path)
        if (tab != null) {
            selectTab(routes.tabs.indexOf(tab))
            popToRoot()
            val root = screens.firstOrNull()
            if (root != null && match != null && match.params.length() > 0) {
                send(root, "ROUTE_PARAMS", JSONObject().put("params", match.params))
            }
            return
        }
        if (match == null) {
            routes.siteURL(path)?.let(::openExternal)
            return
        }
        // A link from outside opens under the tab that owns its path.
        if (fromLink) routes.tabOwning(path)?.let { owner ->
            val index = routes.tabs.indexOf(owner)
            if (index != currentTab) selectTab(index)
        }
        // Already in this stack (perhaps under others): back to it, with the params it was opened with now.
        val existing = screens.lastOrNull { it.path == match.path }
        if (existing != null) {
            while (screens.lastOrNull() !== existing) closeScreen(screens.removeAt(screens.lastIndex))
            show(existing)
            send(existing, "ROUTE_PARAMS", JSONObject().put("params", match.params))
            return
        }
        openScreen(match.screen, match.params)?.path = match.path
    }

    /** A page the app does not draw, in a Custom Tab over the app. */
    private fun openExternal(url: String) {
        services.perform("Browser", "open", JSONArray().put(url), {})
    }

    private fun openScreen(route: String?, params: JSONObject = JSONObject(), headless: Boolean = false, showImmediately: Boolean = true): Screen? {
        val engine = sandbox ?: return null
        val isolate = engine.createIsolate()
        val view = CraftNativeFlexLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = FrameLayout.LayoutParams(-1, -1)
        }
        var screen: Screen? = null
        val executor = ContextCompat.getMainExecutor(this)
        val token = UUID.randomUUID().toString()
        val prefix = "CRAFT_STX_$token:"
        val port = if (useMessagePorts) {
            isolate.createMessageChannel("craft", executor, MessagePortClient { message ->
                val current = screen ?: return@MessagePortClient
                if (current.active && message.type == Message.TYPE_STRING) receiveSafely(current, message.string)
            })
        } else {
            isolate.setConsoleCallback(executor, JavaScriptConsoleCallback { entry ->
                val current = screen ?: return@JavaScriptConsoleCallback
                if (current.active && entry.message.startsWith(prefix)) {
                    current.chunks.accept(entry.message.removePrefix(prefix))?.let { receiveSafely(current, it) }
                } else if (current.active) {
                    Log.i(TAG, "[${current.route ?: "home"}] ${entry.message}")
                }
            })
            null
        }
        val activeScreen = Screen(route, params, view, isolate, port, headless)
        activeScreen.view.onLayoutChanged = {
            if (activeScreen.active) emitLayoutEvents(activeScreen)
        }
        screen = activeScreen
        CraftNativeHub.register(activeScreen.capabilityScope) { type, payload ->
            if (activeScreen.active) send(activeScreen, type, payload)
        }
        if (!headless) {
            screens.add(activeScreen)
            if (showImmediately) show(activeScreen)
        }
        val routePrelude = """
            globalThis.__stxNativeRoute = ${route?.let { JSONObject.quote(it) } ?: "undefined"};
            globalThis.__stxNativeParams = ${params};
        """.trimIndent()
        val audioPrelude = """
            (function() {
              if (typeof globalThis.AudioContext !== 'function') {
                var nextAudioId = 0;
                function audioMessage(payload) {
                  globalThis.__stxNativeBridge.postMessage({ type: 'AUDIO', payload: payload });
                }
                function audioParam(contextId, nodeId, action, initial) {
                  var current = Number(initial) || 0;
                  var param = {};
                  Object.defineProperty(param, 'value', {
                    configurable: true,
                    enumerable: true,
                    get: function() { return current; },
                    set: function(value) {
                      current = Number(value) || 0;
                      audioMessage({ action: action, contextId: contextId, nodeId: nodeId, value: current });
                    }
                  });
                  function schedule(value, when, ramp) {
                    current = Number(value) || 0;
                    var time = Number(when);
                    audioMessage({ action: action + (ramp ? 'RampToTime' : 'AtTime'), contextId: contextId, nodeId: nodeId, value: current, time: isFinite(time) ? Math.max(0, time) : 0 });
                  }
                  param.setValueAtTime = function(value, when) { schedule(value, when, false); return param; };
                  param.linearRampToValueAtTime = function(value, when) { schedule(value, when, true); return param; };
                  return param;
                }
                function AudioContext() {
                  this._id = 'audio-' + (++nextAudioId);
                  this._started = Date.now() / 1000;
                  this.state = 'running';
                  this.destination = { _contextId: this._id, _nodeId: 'destination' };
                  audioMessage({ action: 'createContext', contextId: this._id });
                }
                Object.defineProperty(AudioContext.prototype, 'currentTime', {
                  get: function() { return Date.now() / 1000 - this._started; }
                });
                AudioContext.prototype.createOscillator = function() {
                  var context = this;
                  var node = { _contextId: context._id, _nodeId: context._id + '-osc-' + (++nextAudioId) };
                  node.frequency = audioParam(context._id, node._nodeId, 'frequency', 440);
                  node.connect = function(destination) {
                    audioMessage({ action: 'connect', contextId: context._id, sourceId: node._nodeId, destinationId: destination && destination._nodeId || 'destination' });
                    return destination;
                  };
                  node.start = function(when) {
                    audioMessage({ action: 'start', contextId: context._id, nodeId: node._nodeId, delay: Math.max(0, (Number(when) || 0) - context.currentTime) });
                  };
                  node.stop = function(when) {
                    audioMessage({ action: 'stop', contextId: context._id, nodeId: node._nodeId, delay: Math.max(0, (Number(when) || 0) - context.currentTime) });
                  };
                  audioMessage({ action: 'createOscillator', contextId: context._id, nodeId: node._nodeId, frequency: node.frequency.value });
                  return node;
                };
                AudioContext.prototype.createGain = function() {
                  var context = this;
                  var node = { _contextId: context._id, _nodeId: context._id + '-gain-' + (++nextAudioId) };
                  node.gain = audioParam(context._id, node._nodeId, 'gain', 1);
                  node.connect = function(destination) {
                    audioMessage({ action: 'connect', contextId: context._id, sourceId: node._nodeId, destinationId: destination && destination._nodeId || 'destination' });
                    return destination;
                  };
                  audioMessage({ action: 'createGain', contextId: context._id, nodeId: node._nodeId, gain: node.gain.value });
                  return node;
                };
                AudioContext.prototype.resume = function() { this.state = 'running'; return Promise.resolve(); };
                AudioContext.prototype.suspend = function() { this.state = 'suspended'; return Promise.resolve(); };
                AudioContext.prototype.close = function() { this.state = 'closed'; audioMessage({ action: 'close', contextId: this._id }); return Promise.resolve(); };
                globalThis.AudioContext = AudioContext;
                globalThis.webkitAudioContext = AudioContext;
              }
            })()
        """.trimIndent()
        val bridgeFields = """
            platform: 'android',
            mutationProtocolVersion: 1,
            capabilityProtocolVersion: $CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION,
            capabilityTimeoutMs: $CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS,
            capabilities: ${capabilityNames()},
            initialAppState: ${JSONObject.quote(nativeAppState)},
            colorScheme: ${JSONObject.quote(colorScheme())},
            appearance: ${appearance()},
            appURL: ${JSONObject.quote(config.optString("devServerURL"))},
            appVersion: ${JSONObject.quote(appVersion().first)},
            appBuild: ${JSONObject.quote(appVersion().second)}
        """.trimIndent()
        // The stores can run to megabytes: read and laid out off the main
        // thread, then handed to the isolate.
        val preludeReady = com.google.common.util.concurrent.SettableFuture.create<String>()
        preludeExecutor.execute {
            preludeReady.set(runCatching {
                val preloaded = if (routes.isEmpty) "{}" else stores.preloadText()
                if (useMessagePorts) """
                    (async function() {
                      const port = await android.getNamedPort('craft');
                      globalThis.__craftPort = port;
                      __CRAFT_PRELUDE__
                      $audioPrelude
                    })()
                """.trimIndent().replace("__CRAFT_PRELUDE__", CraftNativePrelude.script(bridgeFields, "globalThis.__craftPort.postMessage(value);", "globalThis.__craftPort.onmessage = function(event) { deliver(event.data); };", preloaded, routePrelude))
                else CraftNativePrelude.script(bridgeFields, CraftNativeChunks.consolePost(prefix), "globalThis.__stxNativeCallback = deliver;", preloaded, routePrelude) + "\n" + audioPrelude
            }.getOrElse { error ->
                Log.e(TAG, "Native STX prelude failed", error)
                ""
            })
        }
        val setup = com.google.common.util.concurrent.Futures.transformAsync(preludeReady, { prelude ->
            isolate.evaluateJavaScriptAsync(prelude)
        }, executor)
        setup.addListener({
            if (!activeScreen.active) return@addListener
            try {
                setup.get()
                val load = isolate.evaluateJavaScriptAsync(bundle)
                load.addListener({
                    try {
                        load.get()
                        if (activeScreen.headless) {
                            CraftNativeBackground.foreground = { event, id, done ->
                                val app = appScreen
                                if (app == null || !app.active) false
                                else {
                                    backgroundWaiters[id] = done
                                    send(app, "CRAFT_EVENT", JSONObject().put("event", event).put("detail", JSONObject().put("id", id)))
                                    true
                                }
                            }
                            pendingNotificationTap?.let {
                                pendingNotificationTap = null
                                send(activeScreen, "CRAFT_EVENT", JSONObject().put("event", "craftNotificationResponse").put("detail", it))
                            }
                        }
                        val launchLink = initialDeepLink
                        if (!deliveredInitialDeepLink
                            && config.optBoolean("enableDeepLinks")
                            && launchLink != null
                            && screens.lastOrNull() === activeScreen
                        ) {
                            deliveredInitialDeepLink = true
                            send(activeScreen, "DEEP_LINK", deepLinkData(launchLink).put("initial", true))
                        }
                    } catch (error: Exception) {
                        Log.e(TAG, "Native STX bundle failed", error)
                        if (activeScreen.active) showError("Native STX bundle failed: ${error.message}")
                    }
                }, executor)
            } catch (error: Exception) {
                Log.e(TAG, "Native STX bridge failed", error)
                showError("Native STX bridge failed: ${error.message}")
            }
        }, executor)
        return activeScreen
    }

    /**
     * Puts a screen on the display: in the bars' content area when the app
     * has them. The screen it replaces hears `SCREEN_FOCUS` false, and a
     * screen shown before hears true (its `navigation.onAppear`).
     */
    private fun show(screen: Screen) {
        val bars = chrome
        val host: ViewGroup = bars?.content ?: root
        host.removeAllViews()
        (screen.view.parent as? ViewGroup)?.removeView(screen.view)
        host.addView(screen.view)
        val previous = visibleScreen
        visibleScreen = screen
        if (screen.frameRequested) postFrame(screen)
        if (bars != null) applyChrome(screen)
        if (previous !== screen) {
            if (previous != null && previous.active) send(previous, "SCREEN_FOCUS", JSONObject().put("focused", false))
            if (screen.shown) send(screen, "SCREEN_FOCUS", JSONObject().put("focused", true))
            screen.shown = true
        }
        refreshScreenTheme(screen)
    }

    /**
     * `requestAnimationFrame`: the next vsync for the screen on display. A
     * screen out of sight (another tab, under a pushed one) waits until it
     * is shown again, as a browser pauses a hidden tab's frames.
     */
    private fun requestFrame(screen: Screen) {
        if (screen.frameRequested) return
        screen.frameRequested = true
        if (visibleScreen === screen || screen.headless) postFrame(screen)
    }

    private fun postFrame(screen: Screen) {
        android.view.Choreographer.getInstance().postFrameCallback { frameTime ->
            if (!screen.active || !screen.frameRequested) return@postFrameCallback
            if (visibleScreen !== screen && !screen.headless) return@postFrameCallback
            screen.frameRequested = false
            send(screen, "FRAME_FIRE", JSONObject().put("time", frameTime / 1_000_000.0))
        }
    }

    private fun applyChrome(screen: Screen) {
        val bars = chrome ?: return
        val depth = screens.indexOf(screen).coerceAtLeast(0)
        val fallback = if (depth == 0) routes.tabs.getOrNull(currentTab)?.title else null
        bars.apply(screen.options, depth, fallback)
    }

    /** The bridge's capability names: Craft's core set and this host's services. */
    private fun capabilityNames(): JSONArray = capabilities.names().apply {
        services.names().forEach { name -> put(name) }
    }

    private fun appVersion(): Pair<String, String> = runCatching {
        val info = packageManager.getPackageInfo(packageName, 0)
        val build = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) info.longVersionCode.toString() else @Suppress("DEPRECATION") info.versionCode.toString()
        (info.versionName ?: "") to build
    }.getOrDefault("" to "")

    /** A synchronous store written in an isolate (CraftNativeShell.kt's prelude). */
    private fun syncWrite(screen: Screen, payload: JSONObject) {
        val id = payload.optString("id").takeIf { it.isNotBlank() }
        val reply: (Boolean) -> Unit = { ok ->
            if (id != null && screen.active) send(screen, "SYNC_RESULT", JSONObject().put("id", id).put("ok", ok))
        }
        val key = payload.optString("key")
        val value = if (payload.isNull("value")) null else payload.optString("value")
        when (payload.optString("store")) {
            "storage" -> if (key.isNotBlank()) stores.setStorage(key, value, from = screen.capabilityScope)
            "snapshots" -> if (payload.optBoolean("clear")) {
                val keep = payload.optJSONArray("keep") ?: JSONArray()
                stores.clearSnapshots((0 until keep.length()).map { keep.optString(it) }.toSet(), reply)
            } else if (key.isNotBlank()) {
                stores.setSnapshot(key, value, from = screen.capabilityScope, done = reply)
            } else reply(false)
            else -> reply(false)
        }
    }

    /** Every live isolate: each tab's stack and the app script. */
    private fun allScreens(): List<Screen> = buildList {
        if (tabStacks.isEmpty()) addAll(screens) else tabStacks.forEach(::addAll)
        appScreen?.let(::add)
    }

    override fun onSaveInstanceState(outState: Bundle) {
        outState.putString("craft.initialDeepLink", initialDeepLink?.toString())
        outState.putBoolean("craft.initialDeepLinkClaimed", initialDeepLinkClaimed)
        outState.putBoolean("craft.deliveredInitialDeepLink", deliveredInitialDeepLink)
        super.onSaveInstanceState(outState)
    }

    override fun onConfigurationChanged(newConfig: Configuration) {
        super.onConfigurationChanged(newConfig)
        publishAppearance()
    }

    private fun publishAppearance() {
        if (!::root.isInitialized) return
        refreshThemeDefaults()
        ViewCompat.requestApplyInsets(root)
        refreshInputDefaultsForTraitChange()
        chrome?.refreshColors()
        // Every screen follows light and dark, the ones in other tabs and
        // under the one on display too, and the app script hears it.
        val appearance = appearance()
        allScreens().forEach { screen ->
            if (!screen.headless) refreshScreenTheme(screen)
            if (screen.active) send(screen, "APPEARANCE", appearance)
        }
    }

    private fun refreshScreenTheme(screen: Screen) {
        screen.mutations.node("root")?.let { renderCommitted(screen, it) }
        screen.controls.values.mapNotNull {
            when (it) {
                is CraftNativeRefreshableFlatList -> it.list
                is CraftNativeFlatList -> it
                else -> null
            }
        }.forEach { it.refreshThemeDefaults() }
        updateSafeAreaViews()
    }

    private fun updateSafeAreaViews() {
        if (!::root.isInitialized) return
        val active = visibleScreen ?: screens.lastOrNull { it.active }
        val rootNode = active?.mutations?.node("root")
        val safeRoot = rootNode?.let { canonicalType(it.optString("type")) == "SafeAreaView" } == true
        root.setPadding(
            if (safeRoot) 0 else windowSafeInsets[0],
            if (safeRoot) 0 else windowSafeInsets[1],
            if (safeRoot) 0 else windowSafeInsets[2],
            if (safeRoot) 0 else windowSafeInsets[3],
        )
        val tree = active?.view?.getChildAt(0) as? CraftNativeFlexLayout
        if (safeRoot) tree?.setWindowSafeInsets(windowSafeInsets[0], windowSafeInsets[1], windowSafeInsets[2], windowSafeInsets[3])
        else tree?.setWindowSafeInsets(0, 0, 0, 0)
    }

    private fun refreshThemeDefaults() {
        val background = ContextCompat.getColor(this, R.color.background)
        root.setBackgroundColor(background)
        defaultTextColor = if (Color.luminance(background) < 0.5) Color.WHITE else Color.BLACK
    }

    private fun colorScheme(): String = if (
        resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK == Configuration.UI_MODE_NIGHT_YES
    ) "dark" else "light"

    private fun appearance(): JSONObject {
        val scale = resources.configuration.fontScale.toDouble().coerceAtLeast(0.1)
        val contentSize = when {
            scale >= 1.5 -> "accessibilityExtraExtraExtraLarge"
            scale >= 1.35 -> "accessibilityExtraExtraLarge"
            scale >= 1.2 -> "accessibilityExtraLarge"
            scale >= 1.1 -> "extraLarge"
            scale <= 0.85 -> "extraSmall"
            scale <= 0.92 -> "small"
            else -> "large"
        }
        return JSONObject()
            .put("contentSizeCategory", contentSize)
            .put("fontScale", (scale * 1000).roundToInt() / 1000.0)
            .put("reduceMotion", !ValueAnimator.areAnimatorsEnabled())
            .put("reduceTransparency", false)
            .put("colorScheme", colorScheme())
    }

    private fun refreshInputDefaultsForTraitChange() {
        if (inputHintDefaults.isEmpty() && inputHighlightDefaults.isEmpty()) return
        val probe = EditText(this)
        val hintColors = probe.hintTextColors
        val highlightColor = probe.highlightColor
        inputHintDefaults.keys.toList().forEach { inputHintDefaults[it] = hintColors }
        inputHighlightDefaults.keys.toList().forEach { inputHighlightDefaults[it] = highlightColor }
    }

    private fun receive(screen: Screen, raw: String) {
        val message = runCatching { JSONObject(raw) }.getOrElse { error ->
            Log.w(TAG, "A message from ${screen.route ?: "home"} is not JSON (${raw.length} chars): ${error.message}; it starts ${raw.take(120)}")
            return
        }
        val payload = message.optJSONObject("payload") ?: JSONObject()
        val type = message.optString("type")
        // Timers and frames come many times a second: not worth a log line each.
        if (type != "TIMER" && type != "TIMER_CLEAR" && type != "FRAME" && Log.isLoggable(TAG, Log.DEBUG)) {
            Log.d(TAG, "Native STX $type (${raw.length} chars) for ${screen.route ?: "home"}")
        }
        when (message.optString("type")) {
            "RENDER" -> payload.optJSONObject("document")?.let { render(screen, it) }
            "MUTATE" -> try {
                val result = applyMutation(screen, payload)
                send(screen, "MUTATION_ACK", JSONObject()
                    .put("batchId", result.batchId)
                    .put("revision", result.revision)
                    .put("version", CRAFT_NATIVE_MUTATION_PROTOCOL_VERSION))
            }
            catch (failure: CraftNativeMutationFailure) {
                val error = JSONObject()
                    .put("batchId", payload.optString("batchId"))
                    .put("code", failure.code)
                    .put("message", failure.message)
                    .put("version", CRAFT_NATIVE_MUTATION_PROTOCOL_VERSION)
                failure.operationIndex?.let { error.put("operationIndex", it) }
                send(screen, "MUTATION_ERROR", error)
            }
            catch (_: Exception) {
                send(screen, "MUTATION_ERROR", JSONObject()
                    .put("batchId", payload.optString("batchId"))
                    .put("code", "INVALID_BATCH")
                    .put("message", "mutation batch could not be applied")
                    .put("version", CRAFT_NATIVE_MUTATION_PROTOCOL_VERSION))
            }
            "NAVIGATE_OPEN" -> payload.optString("path").takeIf { it.isNotBlank() }?.let(::navigateOpen)
            "NAVIGATION_SET_OPTIONS" -> {
                // The app script has no navigation bar of its own. Screen
                // options remain valid while that screen is off-stack, so
                // only reject the headless app isolate here.
                if (screen !== appScreen) {
                    payload.keys().forEach { key -> screen.options.put(key, payload.opt(key)) }
                    if (visibleScreen === screen) applyChrome(screen)
                }
            }
            "SYNC_WRITE" -> syncWrite(screen, payload)
            "TIMER" -> {
                val id = payload.optInt("id")
                screen.timers.remove(id)?.let(capabilityHandler::removeCallbacks)
                val fire = Runnable {
                    screen.timers.remove(id)
                    if (screen.active) send(screen, "TIMER_FIRE", JSONObject().put("id", id))
                }
                screen.timers[id] = fire
                capabilityHandler.postDelayed(fire, payload.optLong("ms", 0).coerceAtLeast(0))
            }
            "TIMER_CLEAR" -> screen.timers.remove(payload.optInt("id"))?.let(capabilityHandler::removeCallbacks)
            "FRAME" -> requestFrame(screen)
            "NAVIGATE", "NAVIGATE_REPLACE" -> {
                // Navigation belongs to the route that is actually visible.
                // The stack list can be temporarily detached while a tab or
                // back transition restores its root; using its last entry
                // silently drops a valid push from that visible screen. The
                // app script has no stack of its own; it uses NAVIGATE_OPEN.
                if (visibleScreen !== screen) return
                val route = payload.optString("screen").takeIf { it.isNotBlank() } ?: return
                if (message.optString("type") == "NAVIGATE_REPLACE") {
                    closeScreen(screens.removeAt(screens.lastIndex))
                }
                openScreen(route, payload.optJSONObject("params") ?: JSONObject())
            }
            "NAVIGATE_BACK" -> if (visibleScreen === screen) back()
            "NAVIGATE_POP_TO_ROOT" -> if (visibleScreen === screen) popToRoot()
            "API_REQUEST" -> answerAPI(screen, message, payload)
            "API_CANCEL" -> {
                val id = payload.optString("requestId")
                if (id.isNotBlank()) {
                    val token = "${screen.capabilityScope}/$id"
                    screen.pendingCapabilities.remove(token)
                    screen.capabilityTimeouts.remove(token)?.let(capabilityHandler::removeCallbacks)
                    capabilities.cancel(token)
                }
            }
            "AUDIO" -> screen.audio.handle(payload)
        }
    }

    private fun receiveSafely(screen: Screen, raw: String) {
        try {
            receive(screen, raw)
        }
        catch (error: Exception) {
            val route = screen.route ?: "home"
            Log.e(TAG, "Native STX message failed for $route", error)
            if (screen.active) showError("Native STX message failed for $route: ${error.message}")
        }
    }

    private fun render(screen: Screen, document: JSONObject) {
        screen.mutations.replace(document)
        renderCommitted(screen, document)
    }

    private fun applyMutation(screen: Screen, payload: JSONObject): CraftNativeMutationResult {
        val result = screen.mutations.apply(payload)
        if (!result.requiresFullRender && applyTargetedUpdates(screen, result.affectedNodeIds)) return result
        result.document?.let { renderCommitted(screen, it) } ?: clearRenderedTree(screen)
        return result
    }

    private fun applyTargetedUpdates(screen: Screen, ids: List<String>): Boolean {
        val applied = mutableSetOf<String>()
        for (id in ids) {
            val target = drawnTarget(screen, id) ?: return false
            if (!applied.add(target)) continue
            val document = screen.mutations.node(target) ?: return false
            val path = screen.nodePaths[target] ?: return false
            if (screen.nodeViews[target] == null) return false
            makeView(screen, document, path, screen.controls)
            val updated = screen.nodeViews[target] ?: return false
            screen.lastLayoutBounds.remove(updated)
            if (!updateParentLayoutStyle(updated, document.optJSONObject("style") ?: JSONObject())) return false
        }
        if (applied.isNotEmpty()) {
            scheduleLayoutEvents(screen)
        }
        return true
    }

    /** Find the nearest rendered ancestor for protocol nodes with no view. */
    private fun drawnTarget(screen: Screen, id: String): String? {
        var current: String? = id
        while (current != null) {
            val target = screen.flatListOwners[current] ?: current
            if (screen.nodeViews[target] != null) return target
            current = screen.mutations.parentId(current)
        }
        return null
    }

    private fun scheduleLayoutEvents(screen: Screen) {
        if (!screen.active) return
        val observer = screen.view.viewTreeObserver
        if (observer.isAlive) {
            val listener = object : ViewTreeObserver.OnPreDrawListener {
                override fun onPreDraw(): Boolean {
                    if (observer.isAlive) observer.removeOnPreDrawListener(this)
                    if (screen.active) emitLayoutEvents(screen)
                    return true
                }
            }
            observer.addOnPreDrawListener(listener)
        }
        screen.view.forceLayout()
        screen.view.requestLayout()
        // A tree that is already settled may not produce a global-layout
        // callback; keep the event path live for that case as well.
        screen.view.postOnAnimation { if (screen.active) emitLayoutEvents(screen) }
    }

    /**
     * Targeted mutations bypass the parent's child reconciliation. Rebind the
     * updated node's layout style explicitly so removing a width/height (or
     * changing flex participation) invalidates the native parent's metrics.
     */
    private fun updateParentLayoutStyle(view: View, style: JSONObject): Boolean {
        var parent = view.parent
        var found = false
        // A targeted style update can arrive while Android considers the
        // existing traversal settled. Invalidate the node itself as well as
        // every ancestor, including the platform ScrollView between the
        // native content layout and CraftNativeScrollView.
        view.forceLayout()
        view.requestLayout()
        while (parent != null) {
            when (parent) {
                is CraftNativeFlexLayout -> {
                    if (!found) parent.setChildStyle(view, style, resources.displayMetrics.density)
                    parent.forceLayout()
                    parent.requestLayout()
                    found = true
                }
                is CraftNativeScrollView -> {
                    parent.invalidateContentLayout()
                }
            }
            (parent as? View)?.let {
                it.forceLayout()
                it.requestLayout()
            }
            parent = parent.parent
        }
        return found
    }

    private fun renderCommitted(screen: Screen, document: JSONObject) {
        // Keep live controls (especially the focused EditText) across renders.
        screen.statusBarStyle = null
        screen.statusBarHidden = null
        val next = mutableMapOf<String, View>()
        screen.nodeViews.clear()
        screen.nodePaths.clear()
        val tree = makeView(screen, document, "root", next)
        if (screen.view.getChildAt(0) !== tree) {
            (tree.parent as? ViewGroup)?.removeView(tree)
            screen.view.removeAllViews()
            screen.view.addView(tree)
        }
        releaseViewState(screen, screen.controls.values.filter { it !in next.values })
        screen.controls.clear()
        screen.controls.putAll(next)
        screen.handlers.keys.retainAll(retainedViews(screen))
        screen.view.setChildStyle(tree, document.optJSONObject("style") ?: JSONObject(), resources.displayMetrics.density)
        updateSafeAreaViews()
        // A full render can change a view's custom layout style without
        // changing the root bounds. Ensure native @layout observers still see
        // the settled child frame after the next traversal.
        scheduleLayoutEvents(screen)
        if (visibleScreen === screen) applyStatusBar(screen)
    }

    private fun applyStatusBar(screen: Screen) {
        val controller = WindowCompat.getInsetsController(window, window.decorView)
        val night = (resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
        controller.isAppearanceLightStatusBars = when (screen.statusBarStyle?.lowercase()) {
            "light-content", "light" -> false
            "dark-content", "dark" -> true
            else -> !night
        }
        if (screen.statusBarHidden == true) controller.hide(WindowInsetsCompat.Type.statusBars())
        else controller.show(WindowInsetsCompat.Type.statusBars())
    }

    private fun clearRenderedTree(screen: Screen) {
        releaseViewState(screen, retainedViews(screen).toList())
        screen.view.removeAllViews()
        screen.controls.clear()
        screen.nodeViews.clear()
        screen.nodePaths.clear()
        screen.handlers.clear()
        screen.linkTargets.clear()
        screen.flatListRows.clear()
        screen.flatListOwners.clear()
        screen.flatListOwnerByView.clear()
    }

    private fun makeView(
        screen: Screen,
        node: JSONObject,
        path: String,
        next: MutableMap<String, View>,
        previousControls: Map<String, View> = screen.controls,
    ): View {
        val type = canonicalType(node.optString("type", "View"))
        val props = node.optJSONObject("props") ?: JSONObject()
        val style = node.optJSONObject("style") ?: JSONObject()
        val events = node.optJSONObject("events") ?: JSONObject()
        val children = node.optJSONArray("children") ?: JSONArray()
        val protocolId = node.optString("id").takeIf { it.isNotBlank() }
        val explicitKey = authoredKey(node, props)
        val identity = explicitKey?.let { "${path.substringBeforeLast('.', "")}/$it" }
            ?: protocolId?.let { "id:$it" }
            ?: path
        val previous = previousControls[identity]
        val reusableInput = previous as? EditText
        val control = when (type) {
            "Text" -> ((previous as? TextView)?.takeUnless { it is Button || it is EditText } ?: TextView(this)).apply {
                includeFontPadding = false
                maxLines = props.optInt("numberOfLines", 0).takeIf { it > 0 } ?: Int.MAX_VALUE
                ellipsize = when (props.optString("ellipsizeMode")) {
                    "head" -> TextUtils.TruncateAt.START
                    "middle" -> TextUtils.TruncateAt.MIDDLE
                    "tail" -> TextUtils.TruncateAt.END
                    else -> null
                }
                configureText(this, childText(children), style)
            }
            "StatusBar" -> (previous as? CraftNativeFlexLayout ?: CraftNativeFlexLayout(this)).apply {
                screen.statusBarStyle = craftNativeOptionalString(props.opt("barStyle"))
                screen.statusBarHidden = if (props.has("hidden") && !props.isNull("hidden")) props.optBoolean("hidden") else null
                visibility = View.GONE
            }
            "RefreshControl" -> (previous as? CraftNativeFlexLayout ?: CraftNativeFlexLayout(this)).apply {
                visibility = View.GONE
            }
            "Link" -> ((previous as? TextView)?.takeUnless { it is Button } ?: TextView(this)).apply {
                includeFontPadding = false
                configureText(this, craftNativeOptionalString(props.opt("title")) ?: childText(children), style)
                val linkColor = craftNativeOptionalString(props.opt("color")) ?: craftNativeOptionalString(style.opt("color"))
                setTextColor(color(linkColor, Color.rgb(33, 150, 243)))
                paintFlags = paintFlags or Paint.UNDERLINE_TEXT_FLAG
                isEnabled = !props.optBoolean("disabled", false)
                isClickable = true
                isFocusable = true
                val target = listOf(props.opt("href"), props.opt("to"))
                    .firstNotNullOfOrNull(::craftNativeOptionalString)
                    ?.trim()
                    ?.takeIf { !props.optBoolean("disabled", false) }
                if (target != null) screen.linkTargets[this] = target else screen.linkTargets.remove(this)
                val handler = craftNativeEventName(events, "onPress", "onClick")
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                setOnClickListener {
                    screen.linkTargets[it]?.let { target -> navigateOpen(target); return@setOnClickListener }
                    val current = screen.handlers[this] ?: return@setOnClickListener
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                }
            }
            "Button" -> (previous as? Button ?: Button(this).apply {
                // A plain button, as on iOS (UIButton) and the web: its
                // style draws any fill, not Material's grey raised box.
                background = null
                stateListAnimator = null
                minWidth = 0
                minHeight = 0
                minimumWidth = 0
                minimumHeight = 0
                setPadding(0, 0, 0, 0)
            }).apply {
                val title = craftNativeOptionalString(props.opt("title")) ?: childText(children)
                isAllCaps = false
                configureText(this, title, style)
                craftNativeOptionalString(props.opt("color"))?.let { setTextColor(color(it, defaultTextColor)) }
                isEnabled = !props.optBoolean("disabled", false)
                val handler = craftNativeEventName(events, "onPress", "onClick")
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                setOnClickListener {
                    val current = screen.handlers[this] ?: return@setOnClickListener
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                }
            }
            "Checkbox" -> (previous as? CheckBox ?: CheckBox(this)).apply {
                text = craftNativeOptionalString(props.opt("label")) ?: childText(children)
                configureText(this, text.toString(), style)
                val requested = props.opt("checked") ?: props.opt("value")
                val checked = when (requested) {
                    is Boolean -> requested
                    is Number -> requested.toDouble() != 0.0
                    is String -> requested.equals("true", ignoreCase = true) || requested == "1"
                    else -> false
                }
                setOnCheckedChangeListener(null)
                // Keep the visual checked state separate from indeterminate:
                // an indeterminate control must announce "mixed" and its next
                // user toggle should transition to checked, not unchecked.
                isChecked = checked
                isActivated = props.optBoolean("indeterminate", false)
                isEnabled = !props.optBoolean("disabled", false)
                val checkboxColor = craftNativeOptionalString(props.opt("color"))
                    ?: craftNativeOptionalString(style.opt("color"))
                buttonTintList = checkboxColor?.let { ColorStateList.valueOf(color(it, defaultTextColor)) }
                val handler = craftNativeEventName(events, "onValueChange", "onChange")
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                setOnCheckedChangeListener { _, value ->
                    screen.handlers[this]?.let { current ->
                        send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject().put("value", value)))
                    }
                }
            }
            "TextInput" -> (reusableInput?.takeIf { it.isSingleLine == !props.optBoolean("multiline", false) }
                ?: EditText(this)).apply {
                // Setting filters, the input type or single-line mode makes
                // TextView set its text again, which puts the caret back at
                // the start: typing then came out backwards. Each is set only
                // when it changes, and the caret is put back after.
                val keptText = text.toString()
                val keptStart = selectionStart
                val keptEnd = selectionEnd
                val defaultHintColors = inputHintDefaults.getOrPut(this) {
                    hintTextColors ?: ColorStateList.valueOf(Color.GRAY)
                }
                val defaultHighlightColor = inputHighlightDefaults.getOrPut(this) { highlightColor }
                hint = craftNativeOptionalString(props.opt("placeholder")).orEmpty()
                setHintTextColor(
                    craftNativeOptionalString(props.opt("placeholderTextColor"))
                        ?.let { ColorStateList.valueOf(color(it, Color.GRAY)) }
                        ?: defaultHintColors,
                )
                highlightColor = craftNativeOptionalString(props.opt("selectionColor"))
                    ?.let { color(it, defaultHighlightColor) }
                    ?: defaultHighlightColor
                val maxLength = props.optInt("maxLength", 0)
                val currentLength = (filters.firstOrNull { it is InputFilter.LengthFilter } as? InputFilter.LengthFilter)?.max ?: 0
                if (currentLength != maxLength || (maxLength == 0 && filters.isNotEmpty())) {
                    filters = if (maxLength > 0) arrayOf(InputFilter.LengthFilter(maxLength)) else emptyArray()
                }
                val wantedType = inputTypeFor(props)
                if (inputType != wantedType) inputType = wantedType
                val wantedIme = imeOptionsFor(props)
                if (imeOptions != wantedIme) imeOptions = wantedIme
                val multiline = props.optBoolean("multiline", false)
                if (isSingleLine == multiline) isSingleLine = !multiline
                val wantedLines = if (multiline) props.optInt("numberOfLines", Int.MAX_VALUE).coerceAtLeast(1) else 1
                if (maxLines != wantedLines) maxLines = wantedLines
                isEnabled = props.optBoolean("editable", true)
                configureTextStyle(this, style)
                // The style's padding is where the text starts, as on iOS and
                // the web; without one the field keeps its own.
                if (listOf("padding", "paddingHorizontal", "paddingVertical", "paddingLeft", "paddingRight", "paddingTop", "paddingBottom").any { style.has(it) }) {
                    val density = resources.displayMetrics.density
                    val all = craftNativePadding(style, "padding", 0, density)
                    val horizontal = craftNativePadding(style, "paddingHorizontal", all, density)
                    val vertical = craftNativePadding(style, "paddingVertical", all, density)
                    setPadding(
                        craftNativePadding(style, "paddingLeft", horizontal, density),
                        craftNativePadding(style, "paddingTop", vertical, density),
                        craftNativePadding(style, "paddingRight", horizontal, density),
                        craftNativePadding(style, "paddingBottom", vertical, density),
                    )
                }
                // Reused EditTexts must forget the previous field's hint as
                // well as accept a new one. Otherwise a password manager can
                // offer credentials in a field whose props no longer ask for
                // them after keyed reconciliation.
                val autofillHint = autofillHintFor(props)
                if (autofillHint == null) setAutofillHints(*emptyArray()) else setAutofillHints(autofillHint)
                val controlledValue = props.opt("value")?.takeUnless { it == JSONObject.NULL }?.toString()
                val echoes = screen.inputEchoes[this]
                val echoIndex = if (controlledValue == null || echoes == null) -1 else echoes.indexOf(controlledValue)
                if (echoIndex >= 0) repeat(echoIndex + 1) { echoes!!.removeFirst() }
                if (controlledValue != null && text.toString() != controlledValue && echoIndex < 0) {
                    screen.suppressedTextChanges.add(this)
                    setTextPreservingSelection(this, controlledValue)
                }
                else if (this !== previous && screen.drafts.containsKey(identity)) setText(screen.drafts[identity])
                else if (this !== previous && props.has("defaultValue") && !props.isNull("defaultValue")) setText(props.optString("defaultValue"))
                applyTextDecoration(this, style)
                screen.inputIdentities[this] = identity
                val handler = craftNativeEventName(events, "onChange", "onChangeText")
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                val onFocus = craftNativeEventName(events, "onFocus")
                if (onFocus.isNotBlank()) screen.focusHandlers[this] = onFocus else screen.focusHandlers.remove(this)
                val onBlur = craftNativeEventName(events, "onBlur")
                if (onBlur.isNotBlank()) screen.blurHandlers[this] = onBlur else screen.blurHandlers.remove(this)
                val onEndEditing = craftNativeEventName(events, "onEndEditing")
                if (onEndEditing.isNotBlank()) screen.endEditingHandlers[this] = onEndEditing else screen.endEditingHandlers.remove(this)
                val onSubmit = craftNativeEventName(events, "onSubmitEditing")
                if (onSubmit.isNotBlank()) screen.submitHandlers[this] = onSubmit else screen.submitHandlers.remove(this)
                setOnFocusChangeListener { view, focused ->
                    val nativeEvent = JSONObject().put("text", text.toString())
                    if (focused) {
                        screen.focusHandlers[view]?.let { current ->
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", nativeEvent))
                        }
                    } else {
                        screen.blurHandlers[view]?.let { current ->
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", nativeEvent))
                        }
                        screen.endEditingHandlers[view]?.let { current ->
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", nativeEvent))
                        }
                    }
                }
                setOnEditorActionListener { view, actionId, event ->
                    val submitted = actionId != EditorInfo.IME_ACTION_NONE || event?.keyCode == KeyEvent.KEYCODE_ENTER
                    if (!submitted) return@setOnEditorActionListener false
                    val current = screen.submitHandlers[view] ?: return@setOnEditorActionListener false
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject().put("text", text.toString())))
                    true
                }
                if (props.optBoolean("autoFocus", false) && !isFocused) post {
                    if (!isFocused) {
                        requestFocus()
                        (getSystemService(INPUT_METHOD_SERVICE) as? android.view.inputmethod.InputMethodManager)
                            ?.showSoftInput(this, android.view.inputmethod.InputMethodManager.SHOW_IMPLICIT)
                    }
                }
                if (text.toString() == keptText && keptStart >= 0 && (selectionStart != keptStart || selectionEnd != keptEnd)) {
                    setSelection(keptStart.coerceAtMost(keptText.length), keptEnd.coerceAtMost(keptText.length))
                }
                // One watcher per field, however often it is reused.
                if (watchedInputs.add(this)) addTextChangedListener(object : TextWatcher {
                    override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
                    override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {
                        val updated = s?.toString().orEmpty()
                        (screen.inputIdentities[this@apply] ?: identity).let { screen.drafts[it] = updated }
                        if (screen.suppressedTextChanges.remove(this@apply)) return
                        val current = screen.handlers[this@apply] ?: return
                        val echoes = screen.inputEchoes.getOrPut(this@apply) { ArrayDeque() }
                        echoes.addLast(updated)
                        while (echoes.size > 64) echoes.removeFirst()
                        send(screen, "EVENT", JSONObject()
                            .put("handlerName", current)
                            .put("nativeEvent", JSONObject().put("text", updated)))
                    }
                    override fun afterTextChanged(s: Editable?) {}
                })
            }
            "Picker" -> (previous as? Spinner ?: Spinner(this)).apply {
                val options = (0 until children.length()).mapNotNull { index ->
                    val option = children.optJSONObject(index) ?: return@mapNotNull null
                    if (option.optString("type") != "Text") return@mapNotNull null
                    val label = (option.optJSONArray("children") ?: JSONArray()).let { text ->
                        (0 until text.length()).joinToString("") { text.optString(it) }
                    }
                    if (label.isBlank()) return@mapNotNull null
                    val optionProps = option.optJSONObject("props")
                    val value = craftNativeOptionalString(optionProps?.opt("value")) ?: label
                    value to label
                }
                val handler = craftNativeEventName(events, "onValueChange", "onChange")
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                // Detach the old listener before replacing the adapter or selection.
                // Both operations can synchronously dispatch an Android selection
