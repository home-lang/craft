package {{PACKAGE_NAME}}

import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.content.Context
import android.content.Intent
import android.os.Build
import androidx.core.app.NotificationCompat
import androidx.core.app.NotificationManagerCompat
import androidx.core.content.ContextCompat
import com.google.firebase.messaging.FirebaseMessagingService
import com.google.firebase.messaging.RemoteMessage
import org.json.JSONObject

/**
 * Firebase Cloud Messaging for the native renderer.
 *
 * - A new registration token reaches every screen and the app script as
 *   `PUSH_TOKEN` (`craft.push.onToken`, the `craftPushToken` event), as the
 *   iOS host sends a new APNs token.
 * - A notification that arrives while the app is open is shown anyway (FCM
 *   leaves that to the app) and heard as `craftNotificationReceived`; a tap
 *   opens the app with its data, which the app script hears as
 *   `craftNotificationResponse` (MainActivity.notificationTap). In the
 *   background, Android shows FCM's notification itself and a tap carries
 *   the same data.
 * - A data-only message with `content-available` (a silent push) runs the
 *   app script's background work once (`craftSilentPush`).
 */
class CraftNativeMessagingService : FirebaseMessagingService() {
    override fun onNewToken(token: String) {
        getSharedPreferences("craft-native-push", Context.MODE_PRIVATE).edit().putString("token", token).apply()
        CraftNativeHub.broadcast("PUSH_TOKEN", JSONObject().put("token", token))
    }

    override fun onMessageReceived(message: RemoteMessage) {
        val data = JSONObject()
        message.data.forEach { (key, value) -> data.put(key, value) }
        val notification = message.notification
        if (notification == null) {
            if (message.data["content-available"] == "1" || message.data["contentAvailable"] == "true") {
                CraftNativeBackground.runOnce(applicationContext, "craftSilentPush")
            }
            return
        }
        CraftNativeHub.broadcast("CRAFT_EVENT", JSONObject().put("event", "craftNotificationReceived").put("detail", data))
        show(notification.title.orEmpty(), notification.body.orEmpty(), message.data)
    }

    private fun show(title: String, body: String, data: Map<String, String>) {
        val manager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && manager.getNotificationChannel(CHANNEL) == null) {
            manager.createNotificationChannel(NotificationChannel(CHANNEL, applicationInfo.loadLabel(packageManager), NotificationManager.IMPORTANCE_DEFAULT))
        }
        val open = Intent(this, MainActivity::class.java)
            .addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP)
            .putExtra("craft.notification", true)
        data.forEach { (key, value) -> open.putExtra(key, value) }
        val id = (data["notification_id"]?.toIntOrNull() ?: System.currentTimeMillis().toInt())
        val tap = PendingIntent.getActivity(this, id, open, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
        val built = NotificationCompat.Builder(this, CHANNEL)
            .setSmallIcon(R.drawable.craft_notification_icon)
            .setColor(ContextCompat.getColor(this, R.color.craft_notification_color))
            .setContentTitle(title)
            .setContentText(body)
            .setStyle(NotificationCompat.BigTextStyle().bigText(body))
            .setAutoCancel(true)
            .setContentIntent(tap)
            .build()
        runCatching { NotificationManagerCompat.from(this).notify(id, built) }
    }

    companion object {
        private const val CHANNEL = "craft-push"
    }
}
