<script>
const name = state('')
const count = state(0)
const imageTaps = state(0)
const submits = state(0)
const nameFocuses = state(0)
const notesFocusText = state('')
const nameBlurs = state(0)
const nameEndEditings = state(0)
const notesBlurs = state(0)
const notesEndEditings = state(0)
const status = state('')
const pressIns = state(0)
const pressOuts = state(0)
const linkAccessibilityDisabled = state(false)
const panelAccessibilityDisabled = state(false)
const longPressStatus = state('')
const longPressAccessibilityDisabled = state(false)
const switchValue = state(false)
const pickerValue = state('one')
const modalVisible = state(false)
const modalStatus = state('')
const modalOpacity = state(1)
const sliderValue = state(0.5)
const sliderCompletions = state(0)
const layoutWidth = state(0)
const layoutWide = state(true)
const imageStatus = state('')
const imageErrorStatus = state('')
const imageFailureCount = state(0)
const imageTinted = state(true)
const imageSource = state('http://example.com/image.png')
const validImageSource = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII='
const buttonAccent = state(false)
const inputColors = state(true)
const inputStyleStatus = state('')
const nameMultiline = state(false)
const panelStyled = state(true)
const panelStyleStatus = state('')
const textWidthUnset = state(false)
const navigationName = 'Ada'
const navigationCount = state(0)
const navigationLifecycle = state('Lifecycle pending')
const audioContextStatus = state('AudioContext pending')
const navigationRows = state([
  { id: 'a', label: 'Ada row' },
  { id: 'b', label: 'Bea row' },
])
const navigationRowSelection = state('none')
const navigationRowsReordered = state(false)

globalThis.craft.storage.remove('native-navigation-details-destroyed')

function incrementNavigation() {
  navigationCount.update(value => value + 1)
}

function reorderNavigationRows() {
  navigationRows.set([
    { id: 'b', label: 'Bea row updated' },
    { id: 'c', label: 'Cy row' },
  ])
}

function selectNavigationRow(id) {
  navigationRowSelection.set(id)
}

function updateNavigationDraft(id, event) {
  if (id === 'b' && event.text === 'draft' && !navigationRowsReordered()) {
    navigationRowsReordered.set(true)
    reorderNavigationRows()
  }
}

async function verifyNavigationLifecycle() {
  const marker = await globalThis.craft.storage.get('native-navigation-details-destroyed')
  navigationLifecycle.set(marker ? `Disposed ${marker}` : 'Lifecycle pending')
}

function verifyAudioContext() {
  try {
    const context = new AudioContext()
    const oscillator = context.createOscillator()
    const gain = context.createGain()
    oscillator.connect(gain)
    gain.connect(context.destination)
    oscillator.frequency.setValueAtTime(220, context.currentTime)
    oscillator.frequency.linearRampToValueAtTime(220, context.currentTime + 0.05)
    gain.gain.setValueAtTime(0, context.currentTime)
    gain.gain.linearRampToValueAtTime(0, context.currentTime + 0.05)
    context.close()
    audioContextStatus.set('AudioContext ready')
  } catch (error) {
    audioContextStatus.set('AudioContext failed')
  }
}

function linkAccessibilityState() {
  return { disabled: linkAccessibilityDisabled() }
}

function panelAccessibilityState() {
  return { disabled: panelAccessibilityDisabled() }
}

function longPressAccessibilityState() {
  return { disabled: longPressAccessibilityDisabled() }
}

function buttonAccessibilityState() {
  return { selected: buttonAccent() }
}

function switchAccessibilityState() {
  return { checked: switchValue() }
}

function switchTrackColor() {
  return { false: '#64748b', true: '#22c55e' }
}

function validImage() {
  return { uri: validImageSource }
}

function currentImage() {
  return { uri: imageSource() }
}

function changeName(event) {
  name.set(event.text)
}

function focusName() {
  nameFocuses.update(value => value + 1)
}

function focusNotes(event) {
  notesFocusText.set(event.text)
}

function increment() {
  count.update(value => value + 1)
}

function tapImage() {
  imageTaps.update(value => value + 1)
}

function imageLoadStart() {
  imageStatus.set('image loading')
}

function imageLoaded() {
  imageStatus.set('image loaded')
}

function imageFailed() {
  imageErrorStatus.set('image failed')
  imageFailureCount.update(value => value + 1)
}

function toggleImageSource() {
  imageSource.set(imageSource().startsWith('http') ? validImageSource : 'http://example.com/image.png')
  imageStatus.set('')
  imageErrorStatus.set('')
}

function clearImageSource() {
  imageSource.set('')
  imageStatus.set('')
  imageErrorStatus.set('')
}

function toggleImageTint() {
  imageTinted.update(value => !value)
  imageStatus.set(imageTinted() ? 'image tint on' : 'image tint off')
}

function toggleButtonAccent() {
  buttonAccent.update(value => !value)
  status.set(buttonAccent() ? 'button style accented' : 'button style default')
}

function toggleInputColors() {
  inputColors.update(value => !value)
  inputStyleStatus.set(inputColors() ? 'input colors on' : 'input colors off')
}

function toggleNameMode() {
  nameMultiline.update(value => !value)
}

function togglePanelStyle() {
  panelStyled.update(value => !value)
  panelStyleStatus.set(panelStyled() ? 'panel style on' : 'panel style off')
}

function toggleTextWidth() {
  textWidthUnset.update(value => !value)
}

function submitName() {
  submits.update(value => value + 1)
}

function blurName() {
  nameBlurs.update(value => value + 1)
}

function endNameEditing() {
  nameEndEditings.update(value => value + 1)
}

function blurNotes() {
  notesBlurs.update(value => value + 1)
}

function endNotesEditing() {
  notesEndEditings.update(value => value + 1)
}

function setStatus(value) {
  status.set(value)
}

function toggleLinkAccessibility() {
  linkAccessibilityDisabled.update(value => !value)
  status.set(linkAccessibilityDisabled() ? 'link accessibility disabled' : 'link accessibility enabled')
}

function togglePanelAccessibility() {
  panelAccessibilityDisabled.update(value => !value)
  status.set(panelAccessibilityDisabled() ? 'panel accessibility disabled' : 'panel accessibility enabled')
}

function pressPanel() {
  status.set('panel pressed')
}

function pressNativePressable() {
  status.set('pressable pressed')
}

function pressNativePressableIn() {
  pressIns.update(value => value + 1)
}

function pressNativePressableOut() {
  pressOuts.update(value => value + 1)
}

function pressPanelLong() {
  longPressStatus.set('panel long pressed')
}

function toggleLongPressAccessibility() {
  longPressAccessibilityDisabled.update(value => !value)
  longPressStatus.set(longPressAccessibilityDisabled() ? 'long press disabled' : 'long press enabled')
}

function toggleSwitch(event) {
  switchValue.set(event.value)
  status.set(switchValue() ? 'switch on' : 'switch off')
}

function choosePicker(event) {
  pickerValue.set(event.value)
  status.set(`picker ${pickerValue()}`)
}

function toggleModal() {
  modalVisible.update(value => !value)
}

function modalShown() {
  modalStatus.set('modal shown')
}

function modalDismissed() {
  modalStatus.set('modal dismissed')
}

function modalRequested() {
  modalStatus.set('modal requested')
  modalVisible.set(false)
}

function toggleModalOpacity() {
  modalOpacity.update(value => value === 1 ? 0.45 : 1)
}

function moveSlider(event) {
  sliderValue.set(event.value)
  status.set('slider moved')
}

function finishSlider() {
  sliderCompletions.update(value => value + 1)
}

function captureLayout(event) {
  layoutWidth.set(event.layout.width)
}

function toggleLayoutWidth() {
  layoutWide.update(value => !value)
}

function openDetails() {
  globalThis.craft.navigation.push('details', { name: navigationName, count: navigationCount() })
}

function openCapabilities() {
  globalThis.craft.navigation.push('capabilities')
}
</script>

<template>
  <SafeAreaView testID="root" class="p-4">
    <ScrollView testID="native-root-scroll" style={{"flex":1}}>
    <Text testID="home-title">Home</Text>
    <Text testID="keyed-list-status" :text="'Selected: ' + navigationRowSelection" />
    <View :for="row in navigationRows" :key="row.id" style={{"height":52,"flexDirection":"row","gap":4}}>
      <Text :text="row.label" style={{"width":100}} />
      <TextInput placeholder="Draft" style={{"width":100}} @input="updateNavigationDraft(row.id, $event)" />
      <Button @click="selectNavigationRow(row.id)">Select row</Button>
    </View>
    <Button testID="keyed-list-reorder" @click="reorderNavigationRows()">Reorder rows</Button>
    <Text testID="navigation-home-state" :text="'Home state: ' + navigationName + '/' + navigationCount" />
    <Button testID="navigation-increment" @click="incrementNavigation()">Increment navigation state</Button>
    <Button testID="navigation-open-details" @click="openDetails()">Open navigation details</Button>
    <Button testID="navigation-check-lifecycle" @click="verifyNavigationLifecycle()">Check details lifecycle</Button>
    <Text testID="navigation-lifecycle" :text="navigationLifecycle" />
    <Button testID="native-audio-context" @click="verifyAudioContext()">Check audio context</Button>
    <Text testID="audio-context-status" :text="audioContextStatus" />
    <Button testID="open-capabilities" @click="openCapabilities()">Open capabilities</Button>
    <Button testID="disabled-button" disabled>Disabled</Button>
    <Text testID="null-width-text" style={{"width":textWidthUnset ? null : 160,"alignSelf":"flex-start"}}>intrinsic</Text>
    <Button testID="toggle-null-width" @click="toggleTextWidth()">Toggle null width</Button>
    <Button testID="toggle-panel-style" @click="togglePanelStyle()">Toggle panel style</Button>
    <Text testID="panel-style-status" :text="panelStyleStatus" />
    <View testID="dynamic-style-box" style={{"width":120,"height":24,"backgroundColor":panelStyled ? "#334455" : null,"borderWidth":panelStyled ? 2 : null,"borderColor":panelStyled ? "#abcdef" : null}} />
    <ScrollView testID="native-scroll" keyboardDismissMode="on-drag" keyboardShouldPersistTaps="handled" contentContainerStyle={{"paddingTop":12}} style={{"height":72,"gap":4}}>
      <Image
        testID="native-image"
        source={validImage()}
        accessibilityLabel="Native pixel"
        accessibilityRole="image"
        @click="tapImage()"
        @load-start="imageLoadStart()"
        @load="imageLoaded()"
        @load-end="imageLoaded()"
        style={{"width":24,"height":24,"resizeMode":"cover","tintColor":imageTinted ? "#2563eb" : null}}
      />
      <svg
        testID="native-svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        accessibilityLabel="Native vector"
      >
        <g stroke="#2563eb">
          <path d="M4 12h16" />
          <text x="12" y="21" text-anchor="middle" fill="#111827" stroke="none" font-size="4">SVG</text>
        </g>
      </svg>
      <Video testID="native-video" source={{"uri":""}} style={{"width":120,"height":68}} />
      <Text testID="native-caption" :text="'Image taps: ' + imageTaps" />
      <Text testID="image-status" :text="imageStatus" />
      <Text testID="image-error-status" :text="imageErrorStatus" />
      <Image
        testID="unsupported-image"
        source={currentImage()}
        accessibilityLabel="Unsupported image"
        @load="imageLoaded()"
        @load-end="imageLoaded()"
        @error="imageFailed()"
        style={{"width":16,"height":16}}
      />
      <Button testID="toggle-image-source" @click="toggleImageSource()">Toggle image source</Button>
      <Button testID="clear-image-source" @click="clearImageSource()">Clear image source</Button>
      <Text testID="image-error-count" :text="imageFailureCount" />
      <View testID="reverse-column" style={{"flexDirection":"column-reverse","width":120,"height":48,"backgroundColor":"#556677"}}>
        <Text testID="reverse-column-first">top source</Text>
        <Text testID="reverse-column-second">bottom source</Text>
      </View>
      <View style={{"height":120}} />
      <Text testID="scroll-end">End of native scroll content</Text>
    </ScrollView>
    <View
      testID="styled-row"
      style={{"flexDirection":"row-reverse","alignItems":"center","justifyContent":"center","gap":6,"paddingHorizontal":10,"paddingVertical":5,"width":240,"height":64,"backgroundColor":"#123456","opacity":0.75,"borderWidth":2,"borderColor":"#abcdef","borderRadius":7,"overflow":"hidden"}}
    >
      <Text testID="styled-first" style={{"width":70,"color":"#fedcba","fontSize":21,"fontWeight":"700","fontStyle":"italic","textAlign":"right","letterSpacing":1,"lineHeight":26,"textTransform":"uppercase","textDecorationLine":"underline"}}>first</Text>
      <Text testID="styled-second" style={{"width":70}}>second</Text>
    </View>
    <Text testID="justified-text" style={{"width":240,"textAlign":"justify"}}>A justified native paragraph exercises shared text alignment.</Text>
    <View testID="grid-wrap" style={{"display":"grid","gridTemplateColumns":"repeat(2, 1fr)","gridAutoRows":28,"columnGap":6,"rowGap":4,"width":240,"padding":4,"backgroundColor":"#334455"}}>
      <Text testID="grid-first">grid one</Text>
      <Text testID="grid-second">grid two</Text>
      <Text testID="grid-third">grid three</Text>
    </View>
    <View testID="align-content-wrap" style={{"width":120,"height":96,"flexDirection":"row","flexWrap":"wrap","alignContent":"space-between","backgroundColor":"#243444"}}>
      <View testID="align-content-first" style={{"width":60,"height":20,"backgroundColor":"#6b7280"}} />
      <View testID="align-content-second" style={{"width":60,"height":20,"backgroundColor":"#9ca3af"}} />
      <View testID="align-content-third" style={{"width":60,"height":20,"backgroundColor":"#d1d5db"}} />
      <View testID="align-content-fourth" style={{"width":60,"height":20,"backgroundColor":"#f3f4f6"}} />
    </View>
    <View testID="flex-grow-wrap" style={{"flexDirection":"row","width":240,"height":32,"gap":4,"backgroundColor":"#445566"}}>
      <Text testID="flex-grow-first" style={{"width":40,"flexGrow":1}}>grow</Text>
      <Text testID="flex-grow-second" style={{"width":40}}>fixed</Text>
    </View>
    <View testID="justify-center-wrap" style={{"flexDirection":"row","justifyContent":"center","gap":4,"width":240,"height":32,"backgroundColor":"#3d4f61"}}>
      <Text testID="justify-center-first" style={{"width":40}}>center one</Text>
      <Text testID="justify-center-second" style={{"width":40}}>center two</Text>
    </View>
    <View testID="justify-between-wrap" style={{"flexDirection":"row","justifyContent":"space-between","width":240,"height":32,"backgroundColor":"#4f3d61"}}>
      <Text testID="justify-between-first" style={{"width":40}}>between one</Text>
      <Text testID="justify-between-second" style={{"width":40}}>between two</Text>
    </View>
    <Text testID="native-link" accessibilityHint="Opens status" accessibilityValue="ready" accessibilityState={linkAccessibilityState()} @click="setStatus('link pressed')">Open native link</Text>
    <Text testID="native-link-status" :text="status" />
    <Button testID="toggle-link-accessibility" @click="toggleLinkAccessibility()">Toggle link accessibility</Button>
    <View testID="native-panel" accessibilityState={panelAccessibilityState()} @click="pressPanel()" style={{"height":24}}><Text>Native panel</Text></View>
    <Pressable testID="native-pressable" @click="pressNativePressable()" @press-in="pressNativePressableIn()" @press-out="pressNativePressableOut()" style={{"height":24}}><Text>Native pressable</Text></Pressable>
    <Text testID="pressable-lifecycle" :text="'Press lifecycle: ' + pressIns + '/' + pressOuts" />
    <Pressable testID="disabled-pressable" disabled @click="pressNativePressable()" style={{"height":24}}><Text>Disabled pressable</Text></Pressable>
    <Button testID="toggle-panel-accessibility" @click="togglePanelAccessibility()">Toggle panel accessibility</Button>
    <View testID="long-press-panel" accessibilityState={longPressAccessibilityState()} @longpress="pressPanelLong()" style={{"height":24}}><Text>Long press panel</Text></View>
    <Button testID="toggle-long-press-accessibility" @click="toggleLongPressAccessibility()">Toggle long press accessibility</Button>
    <Text testID="long-press-status" :text="longPressStatus" />
    <Button testID="toggle-button-style" accessibilityState={buttonAccessibilityState()} @click="toggleButtonAccent()" style={{"color":buttonAccent ? "#ef4444" : "#22c55e","fontSize":buttonAccent ? 22 : 16}}>Toggle button style</Button>
    <Button testID="toggle-image-tint" @click="toggleImageTint()">Toggle image tint</Button>
    <Switch testID="native-switch" value={switchValue} accessibilityState={switchAccessibilityState()} trackColor={switchTrackColor()} thumbColor="#ffffff" ios_backgroundColor="#475569" @value-change="toggleSwitch($event)" />
    <Switch testID="nullable-switch" :value="null" :checked="true" />
    <select testID="native-picker" :value="pickerValue" @change="choosePicker($event)">
      <option value="one">One</option>
      <option value="two">Two</option>
      <option value="three">Three</option>
    </select>
    <Text testID="picker-value" :text="pickerValue" />
    <Button testID="toggle-modal" @click="toggleModal()">Toggle modal</Button>
    <Modal testID="native-modal" visible={modalVisible} transparent animationType="slide" style={{"opacity": modalOpacity}} @show="modalShown()" @dismiss="modalDismissed()" @request-close="modalRequested()">
      <Text testID="modal-content">Modal content</Text>
      <Button testID="toggle-modal-opacity" @click="toggleModalOpacity()">Toggle modal opacity</Button>
      <Text testID="modal-opacity" :text="modalOpacity" />
    </Modal>
    <Text testID="modal-status" :text="modalStatus" />
    <Slider testID="native-slider" minimumValue={0} maximumValue={1} step={0.1} value={sliderValue} minimumTrackTintColor="#22c55e" maximumTrackTintColor="#64748b" thumbTintColor="#16a34a" @value-change="moveSlider($event)" @sliding-complete="finishSlider()" />
    <Text testID="slider-value" :text="sliderValue" />
    <Text testID="slider-completions" :text="'Slider completions: ' + sliderCompletions" />
    <ActivityIndicator testID="native-indicator" color="#22c55e" size="large" />
    <ActivityIndicator testID="stopped-indicator" color="#ef4444" size="small" :animating="false" :hides-when-stopped="false" />
    <ActivityIndicator testID="hidden-indicator" color="#ef4444" size="small" :animating="false" hidesWhenStopped />
    <ActivityIndicator testID="display-none-indicator" style={{"display":"none"}} />
    <View testID="layout-wrap" @layout="captureLayout($event)" style={{"width":layoutWide ? 240 : 180,"height":90,"flexDirection":"row","flexWrap":"wrap","gap":4,"padding":4,"alignItems":"stretch","backgroundColor":"#223344"}}>
      <Text testID="layout-min" style={{"width":200,"minWidth":120,"maxWidth":140,"height":24}}>bounded</Text>
      <Text testID="layout-stretch" style={{"width":100,"height":24,"alignSelf":"stretch"}}>wrapped</Text>
      <View testID="layout-absolute" style={{"position":"absolute","right":8,"bottom":8,"width":12,"height":12,"backgroundColor":"#abcdef"}} />
    </View>
    <View testID="percent-wrap" style={{"width":240,"height":28,"backgroundColor":"#2f4050"}}>
      <Text testID="percent-width" style={{"width":"50%","height":20}}>half width</Text>
    </View>
    <Text testID="layout-status" :text="layoutWidth > 0 ? 'Layout width: ' + layoutWidth : 'layout pending'" />
    <Button testID="toggle-layout-width" @click="toggleLayoutWidth()">Toggle layout width</Button>
    <Button testID="toggle-input-colors" @click="toggleInputColors()">Toggle input colors</Button>
    <Text testID="input-style-status" :text="inputStyleStatus" />
    <Button testID="toggle-name-mode" @click="toggleNameMode()">Toggle name mode</Button>
    <Text testID="name-mode" :text="nameMultiline ? 'multiline' : 'single-line'" />
    <TextInput testID="name-input" value={name} multiline={nameMultiline} placeholder="Your name" placeholderTextColor={inputColors ? "#94a3b8" : undefined} selectionColor={inputColors ? "#22c55e" : undefined} maxLength={8} keyboardType="email-address" returnKeyType="done" @input="changeName($event)" @focus="focusName()" @submit-editing="submitName()" @blur="blurName()" @end-editing="endNameEditing()" />
    <TextInput testID="notes-input" multiline numberOfLines={3} maxLength={24} defaultValue="Draft" placeholder="Notes" placeholderTextColor={inputColors ? "#94a3b8" : undefined} selectionColor={inputColors ? "#22c55e" : undefined} @focus="focusNotes($event)" @submit-editing="submitName()" @blur="blurNotes()" @end-editing="endNotesEditing()" />
    <TextInput testID="readonly-input" :editable="false" defaultValue="Read only" />
    <TextInput testID="password-input" secureTextEntry defaultValue="secret" />
    <Text testID="greeting" :text="'Hello ' + name" />
    <Text testID="name-submits" :text="'Submits: ' + submits" />
    <Text testID="name-focuses" :text="'Focuses: ' + nameFocuses" />
    <Text testID="notes-focus-text" :text="'Notes focus: ' + notesFocusText" />
    <Text testID="name-blurs" :text="'Blurs: ' + nameBlurs" />
    <Text testID="name-end-editings" :text="'End edits: ' + nameEndEditings" />
    <Text testID="notes-blurs" :text="'Notes blurs: ' + notesBlurs" />
    <Text testID="notes-end-editings" :text="'Notes end edits: ' + notesEndEditings" />
    <Button testID="increment" @click="increment()">Increment</Button>
    <Text testID="count" :text="'Count: ' + count" />
    <Button testID="open-details" @click="openDetails()">Open details</Button>
    </ScrollView>
  </SafeAreaView>
</template>
