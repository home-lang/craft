  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "dist",
    "isolatedDeclarations": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/__tests__/**"
  ]
}
