{
  "dependencies": {
    // Pinned exactly, and deliberately not "latest": 1.4.x writes
    // `lockfileVersion: 2`, which 1.3.x cannot parse, so "latest" would break
    // every 1.3-based checkout and CI job the day 1.4.0 publishes. Keep this in
    // step with deps.yaml.
    "bun.sh": "1.3.14",
    // Use the permanent tagged compiler on every target. Nightly snapshots are
    // pruned upstream and cannot provision a fresh runner. Keep deps.yaml in step.
    "ziglang.org": "0.17.0"
  }
}
